 #if !defined(__GENKSYMS__)
 #if defined(CONFIG_QOS_SCHED_DYNAMIC_AFFINITY)
 	cpumask_t			*prefer_cpus;
+	const cpumask_t			*select_cpus;
 #else
 	KABI_RESERVE(1)
+	KABI_RESERVE(2)
 #endif
 #else
 	KABI_RESERVE(1)
-#endif
 	KABI_RESERVE(2)
+#endif
 	KABI_RESERVE(3)
