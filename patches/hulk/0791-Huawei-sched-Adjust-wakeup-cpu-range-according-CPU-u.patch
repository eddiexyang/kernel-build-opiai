 include/linux/sched/sysctl.h |   4 ++
 kernel/sched/fair.c          | 130 +++++++++++++++++++++++++++++++++++
 kernel/sysctl.c              |  11 +++
 4 files changed, 148 insertions(+), 1 deletion(-)

