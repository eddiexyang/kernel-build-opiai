	[ 8ebbc906486f77("io_uring: import 5.15-stable io_uring")
	  is applied earlier. ]

Signed-off-by: Li Lingfeng <lilingfeng3@huawei.com>
---
 io_uring/io_uring.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/io_uring/io_uring.c b/io_uring/io_uring.c
index 473dbd1830a3..ce82feefdd1b 100644
--- a/io_uring/io_uring.c
+++ b/io_uring/io_uring.c
@@ -7188,6 +7188,10 @@ static int io_submit_sqes(struct io_ring_ctx *ctx, unsigned int nr)
 		submitted++;
 		if (io_submit_sqe(ctx, req, sqe))
 			break;
+
+		/* to avoid doing too much in one submit round */
+		if (submitted > IORING_MAX_ENTRIES / 2)
+			cond_resched();
 	}
 
 	if (unlikely(submitted != nr)) {
