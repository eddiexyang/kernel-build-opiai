From 90b353c4f90242948eb6cdaa4c133291014c8b5c Mon Sep 17 00:00:00 2001
From: Li Lingfeng <lilingfeng3@huawei.com>
Date: Sat, 13 Aug 2022 16:25:31 +0800
Subject: [PATCH 038/500] [Huawei] io_uring: add switch to control io_uring
 whether to enable

Offering: HULK
hulk inclusion
category: feature
bugzilla: 187472

---------------------------

Io_uring is disabled as default.
Inserting "iouring_enable" into cmdline to enable it.

Signed-off-by: Li Lingfeng <lilingfeng3@huawei.com>
---
 io_uring/io_uring.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/io_uring/io_uring.c b/io_uring/io_uring.c
index ce82feefdd1b..b236afe80f94 100644
--- a/io_uring/io_uring.c
+++ b/io_uring/io_uring.c
@@ -1106,6 +1106,16 @@ static struct kmem_cache *req_cachep;
 
 static const struct file_operations io_uring_fops;
 
+static int io_uring_enable;
+
+static int __init io_uring_enable_setup(char *str)
+{
+	io_uring_enable = 1;
+	return 1;
+}
+
+__setup("iouring_enable", io_uring_enable_setup);
+
 struct sock *io_uring_get_socket(struct file *file)
 {
 #if defined(CONFIG_UNIX)
@@ -9862,6 +9872,9 @@ SYSCALL_DEFINE6(io_uring_enter, unsigned int, fd, u32, to_submit,
 	struct fd f;
 	long ret;
 
+	if (io_uring_enable == 0)
+		return -EOPNOTSUPP;
+
 	io_run_task_work();
 
 	if (unlikely(flags & ~(IORING_ENTER_GETEVENTS | IORING_ENTER_SQ_WAKEUP |
@@ -10312,6 +10325,9 @@ static long io_uring_setup(u32 entries, struct io_uring_params __user *params)
 SYSCALL_DEFINE2(io_uring_setup, u32, entries,
 		struct io_uring_params __user *, params)
 {
+	if (io_uring_enable == 0)
+		return -EOPNOTSUPP;
+
 	return io_uring_setup(entries, params);
 }
 
@@ -10865,6 +10881,9 @@ SYSCALL_DEFINE4(io_uring_register, unsigned int, fd, unsigned int, opcode,
 	long ret = -EBADF;
 	struct fd f;
 
+	if (io_uring_enable == 0)
+		return -EOPNOTSUPP;
+
 	f = fdget(fd);
 	if (!f.file)
 		return -EBADF;
-- 
