+#endif
 	int rc;
 
 	ad.type = LSM_AUDIT_DATA_INODE;
@@ -4100,6 +4288,7 @@ static int selinux_task_alloc(struct task_struct *task,
 			    sid, sid, SECCLASS_PROCESS, PROCESS__FORK, NULL);
 }
 
+#ifdef CONFIG_SECURITY_SELINUX_GENFSCON_NS
 static int selinux_cred_alloc_blank(struct cred *cred, gfp_t gfp)
 {
 	struct task_security_struct *tsec = selinux_cred(cred);
@@ -4117,6 +4306,7 @@ static void selinux_cred_free(struct cred *cred)
 
 	put_selinux_ns(tsec->ns);
 }
+#endif
 
 /*
  * prepare a new set of credentials for modification
@@ -4128,7 +4318,9 @@ static int selinux_cred_prepare(struct cred *new, const struct cred *old,
 	struct task_security_struct *tsec = selinux_cred(new);
 
 	*tsec = *old_tsec;
+#ifdef CONFIG_SECURITY_SELINUX_GENFSCON_NS
 	tsec->ns = get_selinux_ns(old_tsec->ns);
+#endif
 	return 0;
 }
 
@@ -4141,7 +4333,9 @@ static void selinux_cred_transfer(struct cred *new, const struct cred *old)
 	struct task_security_struct *tsec = selinux_cred(new);
 
 	*tsec = *old_tsec;
+#ifdef CONFIG_SECURITY_SELINUX_GENFSCON_NS
 	tsec->ns = get_selinux_ns(old_tsec->ns);
