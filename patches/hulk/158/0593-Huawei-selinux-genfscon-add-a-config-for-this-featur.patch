index 899ddf9ccd4f..220c4d26b4b7 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -109,9 +109,11 @@ struct selinux_state selinux_state;
 /* SECMARK reference count */
