 	preempt_enable();
+#endif
 }
 
 int security_dentry_init_security(struct dentry *dentry, int mode,
diff --git a/security/selinux/Kconfig b/security/selinux/Kconfig
index 9e921fc72538..9bdf17a1a278 100644
--- a/security/selinux/Kconfig
+++ b/security/selinux/Kconfig
@@ -115,3 +115,15 @@ config SECURITY_SELINUX_SID2STR_CACHE_SIZE
 	  conversion.  Setting this option to 0 disables the cache completely.
 
 	  If unsure, keep the default value.
+
+config SECURITY_SELINUX_GENFSCON_NS
+	bool "SELinux Genfscon Label Namespace"
+	depends on SECURITY_SELINUX
+	default n
+	help
+	  This option enables SELinux Genfscon Label Namespace, which is a
+	  feature that supports creating namespaces for file labels on some
+	  filesystems that only support the "genfscon" file labeling statement.
+	  Currently only procfs and sysfs are supported.
+
+	  If you don't need this feature, answer N.
