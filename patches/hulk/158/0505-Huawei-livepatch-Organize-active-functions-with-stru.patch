 		goto out;
 
-	ret = arch_klp_check_calltrace(check_func_list, (void *)func_list);
+	ret = arch_klp_check_calltrace(check_func_list, (void *)&func_list);
 
 out:
 	free_func_list(&func_list);
@@ -2054,7 +2055,7 @@ static void set_tasks_patch_state(int patch_state)
 	put_online_cpus();
 }
 
