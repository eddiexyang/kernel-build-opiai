 {
 	int ret = 0;
-	struct klp_func_list *func_list = NULL;
+	LIST_HEAD(func_list);
 
 	ret = arch_klp_check_activeness_func(patch, enable, add_func_to_list, &func_list);
 	if (ret) {
@@ -1406,10 +1407,10 @@ static int klp_check_calltrace(struct klp_patch *patch, int enable)
 		goto out;
 	}
 
