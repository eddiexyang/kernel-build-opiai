diff --git a/kernel/livepatch/core.c b/kernel/livepatch/core.c
index 15ccd96c250f..e740aa26c38d 100644
--- a/kernel/livepatch/core.c
+++ b/kernel/livepatch/core.c
@@ -1332,7 +1332,7 @@ int __weak arch_klp_check_calltrace(bool (*fn)(void *, int *, unsigned long), vo
 
