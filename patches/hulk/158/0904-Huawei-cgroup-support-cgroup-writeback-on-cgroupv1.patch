 kernel/cgroup/cgroup.c      |   7 +++
 mm/backing-dev.c            | 102 +++++++++++++++++++++++++++++++++++-
 mm/memcontrol.c             |  84 ++++++++++++++++++++++++++++-
 7 files changed, 210 insertions(+), 8 deletions(-)

