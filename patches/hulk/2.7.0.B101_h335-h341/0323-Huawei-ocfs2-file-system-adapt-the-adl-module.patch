+static int ocfs2_fs_status_output(char *buf, struct ocfs2_super *osb)
+{
+	char *p = buf;
+	unsigned long flags;
+
+	/* print osb status */
+	flags = ocfs2_get_osb_flags(osb);
+
+	if (flags & (OCFS2_OSB_ONLINE_RECOVERY))
+		p += sprintf(p, "%s", "repair");
+	else if (flags & (OCFS2_OSB_RECOVERY_INVALID | OCFS2_OSB_RO_FS))
+		p += sprintf(p, "%s", "soft_readonly");
+	else if (flags & OCFS2_OSB_INVALID_FS)
+		p += sprintf(p, "%s", "invalid");
+	else if (flags & OCFS2_OSB_HARD_RO)
+		p += sprintf(p, "%s", "hard_readonly");
+	else
+		p += sprintf(p, "%s", "normal");
+
+	p += sprintf(p, "\n");
+
+	return p - buf;
+}
