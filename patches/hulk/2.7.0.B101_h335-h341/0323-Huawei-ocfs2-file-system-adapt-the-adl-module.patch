+int ocfs2_multidev_update_storage_attr(struct super_block *sb)
+{
+	int ret;
+	struct ocfs2_super *osb = OCFS2_SB(sb);
+	struct ocfs2_dinode *super_di = NULL;
+	__le16 stor_attr;
+
+	/* If it exists some operations of update disk, it need add mutex lock,
+	 * or it needn't.*/
+	ret = ocfs2_super_block_lock(osb, 0);
+	if (ret < 0) {
+		mlog_errno(ret);
+		return ret;
+	}
+
+	super_di = (struct ocfs2_dinode *)osb->osb_super_bh->b_data;
+	stor_attr = super_di->id2.i_super.s_storage_attribute;
+
+	spin_lock(&osb->osb_lock);
+	osb->osb_ws_support = !!(stor_attr & cpu_to_le16(OCFS2_VAAI_WS_SUPPORT));
+	osb->osb_xcopy_support = !!(stor_attr & cpu_to_le16(OCFS2_VAAI_XCOPY_SUPPORT));
+	osb->osb_fence_scsi_support = !!(stor_attr & cpu_to_le16(OCFS2_FENCE_SCSI_SUPPORT));
+	spin_unlock(&osb->osb_lock);
+
+	ocfs2_super_block_unlock(osb, 0);
+
+	return ret;
