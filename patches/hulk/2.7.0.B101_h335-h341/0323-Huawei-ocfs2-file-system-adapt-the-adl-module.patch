+static ssize_t ocfs2_caw_support_proc_read(struct file *filp, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct ocfs2_super *osb = PDE_DATA(d_inode(filp->f_path.dentry));
+	unsigned long p = *ppos;
+	char support[5] = {0};
+	int len = ocfs2_vaai_support_output(support, osb, OCFS2_CAW_STATE);
+
+	if (len <= p)
+		return 0;
+
+	len -= p;
+	if (len > count)
+		len = count;
+	if (copy_to_user(buf, support, len))
+		return -EFAULT;
+
+	*ppos += len;
+
+	return len;
+}
