+				"%s: inode %lu, owner is %u, my node is %u, owner permission is invalid\n",
+				osb->uuid_str,
+				inode->i_ino, oi->ip_owner, osb->node_num);
+	}
+	mlog(ML_DEBUG, "%s: inode %lu, owner is %u, my node is %u, owner permission is %s\n",
+			osb->uuid_str, inode->i_ino, oi->ip_owner,
+			osb->node_num, ret ? "valid" : "invalid");
