+static int ocfs2_set_la_first_window_size(struct ocfs2_super *osb)
+{
+	int ret;
+	unsigned long ratio;
+	struct buffer_head *bh = NULL;
+	struct ocfs2_dinode *fe = NULL;
+	struct inode *global_bitmap_inode = NULL;
+
+	global_bitmap_inode = ocfs2_get_system_file_inode(osb,
+			GLOBAL_BITMAP_SYSTEM_INODE, OCFS2_INVALID_SLOT);
+	if (!global_bitmap_inode) {
+		mlog(ML_ERROR, "%s: unable to get global_bitmap inode\n", osb->uuid_str);
+		return -EINVAL;
+	}
+
+	inode_lock(global_bitmap_inode);
+	ret = ocfs2_inode_lock(global_bitmap_inode, &bh, 0);
+	if (ret < 0) {
+		mlog_errno(ret);
+		inode_unlock(global_bitmap_inode);
+		iput(global_bitmap_inode);
+		return ret;
+	}
+
+	fe = (struct ocfs2_dinode *)bh->b_data;
+	ratio = le32_to_cpu(fe->id1.bitmap1.i_used);
+
+	if (!le32_to_cpu(fe->id1.bitmap1.i_total)) {
+		ret = -EINVAL;
+		mlog(ML_ERROR, "global bitmap has invalid total bit value: 0\n");
+		goto out_unlock;
+	}
+
+	ratio = ratio * 100 / le32_to_cpu(fe->id1.bitmap1.i_total);
+
+	spin_lock(&osb->osb_lock);
+	if (osb->local_alloc_state == OCFS2_LA_DISABLED) {
+		WARN_ON_ONCE(osb->local_alloc_state == OCFS2_LA_DISABLED);
+		spin_unlock(&osb->osb_lock);
+		goto out_unlock;
+	}
+
+	/* if 90% of the storage is already used, most of the gds probably allocated once
+	 * for the local allocator(precisely, 96% if every one gd allocated once), so we
+	 * can turn down the local alloctor size to speed up the allocation.
+	 */
+	if (osb->local_alloc_state != OCFS2_LA_THROTTLED) {
+		if (ratio < STORAGE_USED_RATIO)
+			osb->local_alloc_bits = osb->local_alloc_default_bits;
+		else
+			osb->local_alloc_bits = osb->bitmap_cpg - osb->local_alloc_default_bits - 1;
+	}
+	spin_unlock(&osb->osb_lock);
+
+out_unlock:
+	ocfs2_inode_unlock(global_bitmap_inode, 0);
+	inode_unlock(global_bitmap_inode);
+	brelse(bh);
+	iput(global_bitmap_inode);
+
+	return ret;
+}
