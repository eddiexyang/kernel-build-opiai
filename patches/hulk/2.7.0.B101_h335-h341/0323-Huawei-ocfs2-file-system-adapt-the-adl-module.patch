+static int ocfs2_fs_error_time_output(char *buf, struct ocfs2_super *osb)
+{
+	char *p = buf;
+	struct rtc_time tm;
+	unsigned long err_time = osb->error_time.tv_sec;
+
+	rtc_time64_to_tm(err_time, &tm);
+
+	/* Beijing time = UTC time + 8 hour */
+	tm.tm_hour += 8;
+	if (tm.tm_hour >= 24) {
+		tm.tm_hour -= 24;
+		tm.tm_mday += 1;
+	}
+
+	p += sprintf(p, "%04d-%02d-%02d %02d:%02d:%02d",
+			tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday,
+			tm.tm_hour, tm.tm_min, tm.tm_sec);
+
+	p += sprintf(p, "\n");
+
+	return p - buf;
