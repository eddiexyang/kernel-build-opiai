+static int ocfs2_vaai_support_output(char *buf, struct ocfs2_super *osb,
+		unsigned int vaai_type)
+{
+	char *p = buf;
+	u16 flags = 0;
+
+	spin_lock(&osb->osb_lock);
+	if (((vaai_type == OCFS2_WS_STATE) && osb->osb_ws_support) ||
+			((vaai_type == OCFS2_XCOPY_STATE) && osb->osb_xcopy_support) ||
+			((vaai_type == OCFS2_CAW_STATE) && ocfs2_disk_lock(osb)))
+		flags = 1;
+	spin_unlock(&osb->osb_lock);
+
+#define MAX_OUTPUT_LEN 4
+	if (flags)
+		p += snprintf(p, MAX_OUTPUT_LEN, "%s", "yes");
+	else
+		p += snprintf(p, MAX_OUTPUT_LEN, "%s", "no");
+
+	p += snprintf(p, MAX_OUTPUT_LEN, "\n");
+
+	return p - buf;
+}
