+	struct ocfs2_super *osb = PDE_DATA(d_inode(filp->f_path.dentry));
+	char tbuf[20];
+	char *switch_on = "on\n";
+	char *switch_off = "off\n";
+	unsigned int switch_state;
+
+	if (*ppos || count > sizeof(tbuf)-1)
+		return -EINVAL;
+
+	if (copy_from_user(tbuf, buf, count))
+		return -EFAULT;
+	tbuf[count] = 0;
+
+	if (strncmp(tbuf, switch_on, strlen(switch_on)) == 0)
+		switch_state = 1;
+	else if (strncmp(tbuf, switch_off, strlen(switch_off)) == 0)
+		switch_state = 0;
+	else
+		return -EINVAL;
+
+	if (!ocfs2_update_vaai_switch_state(osb, OCFS2_XCOPY_STATE, switch_state))
+		goto out;
+
+	return -EINVAL;
+
+out:
+	*ppos += count;
+	return count;
+}
