+static int ocfs2_update_vaai_switch_state(struct ocfs2_super *osb,
+		unsigned int vaai_type, unsigned int switch_state)
+{
+	int ret = -EINVAL;
+	u32 clusters = 0;
+	struct ocfs2_dinode *super_di = NULL;
+	int change = 0;
+
+	if ((atomic_read(&osb->vol_state) != VOLUME_MOUNTED) &&
+			atomic_read(&osb->vol_state) != VOLUME_MOUNTED_QUOTAS)
+		return ret;
+
+	spin_lock(&osb->osb_lock);
+	if ((vaai_type == OCFS2_XCOPY_STATE) && !osb->osb_xcopy_support) {
+		spin_unlock(&osb->osb_lock);
+		mlog(ML_NOTICE,
+			"%s: ocfs2 do not support xcopy, should not update switch state(%d).\n",
+			osb->uuid_str, switch_state);
+		return ret;
+	} else if ((vaai_type == OCFS2_WS_STATE) && !osb->osb_ws_support) {
+		spin_unlock(&osb->osb_lock);
+		mlog(ML_NOTICE,
+			"%s: ocfs2 do not support writesame, should not update switch state(%d).\n",
+			osb->uuid_str, switch_state);
+		return ret;
+	}
+	spin_unlock(&osb->osb_lock);
+
+	mlog(ML_NOTICE, "%s: turn %s %s switch\n",
+			osb->uuid_str, switch_state ? "on" : "off",
+			(vaai_type == OCFS2_XCOPY_STATE) ? "xcopy" : "writesame");
+
+	mutex_lock(&osb->system_file_mutex);
+	ret = ocfs2_super_block_lock(osb, 1);
+	if (ret < 0) {
+		mutex_unlock(&osb->system_file_mutex);
+		mlog_errno(ret);
+		return ret;
+	}
+
+	super_di = (struct ocfs2_dinode *)osb->osb_super_bh->b_data;
+
+	if (vaai_type == OCFS2_WS_STATE) {
+		if (switch_state) {
+			if (!(super_di->id2.i_super.s_storage_attribute &
+					cpu_to_le16(OCFS2_VAAI_WS_SWITCH))) {
+				super_di->id2.i_super.s_storage_attribute |=
+						cpu_to_le16(OCFS2_VAAI_WS_SWITCH);
+				change = 1;
+			}
+		} else {
+			if (super_di->id2.i_super.s_storage_attribute &
+					cpu_to_le16(OCFS2_VAAI_WS_SWITCH)) {
+				super_di->id2.i_super.s_storage_attribute &=
+						~cpu_to_le16(OCFS2_VAAI_WS_SWITCH);
+				change = 1;
+			}
+		}
+	} else if (vaai_type == OCFS2_XCOPY_STATE) {
+		if (switch_state) {
+			if (!(super_di->id2.i_super.s_storage_attribute &
+					cpu_to_le16(OCFS2_VAAI_XCOPY_SWITCH))) {
+				super_di->id2.i_super.s_storage_attribute |=
+						cpu_to_le16(OCFS2_VAAI_XCOPY_SWITCH);
+				change = 1;
+			}
+		} else {
+			if (super_di->id2.i_super.s_storage_attribute &
+					cpu_to_le16(OCFS2_VAAI_XCOPY_SWITCH)) {
+				super_di->id2.i_super.s_storage_attribute &=
+						~cpu_to_le16(OCFS2_VAAI_XCOPY_SWITCH);
+				change = 1;
+			}
+		}
+	}
+
+	if (!change)
+		goto out;
+
+	clusters = le32_to_cpu(super_di->i_clusters);
+
+	ret = ocfs2_write_super_or_backup(osb, osb->osb_super_bh);
+	if (ret < 0) {
+		mlog_errno(ret);
+		goto out;
+	}
+
+	if (OCFS2_HAS_COMPAT_FEATURE(osb->sb, OCFS2_FEATURE_COMPAT_BACKUP_SB)) {
+		ret = update_backups(osb->root_inode, clusters, osb->osb_super_bh->b_data);
+		if (ret < 0)
+			mlog_errno(ret);
+	}
+
+out:
+	if (ret < 0)
+		mlog(ML_ERROR,
+			"ocfs2: Failed to update super blocks on %s(uuid %s) during update vaai(%u) switch.\n",
+			osb->dev_str, osb->uuid_str, vaai_type);
+
+	ocfs2_super_block_unlock(osb, 1);
+	mutex_unlock(&osb->system_file_mutex);
+	return ret;
+}
