+static ssize_t ocfs2_write_max_unlock_expire(struct file *filp, const char __user *buf,
+				  size_t count, loff_t *ppos)
+{
+	struct ocfs2_super *osb = PDE_DATA(d_inode(filp->f_path.dentry));
+	char tbuf[24];
+	unsigned long tmp;
+	char *p;
+
+	if (*ppos || count > sizeof(tbuf) - 1)
+		return -EINVAL;
+
+	if (copy_from_user(tbuf, buf, count))
+		return -EFAULT;
+	tbuf[count] = 0;
+
+	tmp = simple_strtoul(tbuf, &p, 10);
+	if (!p || (*p && (*p != '\n')))
+		return -EINVAL;
+
+	if (tmp < DISK_RETRY_TIME_MS)
+		return -EINVAL;
+
+	mlog(ML_NOTICE, "%s: set unlock expire from %lums to %lums\n",
+			osb->uuid_str, osb->osb_expire_max_ms, tmp);
+
+	spin_lock(&osb->osb_lock);
+	osb->osb_expire_max_ms = tmp;
+	spin_unlock(&osb->osb_lock);
+
+	*ppos += count;
+	return count;
+}
+
+static ssize_t ocfs2_read_max_unlock_expire(struct file *filp, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct ocfs2_super *osb = PDE_DATA(d_inode(filp->f_path.dentry));
+	char str[24] = {0};
+	size_t len;
+	unsigned long p = *ppos;
+
+	len = sprintf(str, "%lu\n", osb->osb_expire_max_ms);
+	if (p >= len)
+		return 0;
+
+	len -= p;
+	if (len > count)
+		len = count;
+
+	if (copy_to_user(buf, (void *)(str + p), len))
+		return -EFAULT;
+
+	*ppos += len;
+	return len;
+}
