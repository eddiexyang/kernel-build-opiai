+{
+	struct ocfs2_super *osb = PDE_DATA(d_inode(filp->f_path.dentry));
+	ssize_t len;
+	unsigned long p = *ppos;
+	char status[16] = {0};
+
+	len = ocfs2_fs_status_output(status, osb);
+	if (len <= p)
+		return 0;
+
+	len -= p;
+	if (len > count)
+		len = count;
+
+	if (copy_to_user(buf, status, len))
+		return -EFAULT;
+
+	*ppos += len;
+	return len;
