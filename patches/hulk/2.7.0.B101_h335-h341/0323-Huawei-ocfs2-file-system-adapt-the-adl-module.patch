+static ssize_t ocfs2_write_recovery_flag(struct file *filp, const char __user *buf,
+				  size_t count, loff_t *ppos)
+{
+	struct ocfs2_super *osb = PDE_DATA(d_inode(filp->f_path.dentry));
+	char tbuf[20];
+	const char *recovery = "recovery\n";
+	const char *recovery_end = "recovery_end\n";
+
+	if (*ppos || count > sizeof(tbuf) - 1)
+		return -EINVAL;
+
+	if (copy_from_user(tbuf, buf, count))
+		return -EFAULT;
+	tbuf[count] = 0;
+
+	spin_lock(&osb->osb_lock);
+	if (!strncmp(tbuf, recovery, strlen(recovery))) {
+		mlog(ML_NOTICE, "%s: OCFS2 start recovery.\n", osb->uuid_str);
+		osb->osb_flags |= OCFS2_OSB_ONLINE_RECOVERY;
+	} else if (!strncmp(tbuf, recovery_end, strlen(recovery_end))) {
+		mlog(ML_NOTICE, "%s: OCFS2 recovery end.\n", osb->uuid_str);
+		osb->osb_flags &= ~OCFS2_OSB_ONLINE_RECOVERY;
+	} else {
+		spin_unlock(&osb->osb_lock);
+		return -EINVAL;
+	}
+	spin_unlock(&osb->osb_lock);
+
+	*ppos += count;
+	return count;
+}
