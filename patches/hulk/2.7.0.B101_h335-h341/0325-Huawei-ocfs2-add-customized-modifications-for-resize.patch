 	OCFS2_INFO_FREEFRAG,
 	OCFS2_INFO_NUM_TYPES
@@ -230,5 +249,58 @@ struct ocfs2_move_extents {
 							 */
 
 #define OCFS2_IOC_MOVE_EXT	_IOW('o', 6, struct ocfs2_move_extents)
+#define OCFS2_IOC_RESORT_GD	_IOW('o', 7, void *)
+
+struct ocfs2_zero_range {
+	__u64 start;
+	__u64 len;
+	__u64 reserved[2];
+};
+
+#define OCFS2_IOC_ZERO		_IOW('z', 10, struct ocfs2_zero_range)
+#define OCFS2_ZERO_UPDATE	_IOW('z', 11, struct ocfs2_zero_range)
+
+#define OCFS2_DISK_NAME_LEN 32
+#define OCFS2_XCOPY_EXTENT_UNWRITTEN 0x01
