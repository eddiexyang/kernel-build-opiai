-	BUG_ON(!OCFS2_IS_VALID_DINODE(fe));
+	 * but cache may be destroyed when using dd command, so main_bm_bh
+	 * may be corrupted then */
+	if (!OCFS2_IS_VALID_DINODE(fe)) {
+		ocfs2_error(osb->sb, "Invalid dinode #%llu: signature = %.*s",
