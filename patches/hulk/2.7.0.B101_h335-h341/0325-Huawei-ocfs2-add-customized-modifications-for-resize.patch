+
+#define OCFS2_IOC_SET_HIGH_PERF_DIO _IOW('a', 31, int)
+
+#define OCFS2_IOC_FENCE_SCSI _IOW('f', 41, void *)
+#define OCFS2_IOC_CLEAR_FENCE_SCSI _IOW('f', 42, void *)
