 fs/ocfs2/ocfs2_ioctl.h |  76 ++++++-
 fs/ocfs2/ocfs2_trace.h |  15 +-
 fs/ocfs2/resize.c      | 477 ++++++++++++++++++++++++++++++++++++-----
