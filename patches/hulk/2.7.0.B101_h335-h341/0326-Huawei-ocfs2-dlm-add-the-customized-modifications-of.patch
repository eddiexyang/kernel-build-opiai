+static inline void dlm_set_lockres_finalize_stage1(struct dlm_lock_resource *res)
+{
+	assert_spin_locked(&res->spinlock);
+	res->state |= DLM_LOCK_RES_RECO_FINALIZE_STAGE1;
+}
 
+static inline void dlm_clear_lockres_finalize_stage1(struct dlm_lock_resource *res)
+{
+	assert_spin_locked(&res->spinlock);
+	res->state &= ~DLM_LOCK_RES_RECO_FINALIZE_STAGE1;
+}
+
+static inline void dlm_set_lockres_owner_pre_reco(struct dlm_lock_resource *res,
+		u16 owner_pre_reco)
+{
+	assert_spin_locked(&res->spinlock);
+	res->owner_pre_reco = owner_pre_reco;
+}
+
+static int dlm_is_finalize_reco_interrupted(struct dlm_ctxt *dlm,
+		struct dlm_lock_resource *res,
+		u16 dead_node)
+{
+	assert_spin_locked(&dlm->spinlock);
+	assert_spin_locked(&res->spinlock);
+
+	if ((res->state & DLM_LOCK_RES_RECO_FINALIZE_STAGE1) &&
+			(res->owner_pre_reco == dead_node)) {
+		mlog(0,
+		     "%s: res %.*s finalize recovery interrupt owner_pre_reco=%u owner=%u\n",
+		     dlm->name, res->lockname.len, res->lockname.name,
+		     res->owner_pre_reco, res->owner);
+		return 1;
+	} else if ((res->state & DLM_LOCK_RES_RECOVERING) &&
+			(res->reco_master == dead_node) &&
+			(dlm->reco.dead_node != res->owner)) {
+		/*
+		 * if res->owner = reco.dead_node, this lockres is being recovered,
+		 * we don't need to deal with it.
+		 */
+		mlog(0,
+		     "%s: res %.*s finalize recovery interrupt reco_master=%u owner=%u\n",
+		     dlm->name, res->lockname.len, res->lockname.name,
+		     res->reco_master, res->owner);
+		return 1;
+	}
+	return 0;
+}
+
+/*
+ * when send all_dong msg set the reco_master,
+ * when finalize recovery clear the reco master
+ */
+static void dlm_set_lockres_reco_master(struct dlm_ctxt *dlm, u16 dead_node,
+		u16 reco_master)
+{
+	struct hlist_head *bucket;
+	struct dlm_lock_resource *res;
+	int i;
+
+	assert_spin_locked(&dlm->spinlock);
+	for (i = 0; i < DLM_HASH_BUCKETS; i++) {
+		bucket = dlm_lockres_hash(dlm, i);
+		hlist_for_each_entry(res, bucket, hash_node) {
+			spin_lock(&res->spinlock);
+			if ((res->state & DLM_LOCK_RES_RECOVERING) &&
+					(res->owner == dead_node)) {
+				res->reco_master = reco_master;
+			}
+			spin_unlock(&res->spinlock);
+		}
+	}
+}
 
