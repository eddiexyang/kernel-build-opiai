+int dlm_need_resend_msg_timeout(struct dlm_ctxt *dlm, u16 node,
+		int err, int timeout)
+{
+	int resend = 0;
+
+	//mlog_errno(err);
+	mlog(ML_NOTICE, "%s: status = %d\n", dlm->name, err);
+	if (err == -ENOMEM) {
+		mlog(ML_ERROR, "%s: out of memory while sending message to %u, resending\n",
+		    dlm->name, node);
+		msleep(50);
+		resend = 1;
+	} else if (err == -EAGAIN || err == EAGAIN) {
+		mlog(ML_ERROR, "%s: need resend message to node %u\n", dlm->name, node);
+		msleep(100);
+		resend = 1;
+	} else if (dlm_is_host_down(err)) {
+		/* check if node still alive */
+		if (!dlm_is_node_dead(dlm, node)) {
+			/* wait timeout milliseconds and then check it again,
+			 * if it is still alive, resend it */
+			msleep(timeout);
+			if (!dlm_is_node_dead(dlm, node)) {
+				mlog(ML_NOTICE, "%s: node %d is still live, resending\n",
+						dlm->name, node);
+				resend = 1;
+			}
+		}
+	}
+
+return resend;
+}
+
+int dlm_need_resend_msg(struct dlm_ctxt *dlm, u16 node, int err)
+{
+	return dlm_need_resend_msg_timeout(dlm, node,
+			err, DLM_NODE_DEATH_WAIT_MAX);
+}
+
+void dlm_set_o2hb_invalid(struct dlm_ctxt *dlm)
+{
+	spin_lock(&dlm->spinlock);
+	if (__dlm_is_invalid(dlm)) {
+		spin_unlock(&dlm->spinlock);
+		return;
+	}
+	dlm->orphan = 1;
+	spin_unlock(&dlm->spinlock);
+	mlog(ML_ERROR, "%s: other nodes found me invalid, set myself "
+			"invalid\n", dlm->name);
+	o2hb_handle_invalid(dlm->name);
+}
