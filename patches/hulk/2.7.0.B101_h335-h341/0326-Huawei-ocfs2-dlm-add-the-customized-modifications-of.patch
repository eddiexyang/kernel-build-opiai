+void dlm_purge_recovery_lock(struct dlm_ctxt *dlm)
+{
+	unsigned int unused;
+	struct dlm_lock_resource *res;
+	unsigned int hash = dlm_lockid_hash(DLM_RECOVERY_LOCK_NAME,
+		DLM_RECOVERY_LOCK_NAME_LEN);
+
+	spin_lock(&dlm->spinlock);
+	res = __dlm_lookup_lockres(dlm, DLM_RECOVERY_LOCK_NAME,
+					 DLM_RECOVERY_LOCK_NAME_LEN, hash);
+
+	if (res) {
+		if (list_empty(&res->purge)) {
+			dlm_lockres_put(res);
+			goto out;
+		}
+		spin_lock(&res->spinlock);
+
+		mlog(0, "%s: $REOCVERY is being purged\n", dlm->name);
+
+		unused = __dlm_lockres_unused(res);
+		if (!unused) {
+			mlog(0,
+			     "%s: res %.*s is in use or being remastered, used %d, state %d\n",
+			     dlm->name, res->lockname.len, res->lockname.name,
+			     !unused, res->state);
+			spin_unlock(&res->spinlock);
+			dlm_lockres_put(res);
+			goto out;
+		}
+
+		dlm_purge_lockres(dlm, res);
+
+		dlm_lockres_put(res);
+	}
+out:
+	spin_unlock(&dlm->spinlock);
