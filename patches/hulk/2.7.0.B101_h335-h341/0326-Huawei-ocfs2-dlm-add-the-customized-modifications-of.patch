+/*
+ * check if domain map matches during mounting
+ */
+static int dlm_query_domain_map_handler(struct o2net_msg *msg, u32 len,
+		void *data, void **ret_data)
+{
+	struct dlm_query_domainmap *query;
+	struct dlm_ctxt *dlm = NULL;
+	int status = 0;
+	int ret = 0;
+
+	query = (struct dlm_query_domainmap *) msg->buf;
+
+	mlog(0, "node %u wants to check domain map in domain %s\n",
+			be16_to_cpu(query->qd_node), query->qd_domain);
+
+	spin_lock(&dlm_domain_lock);
+	dlm = __dlm_lookup_domain_full(query->qd_domain, query->qd_namelen);
+	if (!dlm) {
+		status = -EINVAL;
+		mlog(ML_ERROR, "I am not in domain %s\n", query->qd_domain);
+		goto unlock_respond;
+	}
+
+	spin_lock(&dlm->spinlock);
+	ret = memcmp(query->qd_domain_map, dlm->domain_map,
+			sizeof(query->qd_domain_map));
+	spin_unlock(&dlm->spinlock);
+
+	if (ret) {
+		status = -EINVAL;
+		mlog(ML_ERROR,
+		     "Sorry! Domain map does not match, domain:%s, node num: %d.\n",
+		     query->qd_domain, be16_to_cpu(query->qd_node));
+		spin_lock(&dlm->spinlock);
+		__dlm_print_nodes(dlm);
+		spin_unlock(&dlm->spinlock);
+	}
+
+unlock_respond:
+	spin_unlock(&dlm_domain_lock);
+	return status;
+}
+
+static int dlm_send_query_domain_map(struct dlm_ctxt *dlm,
+		unsigned long *node_map)
+{
+	struct dlm_query_domainmap query_msg;
+	int ret = 0, status, i;
+
+	memset(&query_msg, 0, sizeof(query_msg));
+	query_msg.qd_namelen = strlen(dlm->name);
+	query_msg.qd_node = cpu_to_be16(dlm->node_num);
+	memcpy(query_msg.qd_domain, dlm->name, query_msg.qd_namelen);
+
+resend_all:
+	/* copy response map to query message */
+	byte_copymap(query_msg.qd_domain_map, node_map, O2NM_MAX_NODES);
+
+	i = -1;
+	while ((i = find_next_bit(node_map, O2NM_MAX_NODES, i + 1))
+			< O2NM_MAX_NODES) {
+		if (i == dlm->node_num)
+			continue;
+
+		mlog(0, "Sending domain map to node %d. Doamin: %s\n", i, dlm->name);
+
+resend:
+		ret = o2net_send_message(DLM_QUERY_DOMAIN_MAP, DLM_MOD_KEY,
+					 &query_msg, sizeof(struct dlm_query_domainmap),
+					 i, 0, &status);
+		if (ret < 0) {
+			mlog(ML_ERROR, "Error %d sending query domain map "
+			     "message to node %d on domain %s\n", ret, i, dlm->name);
+			if (dlm_need_resend_msg_timeout(dlm, i, ret, 1000))
+				goto resend;
+
+			clear_bit(i, node_map);
+			goto resend_all;
+		} else {
+			ret = status;
+			if (ret) {
+				mlog(ML_ERROR, "node %d in domain %s, domain map "
+				     "does not match. Error %d\n", i, dlm->name, ret);
+				break;
+			}
+		}
+	}
+
+	return ret;
+}
