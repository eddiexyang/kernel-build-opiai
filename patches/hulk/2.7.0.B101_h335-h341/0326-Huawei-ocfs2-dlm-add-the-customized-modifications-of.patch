+
+unsigned long dlm_get_recovery_thread_timeout(void)
+{
+	return dlm_reco_thread_timeout_ms;
+}
+
+static int debug_reco_thread_timeout_open(struct inode *inode,
+		struct file *filp)
+{
+	filp->private_data = inode->i_private;
+	return 0;
+}
+
+static ssize_t debug_reco_thread_timeout_read(struct file *filp,
+		char __user *ubuf, size_t cnt, loff_t *ppos)
+{
+	unsigned long *timeout = filp->private_data;
+	char buf[64];
+	int r;
+
+	r = snprintf(buf, 64, "%lu\n", *timeout);
+
+	return simple_read_from_buffer(ubuf, cnt, ppos, buf, r);
+}
+
+static ssize_t debug_reco_thread_timeout_write(struct file *filp,
+		const char __user *ubuf, size_t cnt, loff_t *ppos)
+{
+	unsigned long *timeout = filp->private_data;
+	char buf[64];
+	unsigned long tmp;
+	int ret;
+
+	if (cnt >= sizeof(buf))
+		return -EINVAL;
+
+	if (copy_from_user(&buf, ubuf, cnt))
+		return -EFAULT;
+
+	buf[cnt] = 0;
+
+	ret = kstrtoul(buf, 10, &tmp);
+	if (ret < 0)
+		return ret;
+
+	if (tmp == 0 || tmp > RECO_MAX_TIMEOUT_MS)
+		return -EINVAL;
+
+	*timeout = tmp;
+
+	(*ppos)++;
+
+	return cnt;
+}
+
+static const struct file_operations debug_reco_thread_fops = {
+	.open	=	debug_reco_thread_timeout_open,
+	.read	=	debug_reco_thread_timeout_read,
+	.write	=	debug_reco_thread_timeout_write,
+	.llseek	=	generic_file_llseek,
+};
