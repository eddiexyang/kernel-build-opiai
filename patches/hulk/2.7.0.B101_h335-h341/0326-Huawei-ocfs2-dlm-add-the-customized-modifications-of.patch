+			S_IRUGO|S_IWUSR, dlm_debugfs_root,
+			&dlm_reco_thread_timeout_ms, &debug_reco_thread_fops);
 }
 
 void dlm_destroy_debugfs_root(void)
 {
+	debugfs_remove(dlm_reco_thread_timeout_dentry);
 	debugfs_remove(dlm_debugfs_root);
 }
 #endif	/* CONFIG_DEBUG_FS */
