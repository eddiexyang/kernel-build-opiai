From b9b7d83850f7cd1ef4d71775a0ac97e0a6fc6837 Mon Sep 17 00:00:00 2001
From: GUO Zihua <guozihua@huawei.com>
Date: Tue, 14 Feb 2023 16:59:48 +0800
Subject: [PATCH 862/921] [Huawei] random: Workaround for 1380 performance
 degrade

Offering: HULK
hulk inclusion
category: bugfix
bugzilla: 188392

--------------------------------

A performance degrade is observed on boards with 1380 chip. Debugging
shows that degrade is caused by the two line in drivers/char/random.c.
The root cause of why these two lines would cause such degrade is
still unknown.

This patch is meant to be a workaround for said issue.

Fixes: 151cfab0861de ("[Backport] random: use first 128 bits of input as fast init")
Signed-off-by: GUO Zihua <guozihua@huawei.com>
---
 drivers/char/Kconfig  |   9 +++
 drivers/char/random.c | 163 +++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 171 insertions(+), 1 deletion(-)

diff --git a/drivers/char/Kconfig b/drivers/char/Kconfig
index 9e80f8fa6feb..38d5c62cc0f9 100644
--- a/drivers/char/Kconfig
+++ b/drivers/char/Kconfig
@@ -504,3 +504,12 @@ config RANDOM_TRUST_BOOTLOADER
 	pool. Otherwise, say N here so it will be regarded as device input that
 	only mixes the entropy pool. This can also be configured at boot with
 	"random.trust_bootloader=on/off".
+
+config RTOS_FIX_RANDOM_PERFORMANCE
+	bool "Fix 1380 random performance degrade"
+	depends on ARM
+	default n
+	help
+	It's observed that there is a performance degrade related to random on
+	system with 1380 chip. The root cause is unknown and this config is
+	meant to be a workaround for that issue.
diff --git a/drivers/char/random.c b/drivers/char/random.c
index 570d36c6a311..63b5eb667717 100644
--- a/drivers/char/random.c
+++ b/drivers/char/random.c
@@ -348,8 +348,10 @@ static void crng_make_state(u32 chacha_state[CHACHA_STATE_WORDS],
 		spin_lock_irqsave(&base_crng.lock, flags);
 		ready = crng_ready();
 		if (!ready) {
+#ifndef CONFIG_RTOS_FIX_RANDOM_PERFORMANCE
 			if (crng_init == CRNG_EMPTY)
 				extract_entropy(base_crng.key, sizeof(base_crng.key));
+#endif
 			crng_fast_key_erasure(base_crng.key, chacha_state,
 					      random_data, random_data_len);
 		}
@@ -393,6 +395,129 @@ static void crng_make_state(u32 chacha_state[CHACHA_STATE_WORDS],
 	local_unlock_irqrestore(&crngs.lock, flags);
 }
 
