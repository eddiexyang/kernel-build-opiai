@@ -871,7 +1004,17 @@ EXPORT_SYMBOL(add_device_randomness);
  */
 void add_hwgenerator_randomness(const void *buf, size_t len, size_t entropy)
 {
+#ifdef CONFIG_RTOS_FIX_RANDOM_PERFORMANCE
+	unsigned long flags;
+#endif
 	mix_pool_bytes(buf, len);
+#ifdef CONFIG_RTOS_FIX_RANDOM_PERFORMANCE
+	if (crng_init == CRNG_EMPTY) {
+		spin_lock_irqsave(&base_crng.lock, flags);
+		extract_entropy(base_crng.key, sizeof(base_crng.key));
+		spin_unlock_irqrestore(&base_crng.lock, flags);
+	}
+#endif
 	credit_init_bits(entropy);
 
 	/*
@@ -963,6 +1106,9 @@ static void mix_interrupt_randomness(struct work_struct *work)
 	 */
 	unsigned long pool[2];
 	unsigned int count;
+#ifdef CONFIG_RTOS_FIX_RANDOM_PERFORMANCE
+	unsigned long flags;
+#endif
 
 	/* Check to see if we're running on the wrong CPU due to hotplug. */
 	local_irq_disable();
@@ -982,6 +1128,13 @@ static void mix_interrupt_randomness(struct work_struct *work)
 	local_irq_enable();
 
 	mix_pool_bytes(pool, sizeof(pool));
+#ifdef CONFIG_RTOS_FIX_RANDOM_PERFORMANCE
+	if (crng_init == CRNG_EMPTY) {
+		spin_lock_irqsave(&base_crng.lock, flags);
+		extract_entropy(base_crng.key, sizeof(base_crng.key));
+		spin_unlock_irqrestore(&base_crng.lock, flags);
+	}
+#endif
 	credit_init_bits(clamp_t(unsigned int, (count & U16_MAX) / 64, 1, sizeof(pool) * 8));
 
 	memzero_explicit(pool, sizeof(pool));
@@ -1087,8 +1240,16 @@ static void add_timer_randomness(struct timer_rand_state *state, unsigned int nu
 	 */
 	if (in_irq())
 		this_cpu_ptr(&irq_randomness)->count += max(1u, bits * 64) - 1;
-	else
