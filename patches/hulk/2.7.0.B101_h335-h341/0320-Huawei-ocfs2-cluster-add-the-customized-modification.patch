+static int o2nm_node_change_ip_address(struct o2nm_node *node)
+{
+	int ret = 0;
+
+	/*
+	 * OTHER NODES: disconnect --> reconnect
+	 * MY NODE: stop listening --> start listening --> connect all nodes
+	 */
+	if (node->nd_num != o2nm_this_node()) {
+		o2net_disconnect_node(node);
+		o2net_connect_node(node);
+	} else {
+		o2net_stop_listening(node, true);
+		o2net_pre_stop_listening(node, true);
+		ret = o2net_start_listening(node, true);
+		if (ret) {
+			mlog_errno(ret);
+			goto out;
+		}
+
+		ret = o2net_pre_start_listening(node, true);
+		if (ret) {
+			mlog_errno(ret);
+			o2net_stop_listening(node, true);
+		}
+
+		o2net_connect_all_node(node);
+	}
+
+out:
+	return ret;
+}
