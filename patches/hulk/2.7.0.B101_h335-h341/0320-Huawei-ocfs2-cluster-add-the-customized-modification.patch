+static void o2nm_node_ip_tree_rollback(struct o2nm_cluster *cluster,
+					    struct o2nm_node *node)
+{
+	struct rb_node **p, *parent;
+
+	o2nm_node_change_ip_address(node);
+
+	write_lock(&cluster->cl_nodes_lock);
+	if (node->nd_ipnet_type == IPV4_TYPE) {
+		if (!o2nm_node_ipv4_tree_lookup(cluster, node->nd_ipv4_address, &p, &parent)) {
+			rb_link_node(&node->nd_ip_node, parent, p);
+			rb_insert_color(&node->nd_ip_node, &cluster->cl_node_ipv4_tree);
+		}
+	} else if (node->nd_ipnet_type == IPV6_TYPE) {
+		if (!o2nm_node_ipv6_tree_lookup(cluster, node->nd_ipv6_address, &p, &parent)) {
+			rb_link_node(&node->nd_ip_node, parent, p);
+			rb_insert_color(&node->nd_ip_node, &cluster->cl_node_ipv6_tree);
+		}
+	}
+	write_unlock(&cluster->cl_nodes_lock);
+}
