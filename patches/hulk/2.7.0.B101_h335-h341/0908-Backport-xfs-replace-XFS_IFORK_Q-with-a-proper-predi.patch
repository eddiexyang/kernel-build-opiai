 		error = xfs_bmap_count_blocks(tp, tip, XFS_ATTR_FORK, &junk,
 				&taforkblks);
diff --git a/fs/xfs/xfs_inode.c b/fs/xfs/xfs_inode.c
index e862a41a408c..3d4bf9ee79bc 100644
--- a/fs/xfs/xfs_inode.c
