+++ b/fs/xfs/libxfs/xfs_inode_fork.c
@@ -732,7 +732,7 @@ xfs_ifork_verify_local_attr(
 	struct xfs_ifork	*ifp = &ip->i_af;
 	xfs_failaddr_t		fa;
 
