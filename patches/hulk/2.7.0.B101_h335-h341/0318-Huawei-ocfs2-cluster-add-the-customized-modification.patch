+	mutex_lock(&o2hb_mutex_lock);
+	spin_lock(&o2hb_live_lock);
+	if (reg->hr_unclean_stop == 1) {
+		spin_unlock(&o2hb_live_lock);
+		mutex_unlock(&o2hb_mutex_lock);
+		o2nm_node_put(node);
