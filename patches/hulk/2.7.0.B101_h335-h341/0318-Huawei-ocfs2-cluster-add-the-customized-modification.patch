+			continue;
+		if (!memcmp(uuid, config_item_name(&reg->hr_item),
+				strlen(config_item_name(&reg->hr_item)))) {
+			found = 1;
+			break;
+		}
+	}
+
+	if (found == 0) {
+		mlog(ML_ERROR, "cannot find region %s\n", uuid);
+		goto unlock;
+	}
+
