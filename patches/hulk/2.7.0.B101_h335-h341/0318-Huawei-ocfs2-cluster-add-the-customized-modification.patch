+	BUG_ON((!node) && (type != O2HB_NODE_DOWN_CB) &&
+			(type != O2HB_REGION_DOWN_CB) &&
+			(type != O2HB_FENCE_SCSI_CB));
+
+	event->hn_event_type = type;
+	event->hn_node = node;
