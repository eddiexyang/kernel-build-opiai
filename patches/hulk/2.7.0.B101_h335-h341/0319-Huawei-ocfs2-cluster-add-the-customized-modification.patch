+static void o2net_hb_node_down_cb(struct o2nm_node *node, int node_num,
+				  void *data, u64 generation)
+{
+	if (!node)
+		return;
+
+	if (node_num != o2nm_this_node())
+		o2net_disconnect_node(node);
+
+	BUG_ON(atomic_read(&o2net_connected_peers) < 0);
+}
