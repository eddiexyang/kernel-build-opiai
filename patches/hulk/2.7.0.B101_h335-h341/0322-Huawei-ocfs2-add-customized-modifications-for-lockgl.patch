diff --git a/fs/ocfs2/acl.c b/fs/ocfs2/acl.c
index 7b07f5df3a29..db7da0d25f86 100644
--- a/fs/ocfs2/acl.c
+++ b/fs/ocfs2/acl.c
@@ -20,7 +20,7 @@
 
 #include "ocfs2.h"
 #include "alloc.h"
-#include "dlmglue.h"
+#include "lockglue.h"
 #include "file.h"
 #include "inode.h"
 #include "journal.h"
@@ -266,7 +266,7 @@ int ocfs2_iop_set_acl(struct inode *inode, struct posix_acl *acl, int type)
 {
 	struct buffer_head *bh = NULL;
 	int status, had_lock;
-	struct ocfs2_lock_holder oh;
+	struct ocfs2_lock_holder *oh;
 
 	had_lock = ocfs2_inode_lock_tracker(inode, &bh, 1, &oh);
 	if (had_lock < 0)
@@ -295,7 +295,7 @@ struct posix_acl *ocfs2_iop_get_acl(struct inode *inode, int type)
 	struct buffer_head *di_bh = NULL;
 	struct posix_acl *acl;
 	int had_lock;
