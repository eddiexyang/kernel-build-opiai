+static int ocfs2_xattr_compatible(struct ocfs2_super *osb,
+		struct inode *inode, const char *xattr_name)
+{
+	int ret = 0;
+	char kvalue[XATTR_OWNER_VALUE_LEN + 1] = {0};
+	struct ocfs2_inode_info *oi = OCFS2_I(inode);
+
+	if (XATTR_NAME_IS_OWNER(xattr_name)) {
+		ret = ocfs2_inode_get_share_vol(inode);
+		if (ret < 0)
+			mlog_errno(ret);
+		else {
+			spin_lock(&oi->ip_lock);
+			ret = (oi->ip_shared_vol == 1) ? 0 : 1;
+			spin_unlock(&oi->ip_lock);
+		}
+	} else {
+		ret = ocfs2_xattr_get(inode, OCFS2_XATTR_INDEX_USER,
+				XATTR_OWNER_NAME, kvalue, sizeof(kvalue));
+		if (ret < 0 && ret != -ENODATA && ret != -EOPNOTSUPP)
+			mlog_errno(ret);
+		else
+			ret = (ret == -ENODATA || ret == -EOPNOTSUPP) ? 1 : 0;
+	}
+
+	return ret;
+}
