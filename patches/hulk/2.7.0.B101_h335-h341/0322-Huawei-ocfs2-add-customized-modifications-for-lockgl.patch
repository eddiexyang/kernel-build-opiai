+	if (XATTR_NAME_IS_OWNER(name) ||
+			XATTR_NAME_IS_SHARED_VOL(name)) {
+		ret = ocfs2_xattr_sharedvol_and_owner_set(unused, name,
+				value, size, flags);
+		if (ret < 0)
+			mlog_errno(ret);
+		return ret;
+	} else
+		return ocfs2_xattr_set(inode, OCFS2_XATTR_INDEX_USER,
+				name, value, size, flags);
