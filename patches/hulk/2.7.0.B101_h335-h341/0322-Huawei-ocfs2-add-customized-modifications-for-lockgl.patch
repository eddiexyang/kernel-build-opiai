+static int ocfs2_get_ws_state(struct inode *inode, unsigned int *flags)
+{
+	struct ocfs2_super *osb = OCFS2_SB(inode->i_sb);
+	int ws_switch;
+
+	ws_switch = ocfs2_get_vaai_switch_state(osb, OCFS2_WS_STATE);
+	if (ws_switch < 0) {
+		mlog_errno(ws_switch);
+		return ws_switch;
+	}
+
+	spin_lock(&osb->osb_lock);
+	if (osb->osb_ws_support && ws_switch)
+		*flags = 1;
+	else
+		*flags = 0;
+	spin_unlock(&osb->osb_lock);
+	return 0;
+}
+
+static int ocfs2_get_xcopy_state(struct inode *inode, unsigned int *flags)
+{
+	struct ocfs2_super *osb = OCFS2_SB(inode->i_sb);
+	int xcopy_switch;
+
+	xcopy_switch = ocfs2_get_vaai_switch_state(osb, OCFS2_XCOPY_STATE);
+	if (xcopy_switch < 0) {
+		mlog_errno(xcopy_switch);
+		return xcopy_switch;
+	}
+
+	spin_lock(&osb->osb_lock);
+	if (osb->osb_xcopy_support && xcopy_switch)
+		*flags = 1;
+	else
+		*flags = 0;
+	spin_unlock(&osb->osb_lock);
+
+	return 0;
+}
