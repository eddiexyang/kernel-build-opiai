+int ocfs2_getxattr_owner(struct inode *inode,
+		struct buffer_head *di_bh,
+		void *buffer,
+		size_t buffer_size)
+{
+	int ret;
+	struct ocfs2_super *osb = OCFS2_SB(inode->i_sb);
+
+	if (osb->s_mount_opt & OCFS2_MOUNT_NOUSERXATTR)
+		return -EOPNOTSUPP;
+
+	down_read(&OCFS2_I(inode)->ip_xattr_sem);
+	ret = ocfs2_xattr_get_nolock(inode, di_bh, OCFS2_XATTR_INDEX_USER,
+				     XATTR_OWNER_NAME, buffer, buffer_size);
+	up_read(&OCFS2_I(inode)->ip_xattr_sem);
+	if (ret < 0 && ret != -ENODATA && ret != -EOPNOTSUPP)
+		mlog_errno(ret);
+
+	return ret;
+}
+
+int ocfs2_inode_get_share_vol(struct inode *inode)
+{
+	int ret;
+	struct ocfs2_inode_info *oi = OCFS2_I(inode);
+	struct ocfs2_super *osb = OCFS2_SB(inode->i_sb);
+	char buf[XATTR_SHARED_VOL_VALUE_LEN + 1] = {0};
+
+	if (osb->s_mount_opt & OCFS2_MOUNT_NOUSERXATTR)
+		return 0;
+
+	ret = ocfs2_xattr_get(inode, OCFS2_XATTR_INDEX_USER,
+			XATTR_SHARED_VOL_NAME, buf, sizeof(buf));
+	if (ret < 0) {
+		if (ret == -ENODATA || ret == -EOPNOTSUPP) {
+			spin_lock(&oi->ip_lock);
+			oi->ip_shared_vol = 0;
+			spin_unlock(&oi->ip_lock);
+			ret = 0;
+		} else {
+			mlog_errno(ret);
+		}
+		return ret;
+	}
+
+	spin_lock(&oi->ip_lock);
+	oi->ip_shared_vol = XATTR_SHARED_VOL_VALUE_IS_YES(buf) ? 1 : 0;
+	spin_unlock(&oi->ip_lock);
+
+	return 0;
+}
