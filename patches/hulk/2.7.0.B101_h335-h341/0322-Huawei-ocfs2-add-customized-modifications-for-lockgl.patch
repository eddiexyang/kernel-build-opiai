+static int ocfs2_xattr_sharedvol_and_owner_set(struct dentry *dentry, const char *name,
+		const void *value, size_t size, int flags)
+{
+	int ret = 0;
+	struct ocfs2_super *osb = OCFS2_SB(dentry->d_sb);
+	struct inode *inode = d_inode(dentry);
+	struct ocfs2_inode_info *oi = OCFS2_I(inode);
+	char kvalue[XATTR_OWNER_VALUE_LEN + 1] = {0};
+
+	if (!S_ISREG(inode->i_mode)) {
+		mlog(ML_ERROR,
+				"%s: not support setting %s for non-regular file %pd\n",
+				osb->uuid_str, name, dentry);
+		return -EINVAL;
+	}
+
+	ret = ocfs2_xattr_compatible(osb, inode, name);
+	if (ret < 0) {
+		mlog_errno(ret);
+		return ret;
+	} else if (ret == 0) {
+		mlog(ML_ERROR,
+				"%s: the %s attribute has been set, can not set the %s attribute\n",
+				osb->uuid_str,
+				XATTR_NAME_IS_OWNER(name) ?
+				XATTR_SHARED_VOL_NAME : XATTR_OWNER_NAME,
+				name);
+		ret = -EINVAL;
+		return ret;
+	}
+
+	if (flags & XATTR_REPLACE) {
+		mlog(ML_NOTICE, "%s: clear %s node %u for %pd\n",
+				osb->uuid_str, name, osb->node_num,
+				dentry);
+		ret = ocfs2_xattr_set(inode, OCFS2_XATTR_INDEX_USER,
+				name, value, size, flags);
+		if (!ret) {
+			spin_lock(&oi->ip_lock);
+			if (XATTR_NAME_IS_OWNER(name))
+				oi->ip_owner = O2NM_MAX_NODES;
+			else
+				oi->ip_shared_vol = 0;
+			spin_unlock(&oi->ip_lock);
+		} else
+			mlog_errno(ret);
+	} else {
+		mlog(ML_NOTICE, "%s: set %s node %u for %pd\n",
+				osb->uuid_str, name, osb->node_num,
+				dentry);
+		if (XATTR_NAME_IS_OWNER(name)) {
+			snprintf(kvalue, XATTR_OWNER_VALUE_LEN + 1, "%u", osb->node_num);
+			ret = ocfs2_xattr_set(inode, OCFS2_XATTR_INDEX_USER,
+					name, kvalue, strlen(kvalue), flags);
+		} else
+			ret = ocfs2_xattr_set(inode, OCFS2_XATTR_INDEX_USER,
+					name, value, size, flags);
+
+		if (!ret) {
+			spin_lock(&oi->ip_lock);
+			if (XATTR_NAME_IS_OWNER(name))
+				oi->ip_owner = osb->node_num;
+			else
+				oi->ip_shared_vol = 1;
+			spin_unlock(&oi->ip_lock);
+		} else
+			mlog_errno(ret);
+	}
+
+	return ret;
+}
