diff --git a/fs/ocfs2/dcache.c b/fs/ocfs2/dcache.c
index 42a61eecdacd..b9c44190235b 100644
--- a/fs/ocfs2/dcache.c
+++ b/fs/ocfs2/dcache.c
@@ -20,7 +20,7 @@
 
 #include "alloc.h"
 #include "dcache.h"
-#include "dlmglue.h"
