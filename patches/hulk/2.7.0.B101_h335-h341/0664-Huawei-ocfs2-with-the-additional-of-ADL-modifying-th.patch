+/*
+ * register two events:
+ *  1. O2HB_DISK_TIMEOUT_CB, set ocfs2 invalid, and detach and add scsi device;
+ *  2. O2HB_COMPLETE_LOCKRES_CB, after ocfs2 invalid, complete lockres waiter;
+ */
+static int ocfs2_register_invalid_callback(struct ocfs2_super *osb)
+{
+	int status = 0;
+
+	o2hb_setup_callback(&osb->osb_disk_timeout, O2HB_DISK_TIMEOUT_CB,
+			ocfs2_disk_timeout, (void *)osb, OCFS2_TIMEOUT_PRI, osb->uuid_str);
+	o2hb_setup_callback(&osb->osb_lockres_complete, O2HB_COMPLETE_LOCKRES_CB,
+			ocfs2_complete_all_lockres, (void *)osb, OCFS2_TIMEOUT_PRI, osb->uuid_str);
+	/* other node invalid, use scsi reservation to fence it */
+	o2hb_setup_callback(&osb->osb_fence_scsi, O2HB_FENCE_SCSI_CB,
+			ocfs2_fence_scsi, (void *)osb, OCFS2_TIMEOUT_PRI, osb->uuid_str);
+
+	status = o2hb_register_callback(osb->uuid_str, &osb->osb_disk_timeout);
+	if (status)
+		goto bail;
+
+	status = o2hb_register_callback(osb->uuid_str, &osb->osb_lockres_complete);
+	if (status)
+		goto bail;
+
+	status = o2hb_register_callback(osb->uuid_str, &osb->osb_fence_scsi);
+	if (status)
+		goto bail;
+
+	return status;
+
+bail:
+	ocfs2_unregister_invalid_callback(osb);
+	return status;
+}
