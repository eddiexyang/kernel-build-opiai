Subject: [PATCH 0023/1398] [Huawei] fork: remove redundant code

Offering: HULK
hulk inclusion
category: bugfix
bugzilla: 187991

-------------------------------

Signed-off-by: Zheng Zucheng <zhengzucheng@huawei.com>
---
 include/linux/tracehook.h | 1 -
 kernel/fork.c             | 2 --
 2 files changed, 3 deletions(-)

diff --git a/include/linux/tracehook.h b/include/linux/tracehook.h
index 53f5065d7e80..16a0ee62f75d 100644
--- a/include/linux/tracehook.h
+++ b/include/linux/tracehook.h
@@ -199,7 +199,6 @@ static inline void tracehook_notify_resume(struct pt_regs *regs)
 #ifdef CONFIG_QOS_SCHED
 	sched_qos_offline_wait();
 #endif
-
 }
 
 /*
diff --git a/kernel/fork.c b/kernel/fork.c
index ca3e113a74ea..faa7164cac34 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -863,9 +863,7 @@ static bool dup_resvd_task_struct(struct task_struct *dst,
 	if (!dst->_resvd)
 		return false;
 
-	memcpy(dst->_resvd, orig->_resvd, sizeof(struct task_struct_resvd));
 	dst->_resvd->task = dst;
-
 	return true;
 }
 
