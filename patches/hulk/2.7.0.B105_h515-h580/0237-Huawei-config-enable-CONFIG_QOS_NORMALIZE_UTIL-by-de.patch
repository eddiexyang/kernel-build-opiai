From 35350dfa834579c4a86cb7730437cd1629f5ceac Mon Sep 17 00:00:00 2001
From: Zheng Zucheng <zhengzucheng@huawei.com>
Date: Tue, 13 Jun 2023 10:11:30 +0800
Subject: [PATCH 237/780] [Huawei] config: enable CONFIG_QOS_NORMALIZE_UTIL by
 default

Offering: HULK
hulk inclusion
category: feature
bugzilla: 188931

--------------------------------

Signed-off-by: Zheng Zucheng <zhengzucheng@huawei.com>
---
 arch/arm64/configs/openeuler_defconfig | 1 +
 arch/x86/configs/openeuler_defconfig   | 1 +
 2 files changed, 2 insertions(+)

diff --git a/arch/arm64/configs/openeuler_defconfig b/arch/arm64/configs/openeuler_defconfig
index 7c53585e91f2..7faf681f994d 100644
--- a/arch/arm64/configs/openeuler_defconfig
+++ b/arch/arm64/configs/openeuler_defconfig
@@ -159,6 +159,7 @@ CONFIG_CGROUP_BPF=y
 CONFIG_QOS_SCHED=y
 CONFIG_QOS_SCHED_SMT_EXPELLER=y
 CONFIG_QOS_SCHED_DYNAMIC_AFFINITY=y
+CONFIG_QOS_NORMALIZE_UTIL=y
 # CONFIG_CGROUP_DEBUG is not set
 CONFIG_SOCK_CGROUP_DATA=y
 CONFIG_CGROUP_FILES=y
diff --git a/arch/x86/configs/openeuler_defconfig b/arch/x86/configs/openeuler_defconfig
index ede44699371c..e1bbd182be19 100644
--- a/arch/x86/configs/openeuler_defconfig
+++ b/arch/x86/configs/openeuler_defconfig
@@ -163,6 +163,7 @@ CONFIG_CGROUP_SCHED=y
 CONFIG_QOS_SCHED=y
 CONFIG_QOS_SCHED_SMT_EXPELLER=y
 CONFIG_QOS_SCHED_DYNAMIC_AFFINITY=y
+CONFIG_QOS_NORMALIZE_UTIL=y
 CONFIG_FAIR_GROUP_SCHED=y
 CONFIG_CFS_BANDWIDTH=y
 CONFIG_RT_GROUP_SCHED=y
