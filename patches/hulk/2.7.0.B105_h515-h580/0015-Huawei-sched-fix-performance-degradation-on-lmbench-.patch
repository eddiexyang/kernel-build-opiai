From bbc1593c619a242aff856a59b9f13859e5edb5c1 Mon Sep 17 00:00:00 2001
From: Zheng Zucheng <zhengzucheng@huawei.com>
Date: Sat, 10 Jun 2023 20:40:55 +0800
Subject: [PATCH 015/780] [Huawei] sched: fix performance degradation on
 lmbench more

Offering: HULK
hulk inclusion
category: bugfix
bugzilla: 186575

--------------------------------

Fixes: b48594bf6206 ("[Huawei] sched: Fix hardlockup on 'set_prefer_cpus_ptr'")
Signed-off-by: Zheng Zucheng <zhengzucheng@huawei.com>
---
 fs/proc/base.c      | 5 ++++-
 kernel/sched/fair.c | 2 +-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/fs/proc/base.c b/fs/proc/base.c
index 8776df3a73a0..ab6ccf26df02 100644
--- a/fs/proc/base.c
+++ b/fs/proc/base.c
@@ -3297,8 +3297,11 @@ static ssize_t preferred_cpuset_write(struct file *file, const char __user *buf,
 	if (retval < 0)
 		goto out_free_cpumask;
 
-	if (!cpumask_empty(new_mask))
+	if (!cpumask_empty(new_mask)) {
+		cpus_read_lock();
 		dynamic_affinity_enable();
+		cpus_read_unlock();
+	}
 
 	retval = count;
 
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index d20352cb2c0f..4ffc48b13637 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -7258,7 +7258,7 @@ static inline bool dynamic_affinity_used(void)
 
 void dynamic_affinity_enable(void)
 {
-	static_branch_enable(&__dynamic_affinity_used);
+	static_branch_enable_cpuslocked(&__dynamic_affinity_used);
 }
 
 #else /* CONFIG_JUMP_LABEL */
