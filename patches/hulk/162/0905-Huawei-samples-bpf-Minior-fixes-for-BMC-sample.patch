 {
 	u32 key = 0;
@@ -225,24 +218,12 @@ static inline bool is_redis_setex(char *s)
 		   s[9] == '\r' && s[10] == '\n';
 }
 
-static inline void record_redis_cmd(char *payload)
-{
-	u64 val = 0;
-	u64 *pval = NULL;
-
-	pval = bpf_map_lookup_elem(&bmc_cmds, payload);
-	if (pval != NULL)
-		val = *pval;
-	val++;
-	bpf_map_update_elem(&bmc_cmds, payload, &val, BPF_ANY);
-}
-
 static inline int xdp_store_str(char *dst, char *src, u32 len, char *data_end)
 {
 	if (dst + len > data_end)
 		return -1;
 
-	memcpy(dst, src, len);
+	__builtin_memcpy(dst, src, len);
 	return 0;
 }
 
@@ -456,20 +437,16 @@ int bmc_get(struct xdp_md *xdp)
 	/* skip "*2\r\n$3\r\nget\r\n" */
 	payload += 13;
 
-	memset(&ctx->key.data, 0, sizeof(u8) * BMC_REDIS_KEY_SIZE);
+	__builtin_memset(&ctx->key.data, 0, sizeof(u8) * BMC_REDIS_KEY_SIZE);
 	xdp_load_bytes(ctx->key.data, payload, ctx->key.len, BMC_REDIS_KEY_SIZE, data_end);
 
 	val = bpf_map_lookup_elem(&bmc_storage, &ctx->key);
 
-	/* pass to userspace */
-	if (!val || !val->len || val->len > BMC_REDIS_VALUE_SIZE)
-		return XDP_PASS;
-
 	/*
 	 * expired, just reply -1
 	 * don't remove element in map, it can be used for next hit
 	 */
-	if (val->expiry && ktime_get_ms() > val->expiry) {
+	if (!val || (val->expiry && ktime_get_ms() > val->expiry)) {
 		if (prepare_tcp(xdp, data, data_end, sizeof(reply)))
 			return XDP_PASS;
 
@@ -545,7 +522,7 @@ int bmc_set(struct xdp_md *xdp)
 	/* skip "*2\r\n$3\r\nset\r\n" */
 	payload += 13;
 
-	memset(&ctx->key.data, 0, sizeof(u8) * BMC_REDIS_KEY_SIZE);
+	__builtin_memset(&ctx->key.data, 0, sizeof(u8) * BMC_REDIS_KEY_SIZE);
 	xdp_load_bytes(ctx->key.data, payload, ctx->key.len, BMC_REDIS_KEY_SIZE, data_end);
 
 	if (ctx->key.len > BMC_REDIS_KEY_SIZE)
@@ -612,7 +589,7 @@ int bmc_setex(struct xdp_md *xdp)
 	/* skip "*4\r\n$5\r\nsetex\r\n" */
 	payload += 15;
 
-	memset(&ctx->key.data, 0, sizeof(u8) * BMC_REDIS_KEY_SIZE);
+	__builtin_memset(&ctx->key.data, 0, sizeof(u8) * BMC_REDIS_KEY_SIZE);
 	xdp_load_bytes(ctx->key.data, payload, ctx->key.len, BMC_REDIS_KEY_SIZE, data_end);
 
 	ctx->value.expiry = ktime_get_ms() + (u64)ctx->expiry_value * MS_PER_SEC;
@@ -652,7 +629,7 @@ int bmc_setex(struct xdp_md *xdp)
 
 /*
