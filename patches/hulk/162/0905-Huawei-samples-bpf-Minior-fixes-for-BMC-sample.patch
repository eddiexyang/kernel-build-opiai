From 31c8e747bea41155a5c1ceae5f190b6c91ad2215 Mon Sep 17 00:00:00 2001
From: Chen Zhongjin <chenzhongjin@huawei.com>
Date: Tue, 14 Feb 2023 01:47:32 -0500
Subject: [PATCH 905/905] [Huawei] samples: bpf: Minior fixes for BMC sample

Offering: HULK
hulk inclusion
category: feature
bugzilla: N/A

--------------------------------

This is a minior fix commit for:
'commit 7b1fe3b7833e ("[Huawei] samples: bpf: Add sample BMC for Redis")'

1. Reply -1 packet directly when GET doesn't find the value in cache
   map.

2. Make BPF_XDP_UPDATE_TCP_SEQ_HELPER default enabled.

3. Fix memcpy() and memset() to builtin version to make them compatible
   with old llvm version.

4. Remove unused code of map bmc_cmds and fix a comment.

Signed-off-by: Chen Zhongjin <chenzhongjin@huawei.com>
---
 net/Kconfig            |   2 +-
 samples/bpf/bmc/bpf.c  |  35 +++-----------
 samples/bpf/bmc/tool.c | 101 +----------------------------------------
 3 files changed, 8 insertions(+), 130 deletions(-)

diff --git a/net/Kconfig b/net/Kconfig
index db3cb5e52cd8..1ddfc8693a0f 100644
--- a/net/Kconfig
+++ b/net/Kconfig
@@ -332,7 +332,7 @@ config EULER_SOCKETMAP
 
 config BPF_XDP_UPDATE_TCP_SEQ_HELPER
 	bool "enable XDP helper bpf_update_tcp_seq"
-	default n
+	default y
 	help
 	  Enable ebpf helper to allows XDP synchronize the TCP socket status.
 	  This helper will update socket status directly only with minimal
