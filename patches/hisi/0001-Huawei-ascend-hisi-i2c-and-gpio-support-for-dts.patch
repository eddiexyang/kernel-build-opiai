From b2c5301ad0c65d4dd5615c8ab979cfb40d3798d6 Mon Sep 17 00:00:00 2001
From: huawei <huawei@huawei.com>
Date: Wed, 7 Dec 2022 23:33:32 +0800
Subject: [PATCH] Huawei ascend hisi i2c and gpio support for dts

---
 drivers/gpio/gpio-hisi.c      | 9 +++++++++
 drivers/i2c/busses/i2c-hisi.c | 9 +++++++++
 2 files changed, 18 insertions(+)
 mode change 100644 => 100755 drivers/i2c/busses/i2c-hisi.c

diff --git a/drivers/gpio/gpio-hisi.c b/drivers/gpio/gpio-hisi.c
index 1ba2e4252..15cbf2610 100755
--- a/drivers/gpio/gpio-hisi.c
+++ b/drivers/gpio/gpio-hisi.c
@@ -222,6 +222,14 @@ static const struct acpi_device_id hisi_gpio_acpi_match[] = {
 };
 MODULE_DEVICE_TABLE(acpi, hisi_gpio_acpi_match);
 
+static const struct of_device_id hisi_gpio_dts_match[] = {
+    {
+        .compatible = "hisilicon,ascend910-gpio",
+    },
+    {}
+};
+MODULE_DEVICE_TABLE(of, hisi_gpio_dts_match);
+
 static void hisi_gpio_get_pdata(struct device *dev,
 				struct hisi_gpio *hisi_gpio)
 {
@@ -353,6 +361,7 @@ static struct platform_driver hisi_gpio_driver = {
 	.driver		= {
 		.name	= HISI_GPIO_DRIVER_NAME,
 		.acpi_match_table = hisi_gpio_acpi_match,
+		.of_match_table = hisi_gpio_dts_match,
 	},
 	.probe		= hisi_gpio_probe,
 };
diff --git a/drivers/i2c/busses/i2c-hisi.c b/drivers/i2c/busses/i2c-hisi.c
old mode 100644
new mode 100755
index 5f17fe52f..c2421946b
--- a/drivers/i2c/busses/i2c-hisi.c
+++ b/drivers/i2c/busses/i2c-hisi.c
@@ -495,11 +495,20 @@ static const struct acpi_device_id hisi_i2c_acpi_ids[] = {
 };
 MODULE_DEVICE_TABLE(acpi, hisi_i2c_acpi_ids);
 
+static const struct of_device_id hisi_i2c_dts_ids[] = {
+    {
+        .compatible = "hisilicon,ascend910-i2c",
+    },
+    {}
+};
+MODULE_DEVICE_TABLE(of, hisi_i2c_dts_ids);
+
 static struct platform_driver hisi_i2c_driver = {
 	.probe		= hisi_i2c_probe,
 	.driver		= {
 		.name	= "hisi-i2c",
 		.acpi_match_table = hisi_i2c_acpi_ids,
+		.of_match_table = hisi_i2c_dts_ids,
 	},
 };
 module_platform_driver(hisi_i2c_driver);
-- 
