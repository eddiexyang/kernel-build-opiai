 drivers/infiniband/hw/hns/hns_roce_bond.h     | 100 +++
 drivers/infiniband/hw/hns/hns_roce_cmd.c      |  10 +
 drivers/infiniband/hw/hns/hns_roce_cmd.h      |   4 +
 drivers/infiniband/hw/hns/hns_roce_cq.c       |  36 +-
 drivers/infiniband/hw/hns/hns_roce_device.h   | 271 +++++++-
 drivers/infiniband/hw/hns/hns_roce_hem.c      |  82 ++-
 drivers/infiniband/hw/hns/hns_roce_hw_v2.c    | 541 ++++++++++++++--
 drivers/infiniband/hw/hns/hns_roce_hw_v2.h    | 179 +++++-
 .../infiniband/hw/hns/hns_roce_hw_v2_dfx.c    |   3 +-
 drivers/infiniband/hw/hns/hns_roce_main.c     |  68 +-
