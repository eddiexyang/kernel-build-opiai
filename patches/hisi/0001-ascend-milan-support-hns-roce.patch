+static void config_llm_to_dma_mem(struct hns_roce_buf *data_buf, void *cfg_buf)
+{
+	__le64 *entry = cfg_buf;
+	u32 i;
+
+	for (i = 0; i < data_buf->npages; i++)
+		entry[i] = cpu_to_le64(gen_llm_entry_val(data_buf, i));
+}
