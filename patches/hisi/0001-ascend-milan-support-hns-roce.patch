diff --git a/drivers/infiniband/hw/hns/Makefile b/drivers/infiniband/hw/hns/Makefile
index 9f04f25..d06de11 100644
--- a/drivers/infiniband/hw/hns/Makefile
+++ b/drivers/infiniband/hw/hns/Makefile
@@ -3,13 +3,20 @@
 # Makefile for the Hisilicon RoCE drivers.
 #
 
+EXTRA_CFLAGS += -DROCE_AI_CUSTOM_SUPPORT
+EXTRA_CFLAGS += -DMIRROR_MEMORY_SUPPORT
+EXTRA_CFLAGS += -DSUPPORT_PEER_MR
+EXTRA_CFLAGS += -DROCE_BONDING
+
 ccflags-y :=  -I $(srctree)/drivers/net/ethernet/hisilicon/hns3
+ccflags-y +=  -I $(srctree)/drivers/net/ethernet/hisilicon/hns3/hns3pf
+ccflags-y +=  -I $(srctree)/drivers/net/ethernet/hisilicon/hns3/hns3_common
+ccflags-y +=  -I $(srctree)/drivers/infiniband/hw/hns
 
 hns-roce-objs := hns_roce_main.o hns_roce_cmd.o hns_roce_pd.o \
 	hns_roce_ah.o hns_roce_hem.o hns_roce_mr.o hns_roce_qp.o \
+	hns_roce_bond.o hns_roce_peer_mem.o \
 	hns_roce_cq.o hns_roce_alloc.o hns_roce_db.o hns_roce_srq.o hns_roce_restrack.o
 
-ifdef CONFIG_INFINIBAND_HNS_HIP08
 hns-roce-hw-v2-objs := hns_roce_hw_v2.o hns_roce_hw_v2_dfx.o $(hns-roce-objs)
-obj-$(CONFIG_INFINIBAND_HNS) += hns-roce-hw-v2.o
-endif
+obj-$(CONFIG_INFINIBAND_HNS) += hns-roce-hw-v2.o
\ No newline at end of file
diff --git a/drivers/infiniband/hw/hns/hns_roce_alloc.c b/drivers/infiniband/hw/hns/hns_roce_alloc.c
index 1a9da5c..1847cc4 100644
--- a/drivers/infiniband/hw/hns/hns_roce_alloc.c
+++ b/drivers/infiniband/hw/hns/hns_roce_alloc.c
@@ -47,8 +47,13 @@ void hns_roce_buf_free(struct hns_roce_dev *hr_dev, struct hns_roce_buf *buf)
 	if (trunks) {
 		buf->trunk_list = NULL;
 		for (i = 0; i < buf->ntrunks; i++)
+#ifdef MIRROR_MEMORY_SUPPORT
+			hns_roce_dma_free_coherent(hr_dev->dev, 1 << buf->trunk_shift,
+									   trunks[i].buf, trunks[i].map);
+#else
 			dma_free_coherent(hr_dev->dev, 1 << buf->trunk_shift,
 					  trunks[i].buf, trunks[i].map);
+#endif
 
 		kfree(trunks);
 	}
@@ -77,7 +82,11 @@ struct hns_roce_buf *hns_roce_buf_alloc(struct hns_roce_dev *hr_dev, u32 size,
 		return ERR_PTR(-EINVAL);
 
 	gfp_flags = (flags & HNS_ROCE_BUF_NOSLEEP) ? GFP_ATOMIC : GFP_KERNEL;
+#ifdef MIRROR_MEMORY_SUPPORT
+	buf = hns_roce_mem_alloc(sizeof(*buf), KZALLOC, 0, gfp_flags);
+#else
 	buf = kzalloc(sizeof(*buf), gfp_flags);
+#endif
 	if (!buf)
 		return ERR_PTR(-ENOMEM);
 
@@ -93,7 +102,11 @@ struct hns_roce_buf *hns_roce_buf_alloc(struct hns_roce_dev *hr_dev, u32 size,
 		ntrunk = DIV_ROUND_UP(size, 1 << buf->trunk_shift);
 	}
 
+#ifdef MIRROR_MEMORY_SUPPORT
+	trunks = hns_roce_mem_alloc(sizeof(*trunks), KCALLOC, ntrunk, gfp_flags);
+#else
 	trunks = kcalloc(ntrunk, sizeof(*trunks), gfp_flags);
+#endif
 	if (!trunks) {
 		kfree(buf);
 		return ERR_PTR(-ENOMEM);
@@ -102,8 +115,13 @@ struct hns_roce_buf *hns_roce_buf_alloc(struct hns_roce_dev *hr_dev, u32 size,
 	trunk_size = 1 << buf->trunk_shift;
 	alloced_size = 0;
 	for (i = 0; i < ntrunk; i++) {
+#ifdef MIRROR_MEMORY_SUPPORT
+		trunks[i].buf = hns_roce_dma_alloc_coherent(hr_dev->dev, trunk_size,
+													&trunks[i].map, gfp_flags);
+#else
 		trunks[i].buf = dma_alloc_coherent(hr_dev->dev, trunk_size,
 						   &trunks[i].map, gfp_flags);
+#endif
 		if (!trunks[i].buf)
 			break;
 
@@ -115,8 +133,13 @@ struct hns_roce_buf *hns_roce_buf_alloc(struct hns_roce_dev *hr_dev, u32 size,
 	/* In nofail mode, it's only failed when the alloced size is 0 */
 	if ((flags & HNS_ROCE_BUF_NOFAIL) ? i == 0 : i != ntrunk) {
 		for (i = 0; i < buf->ntrunks; i++)
+#ifdef MIRROR_MEMORY_SUPPORT
+			hns_roce_dma_free_coherent(hr_dev->dev, trunk_size,
+									   trunks[i].buf, trunks[i].map);
+#else
 			dma_free_coherent(hr_dev->dev, trunk_size,
 					  trunks[i].buf, trunks[i].map);
+#endif
 
 		kfree(trunks);
 		kfree(buf);
diff --git a/drivers/infiniband/hw/hns/hns_roce_bond.c b/drivers/infiniband/hw/hns/hns_roce_bond.c
new file mode 100755
index 0000000..2ec8779
--- /dev/null
+++ b/drivers/infiniband/hw/hns/hns_roce_bond.c
@@ -0,0 +1,601 @@
+#ifdef ROCE_BONDING
+#include "hnae3.h"
+#include "hns_roce_common.h"
+#include "hns_roce_device.h"
+#include "hns_roce_bond.h"
+#include "hns_roce_hw_v2.h"
+#include "hclge_main.h"
+#include <linux/pci.h>
+
+struct roce_env_info g_roce_env_info = {0};
+int g_bond_slave_cnt = 2;
+int g_bond0_slave = 0x3;
+int g_bond1_slave = 0xc;
+static DEFINE_MUTEX(roce_intf_mutex);
+
+static int hns_roce_get_chip_id(struct hns_roce_dev *hr_dev, u8 *chip_id)
+{
+#define HNS3_CAE_GET_CHIP_MAC_ID_CMD	0x7003
+	struct hns_roce_cmq_desc desc[3];
+	int ret;
+	int i;
+
+	if (hr_dev == NULL)
+		return -EINVAL;
+	for (i = 0; i < 3; i++)
+		hns_roce_cmq_setup_basic_desc(&desc[i], HNS3_CAE_GET_CHIP_MAC_ID_CMD, true);
+	ret = hns_roce_cmq_send(hr_dev, desc, 3);
+	if (ret) {
+		dev_err(hr_dev->dev, "Get chip id failed %d.\n",
+			ret);
+		return ret;
+	}
+	*chip_id = (u8)desc[0].data[0];
+	dev_info(hr_dev->dev, "Chip id is %d.\n", *chip_id);
+
+	return 0;
+}
+
+static struct roce_bond_group* hns_roce_get_bond_group(struct pci_dev *pdev)
+{
+	struct roce_bond_group *bond_grp = NULL;
+	int chip_idx;
+	int bond_idx;
+	int func_idx;
+
+	for (chip_idx = 0; chip_idx < g_roce_env_info.chip_cnt; chip_idx++) {
+		for (bond_idx = 0; bond_idx < ROCE_BOND_GROUP_MAX; bond_idx++) {
+			bond_grp = &g_roce_env_info.single_chip_info[chip_idx].bond_group_info[bond_idx];
+			if (!bond_grp->bond_func_num)
+				continue;
+
+			hns_roce_bond_for_each_func(func_idx, 0, bond_grp) {
+				if (((pdev->bus->number << 8) | pdev->devfn) == bond_grp->bond_func_info[func_idx]->bdf)
+					return bond_grp;
+			}
+		}
+	}
+
+	return NULL;
+}
+
+bool hns_roce_bond_is_active(struct pci_dev *pdev)
+{
+	struct roce_bond_group *bond_grp = NULL;
+	bool ret = false;
+
+	mutex_lock(&g_roce_env_info.env_info_mutex);
+	bond_grp = hns_roce_get_bond_group(pdev);
+
+	ret = bond_grp && (bond_grp->flags & ROCE_BOND_FLAG);
+	mutex_unlock(&g_roce_env_info.env_info_mutex);
+
+	return ret;
+}
+
+struct net_device *hns_roce_get_bond_netdev(struct hns_roce_dev *hr_dev)
+{
+	struct roce_bond_group *bond_grp = NULL;
+	struct net_device *net_dev = NULL;
+	int func_idx;
+
+	mutex_lock(&g_roce_env_info.env_info_mutex);
+	bond_grp = hns_roce_get_bond_group(hr_dev->pci_dev);
+	if (!bond_grp || !(bond_grp->flags & ROCE_BOND_FLAG))
+		goto out;
+
+	if (bond_grp->bgrp_tracker.tx_type == NETDEV_LAG_TX_TYPE_ACTIVEBACKUP) {
+		hns_roce_bond_for_each_func(func_idx, 0, bond_grp) {
+			if (bond_grp->bgrp_tracker.ndev_state[func_idx].tx_enabled == true) {
+				net_dev = bond_grp->bond_func_info[func_idx]->ndev;
+				break;
+			}
+		}
+	} else {
+		hns_roce_bond_for_each_func(func_idx, 0, bond_grp) {
+			net_dev = bond_grp->bond_func_info[func_idx]->ndev;
+			break;
+		}
+		hns_roce_bond_for_each_func(func_idx, 0, bond_grp) {
+			if (get_port_state(bond_grp->bond_func_info[func_idx]->ndev) == IB_PORT_ACTIVE) {
+				net_dev = bond_grp->bond_func_info[func_idx]->ndev;
+				break;
+			}
+		}
+	}
+
+	if (net_dev)
+		dev_hold(net_dev);
+
+out:
+	mutex_unlock(&g_roce_env_info.env_info_mutex);
+
+	return net_dev;
+}
+
+static void hns_roce_queue_bond_work(struct roce_bond_group *bgrp, unsigned long delay)
+{
+	schedule_delayed_work(&bgrp->bond_work, delay);
+}
+
+static bool hns_roce_bond_get_active_port(struct roce_bond_group *bgrp, struct roce_bgrp_tracker *bond_tracker)
+{
+	u32 alive_slave_mask = 0;
+	u8 alive_slave_cnt = 0;
+	bool ret = true;
+	int func_idx;
+	bool alive;
+
+	hns_roce_bond_for_each_func(func_idx, 0, bgrp) {
+		alive = (bond_tracker->tx_type == NETDEV_LAG_TX_TYPE_ACTIVEBACKUP) ?
+			bond_tracker->ndev_state[func_idx].tx_enabled :
+			bond_tracker->ndev_state[func_idx].link_up;
+		if (alive) {
+			alive_slave_cnt++;
+			alive_slave_mask |= (1 << (unsigned int)func_idx);
+		}
+	}
+
+	if (bgrp->active_slave_mask == alive_slave_mask)
+		ret = false;
+
+	bgrp->active_slave_cnt = alive_slave_cnt;
+	bgrp->active_slave_mask = alive_slave_mask;
+
+	return ret;
+}
+
+static void hns_roce_set_bond_info(struct hns_roce_dev *hr_dev, struct roce_bond_group *bgrp)
+{
+	struct hns_roce_cmq_desc desc;
+	struct hns_roce_bond_info *slave_info = (struct hns_roce_bond_info *)desc.data;
+	int ret;
+
+	if (hr_dev == NULL)
+		return;
+	hns_roce_cmq_setup_basic_desc(&desc, HNS_ROCE_OPC_SET_BOND_INFO, false);
+	slave_info->trunk_id = bgrp->bond_id;
+	if (bgrp->bgrp_tracker.tx_type == NETDEV_LAG_TX_TYPE_ACTIVEBACKUP)
+		slave_info->bond_mode = BOND_MODE_1;
+	else {
+		slave_info->bond_mode = BOND_MODE_2_4;
+		slave_info->hash_policy = bgrp->bond->params.xmit_policy;
+	}
+	if (slave_info->bond_mode == BOND_MODE_1 && bgrp->active_slave_cnt != 1)
+		dev_err(hr_dev->dev, "Slave cnt(%d) is error.\n", bgrp->active_slave_cnt);
+	slave_info->active_slave_cnt = bgrp->active_slave_cnt;
+	slave_info->active_slave_mask = bgrp->active_slave_mask;
+	slave_info->slave_mask = bgrp->bond_func_map;
+
+	ret = hns_roce_cmq_send(hr_dev, &desc, 1);
+	if (ret)
+		dev_err(hr_dev->dev, "Set bond info failed, ret - %d.\n", ret);
+}
+
+static void hns_roce_change_active_slave(struct hns_roce_dev *hr_dev, struct roce_bond_group *bgrp)
+{
+	struct hns_roce_cmq_desc desc;
+	struct hns_roce_bond_info *slave_info = (struct hns_roce_bond_info *)desc.data;
+	int ret;
+
+	if (hr_dev == NULL)
+		return;
+	hns_roce_cmq_setup_basic_desc(&desc, HNS_ROCE_OPC_CHANGE_ACTIVE_PORT, false);
+	slave_info->trunk_id = bgrp->bond_id;
+	if (bgrp->bgrp_tracker.tx_type == NETDEV_LAG_TX_TYPE_ACTIVEBACKUP)
+		slave_info->bond_mode = BOND_MODE_1;
+	else
+		slave_info->bond_mode = BOND_MODE_2_4;
+	if (slave_info->bond_mode == BOND_MODE_1 && bgrp->active_slave_cnt != 1)
+		dev_err(hr_dev->dev, "Slave cnt(%d) is invalid.\n", bgrp->active_slave_cnt);
+	slave_info->active_slave_cnt = bgrp->active_slave_cnt;
+	slave_info->active_slave_mask = bgrp->active_slave_mask;
+	slave_info->slave_mask = bgrp->bond_func_map;
+
+	ret = hns_roce_cmq_send(hr_dev, &desc, 1);
+	if (ret)
+		dev_err(hr_dev->dev, "Change active slave failed, ret - %d.\n", ret);
+}
+
+static void hns_roce_clear_bond_info(struct hns_roce_dev *hr_dev, struct roce_bond_group *bgrp)
+{
+	struct hns_roce_cmq_desc desc;
+	struct hns_roce_bond_info *slave_info = (struct hns_roce_bond_info *)desc.data;
+	int ret;
+
+	if (hr_dev == NULL)
+		return;
+	hns_roce_cmq_setup_basic_desc(&desc, HNS_ROCE_OPC_CLEAR_BOND_INFO, false);
+	slave_info->trunk_id = bgrp->bond_id;
+
+	ret = hns_roce_cmq_send(hr_dev, &desc, 1);
+	if (ret)
+		dev_err(hr_dev->dev, "Clear bond info failed, ret - %d.\n", ret);
+}
+
+static void hns_roce_do_bond(struct roce_bond_group *bgrp)
+{
+	struct roce_bgrp_tracker bond_tracker = {0};
+	struct hnae3_client *client;
+	struct hclge_dev *hdev;
+	int func_idx;
+	bool do_bond;
+	bool ret;
+
+	if (bgrp->bond_func_num != g_bond_slave_cnt) {
+		pr_err("[ROCE BOND]bond_func_num(%d) is not valid.\n", bgrp->bond_func_num);
+		return;
+	}
+	mutex_lock(&bgrp->bond_update_mutex);
+	bond_tracker = bgrp->bgrp_tracker;
+	mutex_unlock(&bgrp->bond_update_mutex);
+
+	do_bond = bond_tracker.is_bonded;
+	pr_info("[ROCE BOND]do_bond - %d, bond_flags - %d.\n", do_bond, bgrp->flags);
+	if (do_bond && !(bgrp->flags & ROCE_BOND_FLAG)) {
+		hns_roce_bond_for_each_func(func_idx, 0, bgrp) {
+			hdev = bgrp->bond_func_info[func_idx]->ae_dev->priv;
+			client = hdev->roce_client;
+			client->ops->uninit_instance(bgrp->bond_func_info[func_idx]->ae_handle, 0);
+			bgrp->bond_func_info[func_idx]->hr_dev = NULL;
+		}
+		bgrp->flags |= ROCE_BOND_FLAG;
+		hns_roce_bond_for_each_func(func_idx, 0, bgrp) {
+			hdev = bgrp->bond_func_info[func_idx]->ae_dev->priv;
+			client = hdev->roce_client;
+			client->ops->init_instance(bgrp->bond_func_info[func_idx]->ae_handle);
+			break;
+		}
+		hns_roce_bond_get_active_port(bgrp, &bond_tracker);
+		hns_roce_set_bond_info(bgrp->bond_func_info[0]->hr_dev, bgrp);
+	} else if (do_bond && (bgrp->flags & ROCE_BOND_FLAG)) {
+		ret = hns_roce_bond_get_active_port(bgrp, &bond_tracker);
+		pr_info("[ROCE BOND]active slave count - %d, slave mask - %d.\n",
+			bgrp->active_slave_cnt, bgrp->active_slave_mask);
+		if (ret)
+			hns_roce_change_active_slave(bgrp->bond_func_info[0]->hr_dev, bgrp);
+	} else if (!do_bond && (bgrp->flags & ROCE_BOND_FLAG)) {
+		hns_roce_bond_for_each_func(func_idx, 0, bgrp) {
+			hdev = bgrp->bond_func_info[func_idx]->ae_dev->priv;
+			client = hdev->roce_client;
+			client->ops->uninit_instance(bgrp->bond_func_info[func_idx]->ae_handle, 0);
+			bgrp->bond_func_info[func_idx]->hr_dev = NULL;
+			break;
+		}
+		bgrp->flags &= ~ROCE_BOND_FLAG;
+		hns_roce_bond_for_each_func(func_idx, 0, bgrp) {
+			hdev = bgrp->bond_func_info[func_idx]->ae_dev->priv;
+			client = hdev->roce_client;
+			client->ops->init_instance(bgrp->bond_func_info[func_idx]->ae_handle);
+		}
+		hns_roce_clear_bond_info(bgrp->bond_func_info[0]->hr_dev, bgrp);
+	}
+
+	return;
+}
+
+void hns_roce_do_bond_work(struct work_struct *work)
+{
+	struct delayed_work *delayed_work = to_delayed_work(work);
+	struct roce_bond_group *bgrp = container_of(delayed_work, struct roce_bond_group, bond_work);
+	int status;
+
+	status = mutex_trylock(&roce_intf_mutex);
+	if (!status) {
+		/* delay 1 sec */
+		hns_roce_queue_bond_work(bgrp, HZ);
+		return;
+	}
+
+	hns_roce_do_bond(bgrp);
+	mutex_unlock(&roce_intf_mutex);
+}
+
+static int hns_roce_bond_bgrp_init(struct roce_bond_group *bgrp, int idx, int chip_id)
+{
+	int ret;
+	int i;
+
+	bgrp->bond_id = idx;
+	bgrp->bond_func_map = 0;
+	for (i = 0; i < ROCE_BOND_FUNC_MAX; i++) {
+		bgrp->bond_func_info[i] = NULL;
+	}
+
+	mutex_init(&(bgrp->bond_update_mutex));
+	INIT_DELAYED_WORK(&(bgrp->bond_work), hns_roce_do_bond_work);
+
+	bgrp->bond_nb.notifier_call = hns_roce_bond_event;
+	ret = register_netdevice_notifier(&bgrp->bond_nb);
+	if (ret) {
+		pr_err("[ROCE BOND]Failed to register notifier for bond_group(%u) of chip(%u).\n",
+			bgrp->bond_id, chip_id);
+		bgrp->bond_nb.notifier_call = NULL;
+		return ret;
+	}
+
+	return ret;
+}
+
+static void hns_roce_bond_get_group_idx(struct hns_roce_dev *hr_dev, int *bond_group_idx, int func_idx)
+{
+	if ((unsigned int)g_bond0_slave & 1 << (unsigned int)func_idx)
+		*bond_group_idx = 0;
+	else if ((unsigned int)g_bond1_slave & 1 << (unsigned int)func_idx)
+		*bond_group_idx = 1;
+}
+
+static int hns_roce_bond_register_func(struct hns_roce_dev *hr_dev, int chip_id)
+{
+	/*
+	*	1 -- assign hr_dev to proper single_chip_info[chip_id].single_func_info[func_idx]
+	*	2 -- relate single_func_info[func_idx] to proper bond_group_info[bond_group_idx]
+	*	3 -- if the first func added to bond_group, init group shall update group stat
+	*/
+	struct roce_chip_info *chip_info = &g_roce_env_info.single_chip_info[chip_id];
+	struct hns_roce_v2_priv *priv = (struct hns_roce_v2_priv *)hr_dev->priv;
+	struct roce_bond_group *bgrp_info;
+	int func_idx = hr_dev->pci_dev->devfn;
+	int bond_group_idx = -1;
+	int ret;
+
+	//TODO: Encapsulate as a function
+	chip_info->single_func_info[func_idx].hr_dev = hr_dev;
+	chip_info->single_func_info[func_idx].ae_dev = pci_get_drvdata(hr_dev->pci_dev);
+	chip_info->single_func_info[func_idx].ae_handle = priv->handle;
+	chip_info->single_func_info[func_idx].ndev = hr_dev->iboe.netdevs[0];
+	chip_info->single_func_info[func_idx].pdev = hr_dev->pci_dev;
+	chip_info->single_func_info[func_idx].bdf = (hr_dev->pci_dev->bus->number << 8) | (hr_dev->pci_dev->devfn);
+
+	hns_roce_bond_get_group_idx(hr_dev, &bond_group_idx, func_idx);
+	if (bond_group_idx < 0) {
+		dev_err(hr_dev->dev, "Get bond group index failed.\n");
+		return -EINVAL;
+	} else
+		dev_info(hr_dev->dev, "Get bond group index(%d) success.\n", bond_group_idx);
+
+	mutex_lock(&g_roce_env_info.env_info_mutex);
+	bgrp_info = &(chip_info->bond_group_info[bond_group_idx]);
+
+	if (!bgrp_info->bond_func_num) {
+		dev_info(hr_dev->dev, "Add first function to bond group(%d).\n", bond_group_idx);
+		ret = hns_roce_bond_bgrp_init(bgrp_info, bond_group_idx, chip_id);
+		if (ret) {
+			dev_err(hr_dev->dev, "Init bond group failed, ret = %d.\n", ret);
+			mutex_unlock(&g_roce_env_info.env_info_mutex);
+			return ret;
+		}
+	}
+
+	bgrp_info->bond_func_info[func_idx] = &(chip_info->single_func_info[func_idx]);
+	if (!(bgrp_info->bond_func_map & (1 << func_idx))) {
+		bgrp_info->bond_func_map |= 1 << func_idx;
+		bgrp_info->bond_func_num++;
+		chip_info->func_cnt++;
+	}
+
+	dev_info(hr_dev->dev, "Bond group func cnt is %d, chip func cnt is %d.\n",
+		 bgrp_info->bond_func_num, chip_info->func_cnt);
+	chip_info->func_is_bonded[func_idx] = 1;//TODO: This parameter is not used currently.
+
+	mutex_unlock(&g_roce_env_info.env_info_mutex);
+
+	return 0;
+}
+
+static void hns_roce_bond_chiport_layout(int chip_id)
+{
+	//assume 2*100G
+	g_roce_env_info.single_chip_info[chip_id].func_exp = ROCE_BOND_2_PORT_NUM;
+	g_roce_env_info.single_chip_info[chip_id].cur_hca_type = ROCE_BOND_100G_PORT_SPEED;
+
+	return;
+}
+
+int roce_bond_info_prepare(struct hns_roce_dev *hr_dev)
+{
+	u8 chip_id = 0;
+	int ret;
+
+	if (!g_roce_env_info.mutex_init_flag) {
+		mutex_init(&g_roce_env_info.env_info_mutex);
+		g_roce_env_info.mutex_init_flag = true;
+	}
+
+	ret = hns_roce_get_chip_id(hr_dev, &chip_id);
+	if (ret)
+		return ret;
+
+	hns_roce_bond_chiport_layout(chip_id);
+	ret = hns_roce_bond_register_func(hr_dev, chip_id);
+	if (ret)
+		return ret;
+
+	mutex_lock(&g_roce_env_info.env_info_mutex);
+	if (!g_roce_env_info.single_chip_info[chip_id].chip_init_flag) {
+		g_roce_env_info.chip_cnt++;
+		g_roce_env_info.chip_map |= 1 << (unsigned int)chip_id;
+		g_roce_env_info.single_chip_info[chip_id].chip_init_flag = true;
+	}
+	mutex_unlock(&g_roce_env_info.env_info_mutex);
+
+	return ret;
+}
+
+static void single_chip_clear(int chip_id)
+{
+	struct roce_chip_info* chip_info;
+	int group_id;
+
+	chip_info = &(g_roce_env_info.single_chip_info[chip_id]);
+	for (group_id = 0; group_id < ROCE_BOND_GROUP_MAX; group_id++) {
+		if (chip_info->bond_group_info[group_id].bond_func_num) {
+			unregister_netdevice_notifier(&chip_info->bond_group_info[group_id].bond_nb);
+			cancel_delayed_work_sync(&chip_info->bond_group_info[group_id].bond_work);
+		}
+	}
+}
+
+void hns_roce_bond_clear_all(void)
+{
+	int chip_id;
+
+	mutex_lock(&g_roce_env_info.env_info_mutex);
+	for (chip_id = 0; chip_id < g_roce_env_info.chip_cnt; chip_id++)
+		single_chip_clear(chip_id);
+
+	mutex_unlock(&g_roce_env_info.env_info_mutex);
+}
+
+int hns_roce_get_func_idx(struct net_device *net_dev, struct roce_bond_group *bgrp)
+{
+	int func_idx;
+
+	for (func_idx = 0; func_idx < bgrp->bond_func_num; func_idx++) {
+		if (!(bgrp->bond_func_map & (1 << func_idx)))
+			continue;
+		if (bgrp->bond_func_info[func_idx]->ndev == net_dev)
+			return func_idx;
+	}
+
+	return -EINVAL;
+}
+
+int hns_roce_bond_handle_lowerstate_event(struct roce_bond_group *bgrp, struct roce_bgrp_tracker *tracker,
+					  struct netdev_notifier_changelowerstate_info *info)
+{
+	struct netdev_lag_lower_state_info *bond_lower_info = NULL;
+	struct net_device *net_dev = netdev_notifier_info_to_dev((struct netdev_notifier_info *)info);
+	int func_idx;
+
+	if (!netif_is_lag_port(net_dev))
+		return false;
+
+	bond_lower_info = info->lower_state_info;
+	if (bond_lower_info == NULL)
+		return false;
+
+	func_idx = hns_roce_get_func_idx(net_dev, bgrp);
+	if (func_idx < 0)
+		return false;
+
+	bond_lower_info = info->lower_state_info;
+	if (bond_lower_info == NULL)
+		return false;
+
+	tracker->ndev_state[func_idx] = *bond_lower_info;
+
+	return true;
+}
+
+static int hns_roce_ndev_grp_idx(struct roce_bond_group *bgrp, struct net_device *ndev)
+{
+	int idx;
+
+	for (idx = 0; idx < ROCE_BOND_FUNC_MAX; idx++) {
+		if (bgrp->bond_func_info[idx] == NULL)
+			continue;
+
+		if (bgrp->bond_func_info[idx]->ndev == ndev)
+			return idx;
+	}
+
+	return -EINVAL;
+}
+
+static inline bool hns_roce_bond_mode_is_supported(enum netdev_lag_tx_type tx_type)
+{
+	if (tx_type != NETDEV_LAG_TX_TYPE_ACTIVEBACKUP && tx_type != NETDEV_LAG_TX_TYPE_HASH)
+		return false;
+	return true;
+}
+
+static bool hns_roce_bond_handle_upper_event(struct roce_bond_group *bgrp, struct roce_bgrp_tracker *tracker,
+					struct netdev_notifier_changeupper_info *info)
+{
+	struct netdev_lag_upper_info *bond_upper_info = NULL;
+	struct net_device *upper_netdev = NULL;
+	struct net_device *netdev = NULL;
+	u32 bond_status = 0;
+	int num_slaves = 0;
+	int func_idx = 0;
+	bool bond_ready;
+
+	upper_netdev = info->upper_dev;
+	if (upper_netdev == NULL)
+		return false;
+
+	if (!netif_is_lag_master(upper_netdev))
+		return false;
+
+	if (info->linking)
+		bond_upper_info = info->upper_info;
+
+	rcu_read_lock();
+	for_each_netdev_in_bond_rcu(upper_netdev, netdev) {
+		func_idx = hns_roce_ndev_grp_idx(bgrp, netdev);
+		if (func_idx >= 0)
+			bond_status |= (1 << (unsigned int)func_idx);
+
+		num_slaves++;
+
+		bgrp->bond = netdev_priv(upper_netdev);
+	}
+	rcu_read_unlock();
+
+	if (bond_upper_info)
+		tracker->tx_type = bond_upper_info->tx_type;
+
+	bond_ready = (bgrp->bond_func_num == num_slaves) &&
+		     (bgrp->bond_func_map == bond_status) &&
+		     hns_roce_bond_mode_is_supported(tracker->tx_type);
+	if (tracker->is_bonded != bond_ready) {
+		tracker->is_bonded = bond_ready;
+		return true;
+	}
+
+	return false;
+}
+
+int hns_roce_bond_event(struct notifier_block *self,
+			unsigned long event, void *ptr)
+{
+	struct roce_bond_group *bgrp;
+	struct roce_bgrp_tracker tracker;
+	struct net_device *net_dev;
+	int changed = false;
+	int func_idx;
+
+	net_dev = netdev_notifier_info_to_dev(ptr);
+	bgrp = container_of(self, struct roce_bond_group, bond_nb);
+
+	if ((event != NETDEV_CHANGEUPPER) && (event != NETDEV_CHANGELOWERSTATE))
+		return NOTIFY_DONE;
+
+	func_idx = hns_roce_get_func_idx(net_dev, bgrp);
+	if (func_idx < 0)
+		return NOTIFY_DONE;
+
+	memset(&tracker, 0, sizeof(struct roce_bgrp_tracker));
+	tracker = bgrp->bgrp_tracker;
+
+	switch (event) {
+	case NETDEV_CHANGEUPPER:
+		changed = hns_roce_bond_handle_upper_event(bgrp, &tracker, ptr);
+		break;
+	case NETDEV_CHANGELOWERSTATE:
+		changed = hns_roce_bond_handle_lowerstate_event(bgrp, &tracker, ptr);
+		break;
+	}
+
+	mutex_lock(&g_roce_env_info.env_info_mutex);
+	bgrp->bgrp_tracker = tracker;
+	mutex_unlock(&g_roce_env_info.env_info_mutex);
+
+	if (changed)
+		hns_roce_queue_bond_work(bgrp, HZ);
+
+	return NOTIFY_DONE;
+}
+
+#endif
