+static void hns_roce_bbox_report(struct hns_roce_dev *hr_dev, u32 sub_id)
+{
+	hns_bbox_excep_report_fun hns_bbox_excep_report =
+	(hns_bbox_excep_report_fun)(uintptr_t)symbol_get(hns_bbox_excep_report);
+	hns_get_bbox_excepid_fun hns_get_bbox_excepid =
+	(hns_get_bbox_excepid_fun)(uintptr_t)symbol_get(hns_get_bbox_excepid);
+	struct ib_device *ibdev = &hr_dev->ib_dev;
+	u32 except_id;
+	u32 die_id;
+	int ret;
+
+	if (!hns_bbox_excep_report || !hns_get_bbox_excepid) {
+		ibdev_err(ibdev,
+			  "Fail to report, hns_bbox_excep_report:%pK or hns_get_bbox_excepid:%pK syms not found\n",
+			  hns_bbox_excep_report, hns_get_bbox_excepid);
+		return;
+	}
+
+	ret = hns_roce_get_die_id(hr_dev, &die_id);
+	if (ret != 0) {
+		ibdev_err(ibdev, "Fail to report, get die_id err ret:%d\n", ret);
+		return;
+	}
+
+	ret = hns_get_bbox_excepid(HNS_BBOX_FUNC_ROCE, sub_id, &except_id);
+	if (ret != 0) {
+		ibdev_err(ibdev, "Fail to report, get except_id err ret:%d\n", ret);
+		return;
+	}
+
+	hns_bbox_excep_report(die_id, except_id);
+}
