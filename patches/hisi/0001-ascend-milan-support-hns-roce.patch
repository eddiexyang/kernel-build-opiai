+static u64 gen_llm_entry_val(struct hns_roce_buf *data_buf, u32 curr_ptr)
+{
+	dma_addr_t addr;
+	u32 next_ptr;
+
+	addr = hns_roce_buf_page(data_buf, curr_ptr);
+
+	if (curr_ptr == (data_buf->npages - 1))
+		next_ptr = 0;
+	else
+		next_ptr = curr_ptr + 1;
+
+	return HNS_ROCE_EXT_LLM_ENTRY(addr, (u64)next_ptr);
