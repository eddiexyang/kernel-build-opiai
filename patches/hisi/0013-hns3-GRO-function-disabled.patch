From a60dae096bfdd1cc5571e0a1cb160ccfe989683c Mon Sep 17 00:00:00 2001
Date: Mon, 7 Aug 2023 16:42:05 +0800
Subject: [PATCH] hns3-GRO-function-disabled

---
 .../net/ethernet/hisilicon/hns3/hns3_common/hclge_comm_cmd.c | 5 +----
 drivers/net/ethernet/hisilicon/hns3/hns3_enet.c              | 4 ----
 2 files changed, 1 insertion(+), 8 deletions(-)

diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3_common/hclge_comm_cmd.c b/drivers/net/ethernet/hisilicon/hns3/hns3_common/hclge_comm_cmd.c
index d00890f..b89a4c2 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3_common/hclge_comm_cmd.c
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3_common/hclge_comm_cmd.c
@@ -57,10 +57,7 @@ static void hclge_comm_set_default_capability(struct hnae3_ae_dev *ae_dev,
 	struct hclge_dev *hdev = ae_dev->priv;
 
 	set_bit(HNAE3_DEV_SUPPORT_FD_B, ae_dev->caps);
-	if (!(hdev->hw.mac.speed == HCLGE_FW_MAC_SPEED_400G &&
-	      hdev->strip_fcs_ts == HCLGE_STRIP_RX_MAC_FCS_TS_EN)) {
-		set_bit(HNAE3_DEV_SUPPORT_GRO_B, ae_dev->caps);
-	}
+
 	if (is_pf && ae_dev->dev_version == HNAE3_DEVICE_VERSION_V2) {
 		set_bit(HNAE3_DEV_SUPPORT_FEC_B, ae_dev->caps);
 		set_bit(HNAE3_DEV_SUPPORT_PAUSE_B, ae_dev->caps);
diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3_enet.c b/drivers/net/ethernet/hisilicon/hns3/hns3_enet.c
index 30c8113..77d4be8 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3_enet.c
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3_enet.c
@@ -2502,10 +2502,6 @@ static int hns3_nic_set_features(struct net_device *netdev,
 	if (h->ae_algo->ops->get_ksettings_an_result)
 		h->ae_algo->ops->get_ksettings_an_result(h, NULL, &speed, NULL, &strip_fcs_ts);
 
-	if (!(speed == HNS3_FW_MAC_SPEED_400G &&
-	      strip_fcs_ts == HNS3_STRIP_RX_MAC_FCS_TS_EN))
-		set_bit(HNAE3_DEV_SUPPORT_GRO_B, ae_dev->caps);
-
 	if (changed & (NETIF_F_GRO_HW) && h->ae_algo->ops->set_gro_en &&
 	    test_bit(HNAE3_DEV_SUPPORT_GRO_B, ae_dev->caps)) {
 		enable = !!(features & NETIF_F_GRO_HW);
-- 
2.27.0

