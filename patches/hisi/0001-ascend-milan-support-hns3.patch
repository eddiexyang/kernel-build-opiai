diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3_common/hclge_comm_cmd.c b/drivers/net/ethernet/hisilicon/hns3/hns3_common/hclge_comm_cmd.c
index c8b151d..d00890f 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3_common/hclge_comm_cmd.c
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3_common/hclge_comm_cmd.c
@@ -2,6 +2,8 @@
 // Copyright (c) 2021-2021 Hisilicon Limited.
 
 #include "hnae3.h"
+#include "hclge_cmd.h"
+#include "hclge_main.h"
 #include "hclge_comm_cmd.h"
 
 static void hclge_comm_cmd_config_regs(struct hclge_comm_hw *hw,
@@ -52,8 +54,13 @@ void hclge_comm_cmd_reuse_desc(struct hclge_desc *desc, bool is_read)
 static void hclge_comm_set_default_capability(struct hnae3_ae_dev *ae_dev,
 					      bool is_pf)
 {
+	struct hclge_dev *hdev = ae_dev->priv;
+
 	set_bit(HNAE3_DEV_SUPPORT_FD_B, ae_dev->caps);
-	set_bit(HNAE3_DEV_SUPPORT_GRO_B, ae_dev->caps);
+	if (!(hdev->hw.mac.speed == HCLGE_FW_MAC_SPEED_400G &&
+	      hdev->strip_fcs_ts == HCLGE_STRIP_RX_MAC_FCS_TS_EN)) {
+		set_bit(HNAE3_DEV_SUPPORT_GRO_B, ae_dev->caps);
+	}
 	if (is_pf && ae_dev->dev_version == HNAE3_DEVICE_VERSION_V2) {
 		set_bit(HNAE3_DEV_SUPPORT_FEC_B, ae_dev->caps);
 		set_bit(HNAE3_DEV_SUPPORT_PAUSE_B, ae_dev->caps);
@@ -64,6 +71,11 @@ void hclge_comm_cmd_setup_basic_desc(struct hclge_desc *desc,
 				     enum hclge_opcode_type opcode,
 				     bool is_read)
 {
+	if (!desc) {
+		pr_err("hclge: %s param error! desc is null.\n", __func__);
+		return;
