 	int (*get_vf_config)(struct hnae3_handle *handle, int vf,
 			     struct ifla_vf_info *ivf);
 	int (*set_vf_link_state)(struct hnae3_handle *handle, int vf,
@@ -718,6 +778,7 @@ struct hnae3_ae_ops {
 	int (*get_module_eeprom)(struct hnae3_handle *handle, u32 offset,
 				 u32 len, u8 *data);
 	bool (*get_cmdq_stat)(struct hnae3_handle *handle);
+	bool (*mqprio_active)(struct hnae3_handle *handle);
 	int (*add_cls_flower)(struct hnae3_handle *handle,
 			      struct flow_cls_offload *cls_flower, int tc);
 	int (*del_cls_flower)(struct hnae3_handle *handle,
@@ -733,9 +794,12 @@ struct hnae3_ae_ops {
 			    u32 nsec, u32 sec);
 	int (*get_ts_info)(struct hnae3_handle *handle,
 			   struct ethtool_ts_info *info);
+	void (*dump_ptp_info)(struct hnae3_handle *handle, char *buf, int len);
 	int (*get_link_diagnosis_info)(struct hnae3_handle *handle,
 				       u32 *status_code);
 	void (*clean_vf_config)(struct hnae3_ae_dev *ae_dev, int num_vfs);
+	void (*get_device_info)(const struct hnae3_handle *handle,
+				u32 *board_id, u32 *device_id, u32 *chip_id, u32 *die_id);
 };
 
 struct hnae3_dcb_ops {
@@ -773,6 +837,8 @@ struct hnae3_tc_info {
 	bool mqprio_active;
 };
 
+#define HNAE3_MAX_USER_TOS  64
+
 struct hnae3_knic_private_info {
 	struct net_device *netdev; /* Set by KNIC client when init instance */
 	u16 rss_size;		   /* Allocated RSS queues */
@@ -809,11 +875,31 @@ struct hnae3_roce_private_info {
 	unsigned long state;
 };
 
+struct hnae3_roh_private_info {
+	struct net_device *netdev;
+	void __iomem *roh_io_base;
+	int base_vector;
+	unsigned long reset_state;
+	unsigned long instance_state;
+	unsigned long state;
+};
+
+struct hnae3_unic_private_info {
+	struct net_device *netdev;
+	u16 rx_buf_len;
+	u16 num_tx_desc;
+	u16 num_rx_desc;
+
+	u16 num_tqps;	/* total number of tqps in this handle */
+	struct hnae3_queue **tqp;	/* array base of all TQPs of this instance */
+};
+
 #define HNAE3_SUPPORT_APP_LOOPBACK    BIT(0)
 #define HNAE3_SUPPORT_PHY_LOOPBACK    BIT(1)
 #define HNAE3_SUPPORT_SERDES_SERIAL_LOOPBACK	BIT(2)
 #define HNAE3_SUPPORT_VF	      BIT(3)
 #define HNAE3_SUPPORT_SERDES_PARALLEL_LOOPBACK	BIT(4)
+#define HNAE3_SUPPORT_PLATFORM_DEV	BIT(5)
 
 #define HNAE3_USER_UPE		BIT(0)	/* unicast promisc enabled by user */
 #define HNAE3_USER_MPE		BIT(1)	/* mulitcast promisc enabled by user */
@@ -831,6 +917,7 @@ enum hnae3_pflag {
 
 struct hnae3_handle {
 	struct hnae3_client *client;
