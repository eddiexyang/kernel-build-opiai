+void hclge_sync_time_task(struct work_struct *work)
+{
+#define SYNC_TIME (60 * HZ) // 60second
+#define SYNC_STOP_FLAG 0
+#define SYNC_SET_FLAG 1
+#define HCLGE_NS_PER_US 1000
+	struct hclge_dev *hdev =
+		container_of(work, struct hclge_dev, sync_time_task.work);
+	unsigned long delta = round_jiffies_relative(HZ);
+	const long long time_base = UNIX_TIME_BASE;
+	struct hclge_sync_time_cmd *req = NULL;
+	const int max_sec = 60;
+	struct hclge_desc desc;
+	struct timespec64 kts;
+	int ret;
+
+	if (test_bit(HCLGE_STATE_SYNC_HANDLING, &hdev->state))
+		return;
+
+	set_bit(HCLGE_STATE_SYNC_HANDLING, &hdev->state);
+
+	if (hdev->sync_time_flag == 0) {
+		hclge_cmd_setup_basic_desc(&desc, HCLGE_OPC_SYNC_FW_TIME, 0);
+		req = (struct hclge_sync_time_cmd *)desc.data;
+
+		req->flag = cpu_to_le32((u32)SYNC_STOP_FLAG);
+		ret = hclge_cmd_send(&hdev->hw, &desc, 1);
+		if (ret) {
+			dev_err(&hdev->pdev->dev, "stop firmware time failed %d.\n", ret);
+			goto out;
+		}
+
+		delta = round_jiffies_relative(HZ);
+		hdev->sync_time_flag = 1;
+	} else {
+		ktime_get_real_ts64(&kts);
+		if (kts.tv_sec <= time_base || !sys_tz.tz_minuteswest)
+			goto out;
+
+		hclge_cmd_setup_basic_desc(&desc, HCLGE_OPC_SYNC_FW_TIME, 0);
+		req = (struct hclge_sync_time_cmd *)desc.data;
+
+		kts.tv_sec -= (long)sys_tz.tz_minuteswest * max_sec;
+		req->tv_sec = cpu_to_le64(kts.tv_sec);		/* seconds */
+		req->tv_usec = cpu_to_le64((kts.tv_nsec / HCLGE_NS_PER_US));	/* microseconds */
+		req->flag = cpu_to_le32((u32)SYNC_SET_FLAG);
+
+		dev_info(&hdev->pdev->dev, "hclge sync time to firmware, tv_sec:%ld, tv_nsec:%ld, tz_minuteswest:%d\n",
+			 kts.tv_sec, kts.tv_nsec, sys_tz.tz_minuteswest);
+
+		ret = hclge_cmd_send(&hdev->hw, &desc, 1);
+		if (ret) {
+			dev_err(&hdev->pdev->dev, "sync time to firmware failed %d.\n", ret);
+			goto out;
+		}
+
+		delta = round_jiffies_relative(SYNC_TIME);
+		hdev->sync_time_flag = 0;
+	}
+
+out:
+	clear_bit(HCLGE_STATE_SYNC_HANDLING, &hdev->state);
+
+	hclge_sync_time_task_schedule(hdev, delta);
+}
