+static struct sdhci_pltfm_data sdhci_zodiac_pdata = {
+    // sdhci_pltfm_data OR use sdhci_pltfm_ops as default
+    .ops = &sdhci_zodiac_ops,
+    .quirks = SDHCI_QUIRK_CAP_CLOCK_BASE_BROKEN | SDHCI_QUIRK_BROKEN_TIMEOUT_VAL | SDHCI_QUIRK_INVERTED_WRITE_PROTECT |
+    SDHCI_QUIRK_MULTIBLOCK_READ_ACMD12,
