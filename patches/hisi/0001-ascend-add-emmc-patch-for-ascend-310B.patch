+static void sdhci_zodiac_hardware_reset(struct sdhci_host *host)
+{
+    struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
+    struct sdhci_zodiac_host *zodiac_host = sdhci_pltfm_priv(pltfm_host);
+    if (zodiac_host->host_mode == ZODIAC_EMMC_MODE) {
+        (void)hisi_subctrl_emmc_reset_assert(zodiac_host->dev, zodiac_host->host_id);
+        (void)hisi_subctrl_emmc_phy_reset_assert(zodiac_host->dev, zodiac_host->host_id);
+    } else {
+        (void)hisi_subctrl_sd_reset_assert(zodiac_host->dev, zodiac_host->host_id);
+    }
+}
+
+static int sdhci_zodiac_hardware_disreset(struct sdhci_host *host)
+{
+    struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
+    struct sdhci_zodiac_host *zodiac_host = sdhci_pltfm_priv(pltfm_host);
+    int ret;
+
+    if (zodiac_host->host_mode == ZODIAC_EMMC_MODE) {
+        (void)hisi_subctrl_emmc_reset_deassert(zodiac_host->dev, zodiac_host->host_id);
+        ret = hisi_subctrl_emmc_get_reset_status(zodiac_host->dev, zodiac_host->host_id);
+        if (ret != 0) {
+            dev_err(zodiac_host->dev, "mmc is not deassert status, status=%d\n", ret);
+            return ret;
+        }
+
+        (void)hisi_subctrl_emmc_phy_reset_deassert(zodiac_host->dev, zodiac_host->host_id);
+        ret = hisi_subctrl_emmc_phy_get_reset_status(zodiac_host->dev, zodiac_host->host_id);
+        if (ret != 0) {
+            dev_err(zodiac_host->dev, "mmc phy is not deassert status, status=%d\n", ret);
+            return ret;
+        }
+    } else {
+        (void)hisi_subctrl_sd_reset_deassert(zodiac_host->dev, zodiac_host->host_id);
+        ret = hisi_subctrl_sd_get_reset_status(zodiac_host->dev, zodiac_host->host_id);
+        if (ret != 0) {
+            dev_err(zodiac_host->dev, "mmc is not deassert status, status=%d\n", ret);
+            return ret;
+        }
+    }
+    return 0;
+}
+
+static int sdhci_zodiac_icg_en(struct sdhci_host *host)
+{
+    struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
+    struct sdhci_zodiac_host *zodiac_host = sdhci_pltfm_priv(pltfm_host);
+
+    if (zodiac_host->host_mode == ZODIAC_EMMC_MODE) {
+        (void)hisi_subctrl_emmc_clkgate_enable(zodiac_host->dev, zodiac_host->host_id);
+        udelay(100); // 100us
+        if (!hisi_subctrl_emmc_clkgate_is_enabled(zodiac_host->dev, zodiac_host->host_id)) {
+            dev_err(zodiac_host->dev, "mmc_clkgate not enabled\n");
+            return -1;
+        }
+
+        (void)hisi_subctrl_emmc_phy_clkgate_enable(zodiac_host->dev, zodiac_host->host_id);
+        udelay(100); // 100us
+        if (!hisi_subctrl_emmc_phy_clkgate_is_enabled(zodiac_host->dev, zodiac_host->host_id)) {
+            dev_err(zodiac_host->dev, "mmc phy clkgate not enabled\n");
+            return -1;
+        }
+    } else {
+        (void)hisi_subctrl_sd_clkgate_enable(zodiac_host->dev, zodiac_host->host_id);
+        udelay(100); // 100us
+        if (!hisi_subctrl_sd_clkgate_is_enabled(zodiac_host->dev, zodiac_host->host_id)) {
+            dev_err(zodiac_host->dev, "sd clkgate not enabled\n");
+            return -1;
+        }
+    }
+    return 0;
+}
