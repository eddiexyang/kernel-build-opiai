From 633f33cd90185e5e53d039f4b4f9c297343ff2f4 Mon Sep 17 00:00:00 2001
Date: Sat, 13 May 2023 14:38:51 +0800
Subject: [PATCH] [Huawei] ascend: sync time bug fix

Offering:ascend
Reference:NA
Type:requirement
DTS/AR:
---
 drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c
index 9a0fd17..6f91641 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c
@@ -12062,7 +12062,7 @@ void hclge_sync_time_task(struct work_struct *work)
 		hdev->sync_time_flag = 1;
 	} else {
 		ktime_get_real_ts64(&kts);
-		if (kts.tv_sec <= time_base || !sys_tz.tz_minuteswest)
+		if (kts.tv_sec <= time_base)
 			goto out;
 
 		hclge_cmd_setup_basic_desc(&desc, HCLGE_OPC_SYNC_FW_TIME, 0);
-- 
