From c47bc908b601c227b12f9aa8bc677422f72b0f20 Mon Sep 17 00:00:00 2001
Date: Sat, 16 Sep 2023 17:27:42 +0800
Subject: [PATCH] hns-dcqcn-debug

---
 drivers/infiniband/hw/hns/hns_roce_hem.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/infiniband/hw/hns/hns_roce_hem.c b/drivers/infiniband/hw/hns/hns_roce_hem.c
index 314ff9b..c5dc8f8 100644
--- a/drivers/infiniband/hw/hns/hns_roce_hem.c
+++ b/drivers/infiniband/hw/hns/hns_roce_hem.c
@@ -342,6 +342,8 @@ static struct hns_roce_hem *hns_roce_alloc_hem(struct hns_roce_dev *hr_dev,
 		if (!buf)
 			goto fail;
 
+		roce_modify_device_addr(hr_dev, sg_dma_address(mem));
+
 		chunk->buf[chunk->npages] = buf;
 		sg_dma_len(mem) = PAGE_SIZE << order;
 
@@ -366,7 +368,8 @@ void hns_roce_free_hem(struct hns_roce_dev *hr_dev, struct hns_roce_hem *hem)
 		return;
 
 	list_for_each_entry_safe(chunk, tmp, &hem->chunk_list, list) {
-		for (i = 0; i < chunk->npages; ++i)
+		for (i = 0; i < chunk->npages; ++i) {
+			roce_restore_device_addr(hr_dev, sg_dma_address(&chunk->mem[i]));
 #ifdef MIRROR_MEMORY_SUPPORT
 			hns_roce_dma_free_coherent(hr_dev->dev, sg_dma_len(&chunk->mem[i]),
 									   chunk->buf[i], sg_dma_address(&chunk->mem[i]));
@@ -376,6 +379,7 @@ void hns_roce_free_hem(struct hns_roce_dev *hr_dev, struct hns_roce_hem *hem)
 				   chunk->buf[i],
 				   sg_dma_address(&chunk->mem[i]));
 #endif
+		}
 		kfree(chunk);
 	}
 
-- 
2.27.0

