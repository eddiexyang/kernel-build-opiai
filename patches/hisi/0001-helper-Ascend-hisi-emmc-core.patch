+	if (mmc_can_sleep(host->card)) {
+		if (mmc_can_poweroff_notify(host->card) &&
+			((host->caps2 & MMC_CAP2_FULL_PWR_CYCLE &&
+			mmc_can_sleep_notify(host->card)) || !is_suspend)) {
+			err = mmc_poweroff_notify(host->card, notify_type);
+			if (err)
