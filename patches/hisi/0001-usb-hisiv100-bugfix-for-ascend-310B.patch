From 9994fc4b6cba34a3679bc70fc34f813f3eb178bf Mon Sep 17 00:00:00 2001
From: huawei <huawei@huawei.com>
Date: Wed, 22 Feb 2023 17:29:53 +0800
Subject: [PATCH] usb hisiv100 bugfix for Ascend310B

---
 drivers/usb/host/Kconfig     |  7 +++++++
 drivers/usb/host/xhci-hub.c  |  3 +++
 drivers/usb/host/xhci-mem.c  | 40 ++++++++++++++++++++++++++++++++++++
 drivers/usb/host/xhci-ring.c | 25 +++++++++++++++++++---
 4 files changed, 72 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/host/Kconfig b/drivers/usb/host/Kconfig
index ab12c4bf0..de37b4fd4 100644
--- a/drivers/usb/host/Kconfig
+++ b/drivers/usb/host/Kconfig
@@ -763,6 +763,13 @@ config USB_HCD_BCMA
 
 	  If unsure, say N.
 
+config USB_HIUSBCV100_PATCH
+	bool "use HIUSBCV100 drop packet patch"
+	default n
+	help
+	  Enable patch for hiusbc3xv100 drop packet bug when connectting to a hub
+	  with int/isoc device in fs/ls speed.
+
 config USB_HCD_SSB
 	tristate "SSB usb host driver"
 	depends on SSB
diff --git a/drivers/usb/host/xhci-hub.c b/drivers/usb/host/xhci-hub.c
index 7bb306741..a053ffe6b 100644
--- a/drivers/usb/host/xhci-hub.c
+++ b/drivers/usb/host/xhci-hub.c
@@ -971,6 +971,9 @@ static void xhci_get_usb3_port_status(struct xhci_port *port, u32 *status,
 	/* remote wake resume signaling complete */
 	if (bus_state->port_remote_wakeup & (1 << portnum) &&
 	    link_state != XDEV_RESUME &&
+#ifdef CONFIG_USB_HIUSBCV100_PATCH
+	    link_state != XDEV_U3 &&
+#endif
 	    link_state != XDEV_RECOVERY) {
 		bus_state->port_remote_wakeup &= ~(1 << portnum);
 		usb_hcd_end_port_resume(&hcd->self, portnum);
diff --git a/drivers/usb/host/xhci-mem.c b/drivers/usb/host/xhci-mem.c
index dabc7b670..2470b9bd0 100644
--- a/drivers/usb/host/xhci-mem.c
+++ b/drivers/usb/host/xhci-mem.c
@@ -1295,6 +1295,11 @@ static unsigned int xhci_parse_microframe_interval(struct usb_device *udev,
 static unsigned int xhci_parse_frame_interval(struct usb_device *udev,
 		struct usb_host_endpoint *ep)
 {
+#ifdef CONFIG_USB_HIUSBCV100_PATCH
+	if ((udev->tt && udev->tt->hub->parent) && (usb_endpoint_xfer_int(&ep->desc)))
+		return xhci_microframes_to_exponent(udev, ep,
+				ep->desc.bInterval * 8, 7, 10); // min_exponent to 7 (16ms).
+#endif
 	return xhci_microframes_to_exponent(udev, ep,
 			ep->desc.bInterval * 8, 3, 10);
 }
@@ -1517,7 +1522,42 @@ int xhci_endpoint_init(struct xhci_hcd *xhci,
 
 	virt_dev->eps[ep_index].skip = false;
 	ep_ring = virt_dev->eps[ep_index].new_ring;
+#ifdef CONFIG_USB_HIUSBCV100_PATCH
+	if (udev->tt && udev->tt->hub->parent) {
+		if (usb_endpoint_xfer_isoc(&ep->desc)) {
+			if (usb_endpoint_dir_out(&ep->desc)) {
+				xhci_dbg(xhci, "WARN: ep %u(isoc out), from mesit=%u, maxp=%u\n",
+						usb_endpoint_num(&ep->desc), max_esit_payload, max_packet);
+				max_esit_payload = ((max_esit_payload + 191) / 192) * 192;
+			} else {
+				xhci_dbg(xhci, "WARN: ep %u(isoc in), from mesit=%u, maxp=%u\n",
+						usb_endpoint_num(&ep->desc), max_esit_payload, max_packet);
+				if (max_esit_payload <= 192)
+					max_esit_payload = 192 + 175;
+				else if (max_esit_payload <= 384)
+					max_esit_payload = 384 + 171;
+				else if (max_esit_payload <= 576)
+					max_esit_payload = 576 + 167;
+			}
+			max_packet = max_esit_payload;
+			xhci_dbg(xhci, "to mesit=%u, maxp=%u!\n", max_esit_payload, max_packet);
+		}
 
+		if ((usb_endpoint_xfer_int(&ep->desc)) && (usb_endpoint_dir_in(&ep->desc))) {
+			xhci_dbg(xhci, "WARN: ep %u(int in), from mesit=%u, maxp=%u\n",
+					usb_endpoint_num(&ep->desc), max_esit_payload, max_packet);
+			if ((udev->speed == USB_SPEED_FULL) && (max_esit_payload <= 350)) {
+				max_esit_payload = 350;
+				max_packet = 64;
+			}
+			if ((udev->speed == USB_SPEED_LOW) && (max_esit_payload <= 9)) {
+				max_esit_payload = 9;
+				max_packet = 8;
+			}
+			xhci_dbg(xhci, "to mesit=%u, maxp=%u!\n", max_esit_payload, max_packet);
+		}
+	}
+#endif
 	/* Fill the endpoint context */
 	ep_ctx->ep_info = cpu_to_le32(EP_MAX_ESIT_PAYLOAD_HI(max_esit_payload) |
 				      EP_INTERVAL(interval) |
diff --git a/drivers/usb/host/xhci-ring.c b/drivers/usb/host/xhci-ring.c
index fa3a7ac15..c0e4f94f6 100644
--- a/drivers/usb/host/xhci-ring.c
+++ b/drivers/usb/host/xhci-ring.c
@@ -1488,11 +1488,14 @@ static void handle_cmd_completion(struct xhci_hcd *xhci,
 
 	cmd_dequeue_dma = xhci_trb_virt_to_dma(xhci->cmd_ring->deq_seg,
 			cmd_trb);
+
+	cmd_comp_code = GET_COMP_CODE(le32_to_cpu(event->status));
 	/*
 	 * Check whether the completion event is for our internal kept
 	 * command.
 	 */
-	if (!cmd_dequeue_dma || cmd_dma != (u64)cmd_dequeue_dma) {
+	if (!cmd_dequeue_dma || ((cmd_dma != (u64)cmd_dequeue_dma) &&
+		(cmd_comp_code != COMP_COMMAND_RING_STOPPED))) {
 		xhci_warn(xhci,
 			  "ERROR mismatched command completion event\n");
 		return;
@@ -1502,8 +1505,6 @@ static void handle_cmd_completion(struct xhci_hcd *xhci,
 
 	cancel_delayed_work(&xhci->cmd_timer);
 
-	cmd_comp_code = GET_COMP_CODE(le32_to_cpu(event->status));
-
 	/* If CMD ring stopped we own the trbs between enqueue and dequeue */
 	if (cmd_comp_code == COMP_COMMAND_RING_STOPPED) {
 		complete_all(&xhci->cmd_ring_stop_completion);
@@ -1525,6 +1526,7 @@ static void handle_cmd_completion(struct xhci_hcd *xhci,
 	if (cmd_comp_code == COMP_COMMAND_ABORTED) {
 		xhci->cmd_ring_state = CMD_RING_STATE_STOPPED;
 		if (cmd->status == COMP_COMMAND_ABORTED) {
+			trb_to_noop(cmd->command_trb, TRB_CMD_NOOP);
 			if (xhci->current_cmd == cmd)
 				xhci->current_cmd = NULL;
 			goto event_handled;
@@ -2530,7 +2532,24 @@ static int handle_tx_event(struct xhci_hcd *xhci,
 	case COMP_BABBLE_DETECTED_ERROR:
 		xhci_dbg(xhci, "Babble error for slot %u ep %u on endpoint\n",
 			 slot_id, ep_index);
+#ifdef CONFIG_USB_HIUSBCV100_PATCH
+		td = list_first_entry(&ep_ring->td_list, struct xhci_td,
+				      td_list);
+
+		/* Is this an Int/Isoc EP in a LS/FS device under an external HS hub? */
+		if (td->urb->dev->tt &&
+			td->urb->dev->tt->hub->parent &&
+			(usb_endpoint_xfer_int(&td->urb->ep->desc) ||
+			usb_endpoint_xfer_isoc(&td->urb->ep->desc))) {
+			xhci_dbg(xhci, "HIUSBC: Ignore Babble error for slot %u ep %u on endpoint\n",
+				 slot_id, ep_index);
+			status = 0;
+		} else {
+			status = -EOVERFLOW;
+		}
+#else
 		status = -EOVERFLOW;
+#endif
 		break;
 	/* Completion codes for endpoint error state */
 	case COMP_TRB_ERROR:
-- 
2.17.1

