From 07d7fbece2d120b531b3ef22204df486258b42e3 Mon Sep 17 00:00:00 2001
Subject: [PATCH]     [Huawei] hns add bw_limit print

---
 .../hisilicon/hns3/hns3pf/hclge_cmd.h         |  2 +-
 .../hisilicon/hns3/hns3pf/hclge_main.c        | 23 +++++++++----------
 2 files changed, 12 insertions(+), 13 deletions(-)

diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_cmd.h b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_cmd.h
index 8a064ef..9fd9536 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_cmd.h
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_cmd.h
@@ -353,7 +353,7 @@ struct hclge_config_auto_neg_cmd {
 
 struct hclge_sfp_info_cmd {
 	__le32 speed;
-	u8 query_type; /* 0: sfp speed, 1: active speed */
+	u8 query_type; /* 0: xsfp auto_adapt speed, 1: active speed */
 	u8 active_fec;
 	u8 autoneg; /* autoneg state */
 	u8 autoneg_ability; /* whether support autoneg */
diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c
index 580dac9..fb73648 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c
@@ -3337,8 +3337,6 @@ static int hclge_get_sfp_info(struct hclge_dev *hdev, struct hclge_mac *mac)
 	hclge_cmd_setup_basic_desc(&desc, HCLGE_OPC_GET_SFP_INFO, true);
 	resp = (struct hclge_sfp_info_cmd *)desc.data;
 
-	resp->query_type = QUERY_ACTIVE_SPEED;
-
 	ret = hclge_cmd_send(&hdev->hw, &desc, 1);
 	if (ret == -EOPNOTSUPP) {
 		dev_warn(&hdev->pdev->dev,
@@ -3349,6 +3347,7 @@ static int hclge_get_sfp_info(struct hclge_dev *hdev, struct hclge_mac *mac)
 		return ret;
 	}
 
+	mac->speed_type = le32_to_cpu(resp->query_type);
 	/* In some case, mac speed get from IMP may be 0, it shouldn't be
 	 * set to mac->speed.
 	 */
@@ -3364,13 +3363,10 @@ static int hclge_get_sfp_info(struct hclge_dev *hdev, struct hclge_mac *mac)
 		mac->speed_ability = le32_to_cpu(resp->speed_ability);
 		mac->autoneg = resp->autoneg;
 		mac->support_autoneg = resp->autoneg_ability;
-		mac->speed_type = QUERY_ACTIVE_SPEED;
 		if (!resp->active_fec)
 			mac->fec_mode = 0;
 		else
 			mac->fec_mode = BIT(resp->active_fec);
-	} else {
-		mac->speed_type = QUERY_SFP_SPEED;
 	}
 
 	return 0;
@@ -3530,6 +3526,9 @@ static int hclge_update_port_info(struct hclge_dev *hdev)
 	if (hdev->ae_dev->dev_version >= HNAE3_DEVICE_VERSION_V2) {
 		speed = mac->speed;
 		ret = hclge_get_sfp_info(hdev, mac);
+		if (mac->speed_type == QUERY_SFP_SPEED) {
+			ret = hclge_get_sfp_speed(hdev, &speed);
+		}
 	} else {
 		speed = HCLGE_MAC_SPEED_UNKNOWN;
 		ret = hclge_get_sfp_speed(hdev, &speed);
@@ -3549,15 +3548,15 @@ static int hclge_update_port_info(struct hclge_dev *hdev)
 				(void)hclge_tm_port_shaper_cfg(hdev);
 			return 0;
 		}
-		return hclge_cfg_mac_speed_dup(hdev, mac->speed,
-					       HCLGE_MAC_FULL);
-	} else {
-		if (speed == HCLGE_MAC_SPEED_UNKNOWN)
-			return 0; /* do nothing if no SFP */
 
-		/* must config full duplex for SFP */
-		return hclge_cfg_mac_speed_dup(hdev, speed, HCLGE_MAC_FULL);
+		hdev->tm_info.bw_limit = hdev->hw.mac.speed;
 	}
+
+	if (speed == HCLGE_MAC_SPEED_UNKNOWN)
+		return 0; /* do nothing if no SFP */
+
+	/* must config full duplex for SFP */
+	return hclge_cfg_mac_speed_dup(hdev, speed, HCLGE_MAC_FULL);
 }
 
 static int hclge_get_status(struct hnae3_handle *handle)
-- 
2.27.0

