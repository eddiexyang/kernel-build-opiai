From 08495f411afc479ed17f4d9eb6750608b1c78297 Mon Sep 17 00:00:00 2001
Subject: [PATCH]     [Huawei] hns del hns_numa_alloc

---
 drivers/infiniband/hw/hns/hns_roce_alloc.c  |  8 -----
 drivers/infiniband/hw/hns/hns_roce_cmd.c    |  4 ---
 drivers/infiniband/hw/hns/hns_roce_device.h |  8 -----
 drivers/infiniband/hw/hns/hns_roce_hem.c    | 33 ---------------------
 4 files changed, 53 deletions(-)

diff --git a/drivers/infiniband/hw/hns/hns_roce_alloc.c b/drivers/infiniband/hw/hns/hns_roce_alloc.c
index 1847cc4..94f7371 100644
--- a/drivers/infiniband/hw/hns/hns_roce_alloc.c
+++ b/drivers/infiniband/hw/hns/hns_roce_alloc.c
@@ -82,11 +82,7 @@ struct hns_roce_buf *hns_roce_buf_alloc(struct hns_roce_dev *hr_dev, u32 size,
 		return ERR_PTR(-EINVAL);
 
 	gfp_flags = (flags & HNS_ROCE_BUF_NOSLEEP) ? GFP_ATOMIC : GFP_KERNEL;
-#ifdef MIRROR_MEMORY_SUPPORT
-	buf = hns_roce_mem_alloc(sizeof(*buf), KZALLOC, 0, gfp_flags);
-#else
 	buf = kzalloc(sizeof(*buf), gfp_flags);
-#endif
 	if (!buf)
 		return ERR_PTR(-ENOMEM);
 
@@ -102,11 +98,7 @@ struct hns_roce_buf *hns_roce_buf_alloc(struct hns_roce_dev *hr_dev, u32 size,
 		ntrunk = DIV_ROUND_UP(size, 1 << buf->trunk_shift);
 	}
 
-#ifdef MIRROR_MEMORY_SUPPORT
-	trunks = hns_roce_mem_alloc(sizeof(*trunks), KCALLOC, ntrunk, gfp_flags);
-#else
 	trunks = kcalloc(ntrunk, sizeof(*trunks), gfp_flags);
-#endif
 	if (!trunks) {
 		kfree(buf);
 		return ERR_PTR(-ENOMEM);
diff --git a/drivers/infiniband/hw/hns/hns_roce_cmd.c b/drivers/infiniband/hw/hns/hns_roce_cmd.c
index bdd64e0..06d02bc 100644
--- a/drivers/infiniband/hw/hns/hns_roce_cmd.c
+++ b/drivers/infiniband/hw/hns/hns_roce_cmd.c
@@ -240,11 +240,7 @@ hns_roce_alloc_cmd_mailbox(struct hns_roce_dev *hr_dev)
 {
 	struct hns_roce_cmd_mailbox *mailbox;
 
-#ifdef MIRROR_MEMORY_SUPPORT
-	mailbox = hns_roce_mem_alloc(sizeof(*mailbox), KMALLOC, 0, GFP_KERNEL);
-#else
 	mailbox = kmalloc(sizeof(*mailbox), GFP_KERNEL);
-#endif
 	if (!mailbox)
 		return ERR_PTR(-ENOMEM);
 
diff --git a/drivers/infiniband/hw/hns/hns_roce_device.h b/drivers/infiniband/hw/hns/hns_roce_device.h
index 99f87bb..90461b1 100644
--- a/drivers/infiniband/hw/hns/hns_roce_device.h
+++ b/drivers/infiniband/hw/hns/hns_roce_device.h
@@ -1313,20 +1313,12 @@ static inline void hns_roce_inc_rdma_hw_stats(struct ib_device *dev, int stats)
 	} while (0)
 
 #ifdef MIRROR_MEMORY_SUPPORT
-typedef enum {
-    KMALLOC = 0,
-    KZALLOC,
-    KCALLOC,
-} ALLOC_TYPE;
-
-void *hns_roce_mem_alloc(size_t size, ALLOC_TYPE alloc_type, u32 num, gfp_t flags);
 void *hns_roce_dma_alloc_coherent(struct device *dev, size_t size,
 	dma_addr_t *dma_handle, gfp_t flags);
 void hns_roce_dma_free_coherent(struct device *dev, size_t size,
 	void *mem, dma_addr_t dma_addr);
 typedef void* (*hns3_numa_dma_alloc_coherent_fun)(struct device *dev, size_t size,
 	dma_addr_t *dma_handle, gfp_t flags);
-typedef void* (*hns3_numa_mem_alloc_fun)(size_t size, ALLOC_TYPE type, u32 num, gfp_t flags);
 typedef void (*hns3_numa_dma_free_coherent_fun)(struct device *dev, size_t size,
 	void *mem, dma_addr_t dma_addr);
 #endif
diff --git a/drivers/infiniband/hw/hns/hns_roce_hem.c b/drivers/infiniband/hw/hns/hns_roce_hem.c
index 2261708..314ff9b 100644
--- a/drivers/infiniband/hw/hns/hns_roce_hem.c
+++ b/drivers/infiniband/hw/hns/hns_roce_hem.c
@@ -46,26 +46,6 @@ struct hns_roce_hem_index {
 };
 
 #ifdef MIRROR_MEMORY_SUPPORT
-void *hns_roce_mem_alloc(size_t size, ALLOC_TYPE alloc_type, u32 num, gfp_t flags)
-{
-	hns3_numa_mem_alloc_fun hns3_numa_mem_alloc =
-		(hns3_numa_mem_alloc_fun)(uintptr_t)symbol_get(hns3_numa_mem_alloc);
-	void *addr = NULL;
-
-	if (hns3_numa_mem_alloc == NULL) {
-		pr_err("hns3: hns3_numa_mem_alloc is NULL!\n");
-		return NULL;
-	}
-
-	addr = hns3_numa_mem_alloc(size, alloc_type, num, flags);
-
-	if (hns3_numa_mem_alloc != NULL) {
-		symbol_put(hns3_numa_mem_alloc);
-	}
-
-	return addr;
-}
-
 void *hns_roce_dma_alloc_coherent(struct device *dev, size_t size,
 	dma_addr_t *dma_handle, gfp_t flags)
 {
@@ -321,12 +301,8 @@ static struct hns_roce_hem *hns_roce_alloc_hem(struct hns_roce_dev *hr_dev,
 	void *buf;
 
 	WARN_ON(gfp_mask & __GFP_HIGHMEM);
-#ifdef MIRROR_MEMORY_SUPPORT
-	hem = hns_roce_mem_alloc(sizeof(*hem), KMALLOC, 0, gfp_mask & ~(__GFP_HIGHMEM | __GFP_NOWARN));
-#else
 	hem = kmalloc(sizeof(*hem),
 		      gfp_mask & ~(__GFP_HIGHMEM | __GFP_NOWARN));
-#endif
 	if (!hem)
 		return NULL;
 
@@ -336,13 +312,8 @@ static struct hns_roce_hem *hns_roce_alloc_hem(struct hns_roce_dev *hr_dev,
 
 	while (npages > 0) {
 		if (!chunk) {
-#ifdef MIRROR_MEMORY_SUPPORT
-			chunk = hns_roce_mem_alloc(sizeof(*chunk), KMALLOC, 0,
-				gfp_mask & ~(__GFP_HIGHMEM | __GFP_NOWARN));
-#else
 			chunk = kmalloc(sizeof(*chunk),
 				gfp_mask & ~(__GFP_HIGHMEM | __GFP_NOWARN));
-#endif
 			if (!chunk)
 				goto fail;
 
@@ -1069,11 +1040,7 @@ hem_list_alloc_item(struct hns_roce_dev *hr_dev, int start, int end, int count,
 {
 	struct hns_roce_hem_item *hem;
 
-#ifdef MIRROR_MEMORY_SUPPORT
-	hem = hns_roce_mem_alloc(sizeof(*hem), KZALLOC, 0, GFP_KERNEL);
-#else
 	hem = kzalloc(sizeof(*hem), GFP_KERNEL);
-#endif
 	if (!hem)
 		return NULL;
 
