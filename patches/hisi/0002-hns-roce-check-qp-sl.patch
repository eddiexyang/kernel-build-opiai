From 29d13f102cab971e26114d0639ad551024a3e5c9 Mon Sep 17 00:00:00 2001
Date: Fri, 2 Jun 2023 21:11:08 +0800
Subject: [PATCH] [Huawei] hns roce check qp sl attr

---
 drivers/infiniband/hw/hns/hns_roce_qp.c | 43 +++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/drivers/infiniband/hw/hns/hns_roce_qp.c b/drivers/infiniband/hw/hns/hns_roce_qp.c
index 4594e24..c00d510 100644
--- a/drivers/infiniband/hw/hns/hns_roce_qp.c
+++ b/drivers/infiniband/hw/hns/hns_roce_qp.c
@@ -38,6 +38,7 @@
 #include "hns_roce_common.h"
 #include "hns_roce_device.h"
 #include "hns_roce_hem.h"
+#include "hclge_main.h"
 
 static void flush_work_handle(struct work_struct *work)
 {
@@ -1294,6 +1295,44 @@ static int check_mtu_validate(struct hns_roce_dev *hr_dev,
 	return 0;
 }
 
+static int check_qp_sl_attr(struct ib_qp *ibqp, struct ib_qp_attr *attr, int attr_mask)
+{
+	struct hns_roce_dev *hr_dev = to_hr_dev(ibqp->device);
+	struct hns_roce_qp *hr_qp = to_hr_qp(ibqp);
+	struct pci_dev *pdev = hr_dev->pci_dev;
+	struct hnae3_ae_dev *ae_dev = (struct hnae3_ae_dev *)pdev->dev.driver_data;
+	struct hclge_dev *hdev = ae_dev->priv;
+	u8 dscp = (attr->ah_attr.grh.traffic_class) >> DSCP_SHIFT;
+	u8 pfc_en = hdev->tm_info.pfc_en;
+	enum ib_qp_state new_state;
+	u8 sl = attr->ah_attr.sl;
+	u8 prio_to_tc;
+	u8 dscp_to_tc;
+
+	new_state = attr_mask & IB_QP_STATE ? attr->qp_state : hr_qp->state;
+	if (new_state != IB_QPS_RTR) {
+		return 0;
+	}
+
+	if (sl >= HNAE3_MAX_USER_PRIO || dscp >= HNAE3_MAX_USER_TOS) {
+		ibdev_warn(&hr_dev->ib_dev, "attr sl or dscp exceed limited.sl=%u, dscp=%u\n", sl, dscp);
+		return 0;
+	}
+
+	if (!((pfc_en >> sl) & 0x1)) {
+		ibdev_warn(&hr_dev->ib_dev, "attr sl respond pfc not enable.sl=%u, pfc_en=%u\n", sl, pfc_en);
+	}
+
+	prio_to_tc = hdev->tm_info.prio_tc[sl];
+	dscp_to_tc = hdev->tm_info.tos_tc[dscp];
+	if (prio_to_tc != dscp_to_tc) {
+		ibdev_warn(&hr_dev->ib_dev, "sl to tc not match dscp to tc.sl=%u, prio_to_tc=%u, dscp_to_tc:%u\n",
+			sl, prio_to_tc, dscp_to_tc);
+	}
+
+	return 0;
+}
+
 static int hns_roce_check_qp_attr(struct ib_qp *ibqp, struct ib_qp_attr *attr,
 				  int attr_mask)
 {
@@ -1334,6 +1373,10 @@ static int hns_roce_check_qp_attr(struct ib_qp *ibqp, struct ib_qp_attr *attr,
 		return -EINVAL;
 	}
 
+	if(check_qp_sl_attr(ibqp, attr, attr_mask)) {
+		return -EINVAL;
+	}
+
 	if (attr_mask & IB_QP_PATH_MTU)
 		return check_mtu_validate(hr_dev, hr_qp, attr, attr_mask);
 
-- 
2.27.0

