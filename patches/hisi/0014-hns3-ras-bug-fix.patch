From 2d92bb229026e3530807a3c11c6abb6526f1f3c4 Mon Sep 17 00:00:00 2001
Date: Wed, 16 Aug 2023 20:55:34 +0800
Subject: [PATCH] hns3 ras bug fix: add nic_disp and add recovery_event

---
 .../hisilicon/hns3/hns3pf/hclge_err.c         | 32 +++++++++++++++++--
 .../hisilicon/hns3/hns3pf/hclge_err.h         | 20 ++++++------
 2 files changed, 40 insertions(+), 12 deletions(-)

diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_err.c b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_err.c
index b704652..f07538e 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_err.c
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_err.c
@@ -1357,6 +1357,9 @@ static const struct hclge_hw_type_id hclge_hw_type_id_st[] = {
 	}, {
 		.type_id = DISP_DATA_RAM_SBECC,
 		.msg = "disp_data_ram_sbecc"
+	}, {
+		.type_id = DISP_COMMAND_RAM_SBECC,
+		.msg = "disp_command_ram_sbecc"
 	}, {
 		.type_id = DISP_NCDIR_SBECC,
 		.msg = "disp_ncdir_sbecc"
@@ -1364,8 +1367,11 @@ static const struct hclge_hw_type_id hclge_hw_type_id_st[] = {
 		.type_id = DISP_ERR_RSP_PORT,
 		.msg = "disp_err_rsp_port"
 	}, {
-		.type_id = DISP_ERR_REP,
-		.msg = "disp_err_rep"
+		.type_id = DISP_ERR_REQ,
+		.msg = "disp_err_req"
+	}, {
+		.type_id = DISP_ERR_WD,
+		.msg = "disp_err_wd"
 	}, {
 		.type_id = ROH_ERR,
 		.msg = "roh_error"
@@ -2811,13 +2817,30 @@ static void hclge_report_event(struct hclge_dev *hdev, u8 type_id, u8 dms_err_ty
 	}
 }
 
+static void hclge_report_recovery_event(struct hclge_dev *hdev, u8 type_id, u8 dms_err_type)
+{
+#define RAS_ERROR_TYPE_OFFSET 8
+	hclge_fault_report_recovery_excep_fun hclge_fault_report_recovery_excep =
+	(hclge_fault_report_recovery_excep_fun)(uintptr_t)symbol_get(hclge_fault_report_recovery_excep);
+
+	if (!hclge_fault_report_recovery_excep) {
+		dev_err(&hdev->pdev->dev, "Fail to report, hclge_fault_report_recovery_excep syms not found\n");
+		return;
+	}
+
+	hclge_fault_report_recovery_excep(hdev->device_id, ((u32)dms_err_type << RAS_ERROR_TYPE_OFFSET) | (u32)type_id);
+
+	symbol_put(hclge_fault_report_recovery_excep);
+}
+
 static void
 hclge_handle_error_type_reg_log(struct hclge_dev *hdev,
 				struct hclge_mod_err_info *mod_info,
 				struct hclge_type_reg_err_info *type_reg_info)
 {
-#define HCLGE_ERR_TYPE_MASK 0x7F
 #define HCLGE_ERR_TYPE_IS_RAS_OFFSET 7
+#define HCLGE_REPORT_INTERVAL 200
+#define HCLGE_ERR_TYPE_MASK 0x7F
 
 	u8 mod_id, total_module, type_id, dms_err_type, total_type, i, is_ras;
 	struct device *dev = &hdev->pdev->dev;
@@ -2854,6 +2877,9 @@ hclge_handle_error_type_reg_log(struct hclge_dev *hdev,
 			is_ras ? "ras" : "msix");
 
 		hclge_report_event(hdev, type_id, dms_err_type);
+		/* the interval cannot be less than DMS_SENSOR_SCAN_INTERVAL. */
+		msleep(HCLGE_REPORT_INTERVAL);
+		hclge_report_recovery_event(hdev, type_id, dms_err_type);
 	} else {
 		dev_err(dev,
 			"unknown module[%u] or type[%u].\n", mod_id, type_id);
diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_err.h b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_err.h
index 3fad84f..e4b4d1c 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_err.h
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_err.h
@@ -179,15 +179,16 @@ enum hclge_err_type_list {
 	ROCEE_OVF_ERR		= 41,
 	ROCEE_BUS_ERR		= 42,
 	/* add new ERROR TYPE for ROCEE here in order */
-    DISP_DATA_RAM_MBECC = 60,
-    DISP_COMMAND_RAM_MBECC = 61,
-    DISP_NCDIR_MBECC = 62,
-    DISP_DATA_RAM_SBECC = 63,
-    DISP_COMMAND_RAM_SBECC = 64,
-    DISP_NCDIR_SBECC = 65,
-    DISP_ERR_RSP_PORT = 66,
-    DISP_ERR_REP = 67,
-	ROH_ERR			= 80
+    DISP_DATA_RAM_MBECC		= 60,
+    DISP_COMMAND_RAM_MBECC	= 61,
+    DISP_NCDIR_MBECC		= 62,
+    DISP_DATA_RAM_SBECC		= 63,
+    DISP_COMMAND_RAM_SBECC	= 64,
+    DISP_NCDIR_SBECC	= 65,
+    DISP_ERR_RSP_PORT	= 66,
+    DISP_ERR_REQ		= 67,
+    DISP_ERR_WD			= 68,
+    ROH_ERR			= 80
 	/* add new ERROR TYPE for ROH here in order */
 };
 
@@ -245,4 +246,5 @@ int hclge_handle_hw_msix_error(struct hclge_dev *hdev,
 int hclge_handle_error_info_log(struct hnae3_ae_dev *ae_dev);
 int hclge_handle_mac_tnl(struct hclge_dev *hdev);
 typedef void (*hclge_fault_report_excep_fun)(u32 dev_id, u32 excep_id);
+typedef void (*hclge_fault_report_recovery_excep_fun)(u32 dev_id, u32 excep_id);
 #endif
-- 
2.27.0

