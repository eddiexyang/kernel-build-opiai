diff --git a/drivers/hisi/platform/hisi_pmic.h b/drivers/hisi/platform/hisi_pmic.h
new file mode 100755
index 000000000..354681adc
--- /dev/null
+++ b/drivers/hisi/platform/hisi_pmic.h
@@ -0,0 +1,101 @@
