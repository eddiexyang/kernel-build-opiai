+/*lint -save -e578*/
+int dw_mci_hs_get_dt_pltfm_resource(struct device_node  *of_node) /*lint !e578*/
+{
+/*lint -restore*/
+	if (of_device_is_compatible(of_node, "hisilicon,davinci-dw-mshc")) {
+		if(of_find_property(of_node, "cs_sd_timing_config", (int *)NULL)){
+			memcpy(hs_timing_config, hs_timing_config_kirin970_cs, sizeof(hs_timing_config));
+			printk(KERN_INFO"%s: boston_cs_sd_timing_config_cs is used for timing_config!\n", __func__);
+		}
+		else{
+			memcpy(hs_timing_config, hs_timing_config_kirin970, sizeof(hs_timing_config));
+			printk(KERN_INFO"%s: boston_cs_sd_timing_config is used for timing_config!\n", __func__);
+		}
+	} else {
+		printk(KERN_ERR"%s: no compatible platform resource found!\n", __func__);
+		return -1;
+	}
+
+	return 0;
+}
+
+int dw_mci_hs_get_resource(void)
+{
+	struct device_node *np = NULL;
+
+	np = of_find_compatible_node(NULL, NULL, "hisilicon,davinci-dw-mshc");
+	if (np == NULL) {
+		printk(KERN_ERR "can't find davinci-dw-mshc!\n");
+		return -EFAULT;
+	}
+
+	if (!peri_subctrl_base) {
+		peri_subctrl_base = of_iomap(np, MEM_PERI_SUBCTRL_IOBASE);
+		if (!peri_subctrl_base) {
+			printk(KERN_ERR "peri_subctrl_base iomap error!\n");
+			return -ENOMEM;
+		}
+	}
+
+	if (!sys_base) {
+		sys_base = of_iomap(np, MEM_SYSCTRL_IOBASE);
+		if (!sys_base) {
+			printk(KERN_ERR "sysctrl iomap error!\n");
+			iounmap(peri_subctrl_base);
+			return -ENOMEM;
+		}
+	}
+
+	return 0;
+}
