+extern void dw_mci_request_end(struct dw_mci *host, struct mmc_request *mrq);
+extern void dw_mci_stop_dma(struct dw_mci *host);
+
+#if (LINUX_VERSION_CODE <= KERNEL_VERSION(4, 1, 46))
+void dw_mci_timeout_timer(unsigned long data)
+{
+       struct dw_mci *host = (struct dw_mci *)data;
+#else
+void dw_mci_timeout_timer(struct timer_list *t)
+{
+	struct dw_mci *host = from_timer(host, t, timer);
+#endif
+	struct mmc_request *mrq;
+
+
+	if (host) {
+		spin_lock(&host->lock);
+		if (host->mrq) {
+			mrq = host->mrq;
+			dev_vdbg(host->dev, "time out host->mrq = %pK\n", host->mrq);
+
+			dev_warn(host->dev,
+				"Timeout waiting for hardware interrupt."
+				" state = %d\n", host->state);
+			dw_mci_reg_dump(host);
+
+			host->sg = NULL;
+			host->data = NULL;
+			host->cmd = NULL;
+
+			switch (host->state) {
+			case STATE_IDLE:
+				break;
+			case STATE_SENDING_CMD:
+				mrq->cmd->error = -ENOMEDIUM;
+				if (!mrq->data)
+					break;
+			/* fall through */
+			case STATE_SENDING_DATA:
+				mrq->data->error = -ENOMEDIUM;
+				dw_mci_stop_dma(host);
+				break;
+			case STATE_DATA_BUSY:
+			case STATE_DATA_ERROR:
+				if (mrq->data->error == -EINPROGRESS)/*lint !e650*/
+					mrq->data->error = -ENOMEDIUM;
+				/* fall through */
+			case STATE_SENDING_STOP:
+				if (mrq->stop)
+					mrq->stop->error = -ENOMEDIUM;
+				break;
+			}
+
+			host->sd_hw_timeout = 1;
+
+			dw_mci_fifo_reset(host->dev, host);
+			dw_mci_ciu_reset(host->dev, host);
+
+			dw_mci_request_end(host, mrq);
+		}
+		spin_unlock(&host->lock);
+	}
+}
