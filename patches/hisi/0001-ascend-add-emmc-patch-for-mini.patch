+static int hs_dwmmc_card_busy(struct dw_mci *host)
+{
+	if ((mci_readl(host, STATUS) & SDMMC_STATUS_BUSY) || host->cmd || host->data || host->mrq || (host->state != STATE_IDLE)) {
+		dev_vdbg(host->dev, " card is busy!");
+		return 1;
+	}
+
+	return 0;
+}
