+	res = platform_get_resource(pdev, IORESOURCE_MEM, MEM_PERI_SUBCTRL_IOBASE);
+	if (res == NULL) {
+		pr_err("get subctrl iobase resource error.\n");
+		return -ENOMEM;
+	}
+	if (!peri_subctrl_base) {
+		peri_subctrl_base = devm_ioremap_resource(&pdev->dev, res);
+		if (!peri_subctrl_base) {
+			pr_err("peri_subctrl_base iomap error!\n");
+			return -ENOMEM;
+		}
+	}
+
