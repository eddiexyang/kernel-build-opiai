From f07077c602cd5c6f2826b03348a700790e408fd6 Mon Sep 17 00:00:00 2001
Date: Wed, 26 Apr 2023 14:32:53 +0800
Subject: [PATCH] hns3 support link history & gPTP

---
 drivers/net/ethernet/hisilicon/hns3/hnae3.h   |  3 ++
 .../net/ethernet/hisilicon/hns3/hns3_enet.c   | 32 ++++++++++++++++++-
 .../hisilicon/hns3/hns3pf/hclge_main.c        |  4 +++
 .../hisilicon/hns3/hns3pf/hclge_main.h        |  1 +
 4 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/hisilicon/hns3/hnae3.h b/drivers/net/ethernet/hisilicon/hns3/hnae3.h
index c2ba0c2..f462250 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hnae3.h
+++ b/drivers/net/ethernet/hisilicon/hns3/hnae3.h
@@ -600,6 +600,8 @@ struct hnae3_ae_dev {
  *   Get phc info
  * clean_vf_config
  *   Clean residual vf info after disable sriov
+ * query_tstamp
+ *   query gPTP time stamp
  */
 struct hnae3_ae_ops {
 	int (*init_ae_dev)(struct hnae3_ae_dev *ae_dev);
@@ -800,6 +802,7 @@ struct hnae3_ae_ops {
 	void (*clean_vf_config)(struct hnae3_ae_dev *ae_dev, int num_vfs);
 	void (*get_device_info)(const struct hnae3_handle *handle,
 				u32 *board_id, u32 *device_id, u32 *chip_id, u32 *die_id);
+	void (*query_tstamp)(struct hnae3_handle *handle, struct timespec64 *kts);
 };
 
 struct hnae3_dcb_ops {
diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3_enet.c b/drivers/net/ethernet/hisilicon/hns3/hns3_enet.c
index f6a56e4..920d909 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3_enet.c
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3_enet.c
@@ -2353,9 +2353,14 @@ netdev_tx_t hns3_nic_net_xmit(struct sk_buff *skb, struct net_device *netdev)
 	struct hns3_nic_priv *priv = netdev_priv(netdev);
 	struct hns3_enet_ring *ring = &priv->ring[skb->queue_mapping];
 	struct hns3_desc_cb *desc_cb = &ring->desc_cb[ring->next_to_use];
+	struct hnae3_handle *handle = hns3_get_handle(netdev);
+	struct hnae3_ae_ops *ops = handle->ae_algo->ops;;
+	struct skb_shared_hwtstamps skb_hwtstamp;
 	struct netdev_queue *dev_queue;
+	struct timespec64 kts;
 	int pre_ntu, ret;
 	bool doorbell;
+	u64 ns;
 
 	/* Hardware can only handle short frames above 32 bytes */
 	if (skb_put_padto(skb, HNS3_MIN_TX_LEN)) {
@@ -2395,7 +2400,16 @@ netdev_tx_t hns3_nic_net_xmit(struct sk_buff *skb, struct net_device *netdev)
 				cpu_to_le16(BIT(HNS3_TXD_FE_B));
 	trace_hns3_tx_desc(ring, pre_ntu);
 
-	skb_tx_timestamp(skb);
+	if (ops->query_tstamp) {
+		if (skb_shinfo(skb)->tx_flags & SKBTX_SW_TSTAMP) {
+			ops->query_tstamp(handle, &kts);
+			ns = (u64)(kts.tv_sec * NSEC_PER_SEC + kts.tv_nsec);
+			skb_hwtstamp.hwtstamp = ns_to_ktime(ns);
+			skb_tstamp_tx(skb, &skb_hwtstamp);
+		}
+	} else {
+		skb_tx_timestamp(skb);
+	}
 
 	/* Complete translate all packets */
 	dev_queue = netdev_get_tx_queue(netdev, ring->queue_index);
@@ -4357,10 +4371,14 @@ static int hns3_handle_rx_bd(struct hns3_enet_ring *ring)
 {
 	struct sk_buff *skb = ring->skb;
 	struct hns3_desc_cb *desc_cb;
+	struct hnae3_handle *handle;
+	struct hnae3_ae_ops *ops;
 	struct hns3_desc *desc;
+	struct timespec64 kts;
 	unsigned int length;
 	u32 bd_base_info;
 	int ret;
+	u64 ns;
 
 	desc = &ring->desc[ring->next_to_clean];
 	desc_cb = &ring->desc_cb[ring->next_to_clean];
@@ -4425,6 +4443,18 @@ static int hns3_handle_rx_bd(struct hns3_enet_ring *ring)
 	}
 
 	skb_record_rx_queue(skb, ring->tqp->tqp_index);
+
+	handle = ring->tqp->handle;
+	ops = handle->ae_algo->ops;
+	if (ops->query_tstamp) {
+		/* gPTP Ethernet header type is ETH_P_1588, the 4th bit in messageType of event class message is 0 */
+		if (skb->protocol == htons(ETH_P_1588) && !(skb->data[0] & (1 << 3))) {
+			ops->query_tstamp(handle, &kts);
+			ns = (u64)(kts.tv_sec * NSEC_PER_SEC + kts.tv_nsec);
+			skb_hwtstamps(skb)->hwtstamp = ns_to_ktime(ns);
+		}
+	}
+
 	return 0;
 }
 
diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c
index bad0132..9a0fd17 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.c
@@ -3167,6 +3167,8 @@ static void hclge_push_link_status(struct hclge_dev *hdev)
 
 static void hclge_update_link_status(struct hclge_dev *hdev)
 {
+	struct hnae3_handle *custom_handle = &hdev->vport[0].custom;
+	struct hnae3_client *custom_client = hdev->custom_client;
 	struct hnae3_handle *rhandle = &hdev->vport[0].roce;
 	struct hnae3_handle *handle = &hdev->vport[0].nic;
 	struct hnae3_client *rclient = hdev->roce_client;
@@ -3193,6 +3195,8 @@ static void hclge_update_link_status(struct hclge_dev *hdev)
 		hclge_config_mac_tnl_int(hdev, state);
 		if (rclient && rclient->ops->link_status_change)
 			rclient->ops->link_status_change(rhandle, state);
+		if (custom_client && custom_client->ops->link_status_change)
+			custom_client->ops->link_status_change(custom_handle, state);
 
 		hclge_push_link_status(hdev);
 	}
diff --git a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.h b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.h
index fcade6f..70c3649 100644
--- a/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.h
+++ b/drivers/net/ethernet/hisilicon/hns3/hns3pf/hclge_main.h
@@ -957,6 +957,7 @@ struct hclge_dev {
 	struct hnae3_client *roce_client;
 	struct hnae3_client *roh_client;
 	struct hnae3_client *custom_client;
+	void *custom_priv;
 
 #define HCLGE_FLAG_MAIN			BIT(0)
 #define HCLGE_FLAG_DCB_CAPABLE		BIT(1)
-- 
2.27.0

