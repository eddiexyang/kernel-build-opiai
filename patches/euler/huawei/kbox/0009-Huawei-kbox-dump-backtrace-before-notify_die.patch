From 0fe9579dbebfe54272dd7350e21a3705fc61edda Mon Sep 17 00:00:00 2001
From: lansheng <lansheng@huawei.com>
Date: Mon, 6 Feb 2023 20:53:07 +0800
Subject: [PATCH] [Huawei]kbox: dump backtrace before notify_die

Offering: HULK
ascend inclusion
category: bugfix

Signed-off-by: lansheng <lansheng@huawei.com>
---
 arch/arm64/kernel/traps.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/kernel/traps.c b/arch/arm64/kernel/traps.c
index f8ec533eb..b5691c453 100644
--- a/arch/arm64/kernel/traps.c
+++ b/arch/arm64/kernel/traps.c
@@ -99,15 +99,15 @@ static int __die(const char *str, int err, struct pt_regs *regs)
 	pr_emerg("Internal error: %s: %x [#%d]" S_PREEMPT S_SMP "\n",
 		 str, err, ++die_counter);
 
+	show_regs(regs);
+	dump_kernel_instr(KERN_EMERG, regs);
+
 	/* trap and error numbers are mostly meaningless on ARM */
 	ret = notify_die(DIE_OOPS, str, regs, err, 0, SIGSEGV);
 	if (ret == NOTIFY_STOP)
 		return ret;
 
 	print_modules();
-	show_regs(regs);
-
-	dump_kernel_instr(KERN_EMERG, regs);
 
 	return ret;
 }
-- 
2.27.0

