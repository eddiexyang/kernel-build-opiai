index f906df9db..d7841d940 100644
--- a/lib/Kconfig.debug
+++ b/lib/Kconfig.debug
@@ -534,6 +534,12 @@ source "lib/Kconfig.kgdb"
 source "lib/Kconfig.ubsan"
