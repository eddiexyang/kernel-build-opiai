From b142342034b6cc0eb526ed60480beda428522710 Mon Sep 17 00:00:00 2001
From: Wu Binfeng <wubinfeng@huawei.com>
Date: Fri, 1 Jul 2022 01:16:50 +0800
Subject: [PATCH 1/1] ascend: add hi1981 agent smmu dts

---
 drivers/iommu/ascend_smmu.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/iommu/ascend_smmu.c b/drivers/iommu/ascend_smmu.c
index 61c9b5f30..1161e7698 100644
--- a/drivers/iommu/ascend_smmu.c
+++ b/drivers/iommu/ascend_smmu.c
@@ -7,6 +7,7 @@
 #include <linux/platform_device.h>
 #include <linux/module.h>
 #include <linux/acpi.h>
+#include <linux/of.h>
 #include <linux/ascend_smmu.h>
 
 #define AGENT_SMMU_IDR1			0x4
@@ -413,10 +414,17 @@ static const struct acpi_device_id agent_smmu_acpi_match[] = {
 };
 MODULE_DEVICE_TABLE(acpi, agent_smmu_acpi_match);
 
+static const struct of_device_id agent_smmu_of_match[] = {
+	{ .compatible = "hisilicon,agent_smmu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, agent_smmu_of_match);
+
 static struct platform_driver agent_smmu_driver = {
 	.driver = {
 		.name = "agent_smmu_platform",
 		.acpi_match_table = agent_smmu_acpi_match,
+		.of_match_table = agent_smmu_of_match,
 	},
 	.probe = agent_smmu_platform_probe,
 	.remove = agent_smmu_platform_remove,
