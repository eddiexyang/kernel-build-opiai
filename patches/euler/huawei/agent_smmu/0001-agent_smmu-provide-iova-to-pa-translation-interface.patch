From e553f7bd6190d17a214a06300e4814c087d4fbb9 Mon Sep 17 00:00:00 2001
From: Wu Binfeng <wubinfeng@huawei.com>
Date: Thu, 30 Jun 2022 07:24:35 +0800
Subject: [PATCH] agent_smmu: provide iova to pa translation interface

---
 drivers/iommu/Kconfig       |   6 +
 drivers/iommu/Makefile      |   1 +
 drivers/iommu/ascend_smmu.c | 235 ++++++++++++++++++++++++++++++++++++
 include/linux/ascend_smmu.h |  29 +++++
 4 files changed, 271 insertions(+)
 create mode 100644 drivers/iommu/ascend_smmu.c

diff --git a/drivers/iommu/Kconfig b/drivers/iommu/Kconfig
index 750e997f1..27a38a867 100644
--- a/drivers/iommu/Kconfig
+++ b/drivers/iommu/Kconfig
@@ -436,4 +436,10 @@ config HISI_ASCEND_MPAM
 	help
 	  This driver provides interface to set smmu mpam for hisilicon device.
 
+config AGENT_SMMU_ATOS
+	bool "AGENT SMMU ATOS"
+	default y
+	help
+	  provide a interface to translate iova to pa by agent smmu.
+
 endif # IOMMU_SUPPORT
diff --git a/drivers/iommu/Makefile b/drivers/iommu/Makefile
index 955b9b3dd..77f14a16c 100644
--- a/drivers/iommu/Makefile
+++ b/drivers/iommu/Makefile
@@ -29,3 +29,4 @@ obj-$(CONFIG_HYPERV_IOMMU) += hyperv-iommu.o
 obj-$(CONFIG_VIRTIO_IOMMU) += virtio-iommu.o
 obj-$(CONFIG_IOMMU_SVA) += iommu-sva-lib.o io-pgfault.o
 obj-$(CONFIG_HISI_ASCEND_MPAM) += ascend_mpam.o
+obj-$(CONFIG_AGENT_SMMU_ATOS) += ascend_smmu.o
diff --git a/drivers/iommu/ascend_smmu.c b/drivers/iommu/ascend_smmu.c
new file mode 100644
index 000000000..43fa462d1
--- /dev/null
+++ b/drivers/iommu/ascend_smmu.c
@@ -0,0 +1,235 @@
+/*
+ *  provide a interface to translate iova to pa by agent smmu
+ */
+
+#include <linux/types.h>
+#include <linux/bitfield.h>
+#include <linux/iopoll.h>
+#include <linux/io-64-nonatomic-hi-lo.h>
+#include <linux/kref.h>
+
+#define AGENT_SMMU_REG_BASE		0x900400000ULL
+
+#define AGENT_SMMU_REG_SIZE		0x20000
+
+#define AGENT_SMMU_IDR0			0x0
+#define IDR0_ATOS			(1 << 15)
+
+#define AGENT_SMMU_IDR1			0x4
+#define IDR1_SSIDSIZE			GENMASK(10, 6)
+#define IDR1_SIDSIZE			GENMASK(5, 0)
+
+#define AGENT_SMMU_CR0			0x20
+#define CR0_SMMUEN			(1 << 0)
+
+#define AGENT_SMMU_ATOS_CTRL		0x100
+#define ATOS_ACTIVE			(1 << 0)
+
+#define AGENT_SMMU_ATOS_SID		0x108
+#define ATOS_STREAMID_MASK		GENMASK_ULL(31, 0)
+#define ATOS_SUBSTREAMID_MASK		GENMASK_ULL(51, 32)
+#define ATOS_SSID_VALID_MASK		GENMASK_ULL(52, 52)
+
+#define AGENT_SMMU_ATOS_ADDR		0x110
+#define ATOS_PHY_ADDR_MASK		GENMASK_ULL(63, 12)
+#define ATOS_ADDR_TYPE_MASK		GENMASK_ULL(11, 10)
+#define ATOS_ADDR_S1_TYPE		0x1
+#define ATOS_ADDR_PnU_MASK		GENMASK_ULL(9, 9)
+#define ATOS_ADDR_RnW_MASK		GENMASK_ULL(8, 8)
+#define ATOS_ADDR_InD_MASK		GENMASK_ULL(7, 7)
+#define ATOS_ADDR_HTTUI_MASK		GENMASK_ULL(6, 6)
+
+#define AGENT_SMMU_ATOS_PAR		0x118
+#define ATOS_PAR_F			(1 << 0)
+
+#define AGENT_SMMU_POLL_US		5
+#define AGENT_SMMU_TIMEOUT_US		50
+#define AGENT_SMMU_MAX_SUPPORT_NUM	1
+#define AGENT_SMMU_FAULT_REASON	GENMASK_ULL(11, 4)
+
+typedef struct {
+	void __iomem *agent_smmu_base;
+	bool atos_initialized;
+	struct kref ref;
+	unsigned int max_sid;
+	unsigned int max_ssid;
+} agent_smmu_t;
+
+static agent_smmu_t agent_smmu;
+static DEFINE_MUTEX(agent_smmu_lock);
+
+static void __agent_smmu_finit_locked(struct kref *ref)
+{
+	if (agent_smmu.agent_smmu_base) {
+		iounmap(agent_smmu.agent_smmu_base);
+	}
+	agent_smmu.agent_smmu_base = NULL;
+	agent_smmu.atos_initialized = false;
+	agent_smmu.max_sid = 0;
+	agent_smmu.max_ssid = 0;
+}
+
+int agent_smmu_init(void)
+{
+	u32 reg;
+	int res = 0;
+
+	mutex_lock(&agent_smmu_lock);
+
+	/* already init branch */
+	if (agent_smmu.atos_initialized) {
+		kref_get(&agent_smmu.ref);
+		goto out;
+	}
+
+	kref_init(&agent_smmu.ref);
+
+	agent_smmu.agent_smmu_base = ioremap(AGENT_SMMU_REG_BASE, AGENT_SMMU_REG_SIZE);
+	if (!agent_smmu.agent_smmu_base) {
+		pr_err("map agent smmu regs failed.\n");
+		res = -ENOMEM;
+		goto failed;
+	}
+
+	reg = readl_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_CR0);
+	if (!(reg & CR0_SMMUEN)) {
+		pr_err("agent smmu doesn't enable, it will bypass.\n");
+		res = -EPERM;
+		goto failed;
+	}
+
+	/* check ATOS is supported*/
+	reg = readl_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_IDR0);
+	if (!(reg & IDR0_ATOS)) {
+		pr_err("agent smmu doesn't support atos.\n");
+		res = -EINVAL;
+		goto failed;
+	}
+	agent_smmu.atos_initialized = true;
+
+	reg = readl_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_IDR1);
+	agent_smmu.max_sid = (1U << FIELD_GET(IDR1_SIDSIZE, reg)) - 1;
+	agent_smmu.max_ssid = (1U << FIELD_GET(IDR1_SSIDSIZE, reg)) - 1;
+	goto out;
+
+failed:
+	kref_put(&agent_smmu.ref, __agent_smmu_finit_locked);
+out:
+	mutex_unlock(&agent_smmu_lock);
+	return res;
+}
+EXPORT_SYMBOL_GPL(agent_smmu_init);
+
+void agent_smmu_finit(void)
+{
+	mutex_lock(&agent_smmu_lock);
+	if (!agent_smmu.atos_initialized) {
+		goto out;
+	}
+
+	kref_put(&agent_smmu.ref, __agent_smmu_finit_locked);
+out:
+	mutex_unlock(&agent_smmu_lock);
+	return;
+}
+EXPORT_SYMBOL_GPL(agent_smmu_finit);
+
+int agent_smmu_iova_to_phys(u32 sid, u32 ssid, dma_addr_t *iova,
+		int nr_iovas, phys_addr_t *pa)
+{
+	u32 reg_32;
+	u64 reg_64 = 0;
+	int res = 0;
+	int index = 0;
+	int max_i = AGENT_SMMU_MAX_SUPPORT_NUM;
+	int count;
+	int i;
+	int j;
+
+	if (iova == NULL || pa == NULL || nr_iovas <= 0) {
+		return -EINVAL;
+	}
+
+	count = 1 + (nr_iovas - 1) / AGENT_SMMU_MAX_SUPPORT_NUM;
+
+	mutex_lock(&agent_smmu_lock);
+
+	if (!agent_smmu.atos_initialized) {
+		pr_err("the agent smmu is not support ATOS, try init first.\n");
+		res = -EPERM;
+		goto out;
+	}
+
+	/* ensure ATOS_CTRL.RUN is 0  */
+	reg_32 = readl_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_CTRL);
+	if (reg_32 & ATOS_ACTIVE) {
+		pr_err("the agent smmu is in a query, try later\n");
+		res = -EBUSY;
+		goto out;
+	}
+
+	if (sid > agent_smmu.max_sid || ssid > agent_smmu.max_ssid) {
+		pr_err("sid or ssid out of acceptable range.\n");
+		res = -EINVAL;
+		goto out;
+	}
+
+	for (j = 0; j < count; j++) {
+		if (j == count - 1) {
+			max_i = nr_iovas - index;
+		}
+
+		/* write sid and ssid */
+		reg_64 = FIELD_PREP(ATOS_STREAMID_MASK, sid);
+		reg_64 |= FIELD_PREP(ATOS_SUBSTREAMID_MASK, ssid);
+		reg_64 |= FIELD_PREP(ATOS_SSID_VALID_MASK, ssid ? 1 : 0);
+		writeq_relaxed(reg_64, agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_SID);
+
+		/* write iova */
+		for (i = 0; i < max_i; i++, index++) {
+			reg_64 = iova[index] & PAGE_MASK; //addr
+			reg_64 |= FIELD_PREP(ATOS_ADDR_TYPE_MASK, ATOS_ADDR_S1_TYPE);
+			reg_64 |= FIELD_PREP(ATOS_ADDR_PnU_MASK, 0);
+			reg_64 |= FIELD_PREP(ATOS_ADDR_RnW_MASK, 0); // write
+			reg_64 |= FIELD_PREP(ATOS_ADDR_InD_MASK, 0);
+			reg_64 |= FIELD_PREP(ATOS_ADDR_HTTUI_MASK, 0);
+			writeq_relaxed(reg_64, agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_ADDR);
+		}
+
+		/* write run bit to start translate operation */
+		writel(ATOS_ACTIVE, agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_CTRL);
+
+		/* poll run bit */
+		if (readl_poll_timeout(agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_CTRL,
+					reg_32, !(reg_32 & ATOS_ACTIVE),
+					AGENT_SMMU_POLL_US,
+					AGENT_SMMU_TIMEOUT_US)) {
+			pr_err("iova to phys timed out, sid = %x, ssid = %u.\n",
+					sid, ssid);
+			res = -EBUSY;
+			goto out;
+		}
+
+		/* get pa */
+		index -= max_i;
+		for (i = 0; i < max_i; i++, index++) {
+			reg_64 = readq_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_PAR);
+			if (reg_64 & ATOS_PAR_F) {
+				pr_err("translation fault, iova = 0x%llx, "
+						"sid = %x , ssid = %u, "
+						"PAR = 0x%llx\n",
+						iova[index], sid, ssid, reg_64);
+				/* low 12 bit record the reason */
+				pa[index] = reg_64 & AGENT_SMMU_FAULT_REASON;
+			} else {
+				pa[index] = (reg_64 & ATOS_PHY_ADDR_MASK) |
+					(iova[index] & ~PAGE_MASK);
+			}
+		}
+	}
+
+out:
+	mutex_unlock(&agent_smmu_lock);
+	return res;
+}
+EXPORT_SYMBOL_GPL(agent_smmu_iova_to_phys);
diff --git a/include/linux/ascend_smmu.h b/include/linux/ascend_smmu.h
index 9ccd29fe9..f04d834e3 100644
--- a/include/linux/ascend_smmu.h
+++ b/include/linux/ascend_smmu.h
@@ -8,4 +8,33 @@ extern int ascend_smmu_get_mpam(int pasid, int *partid, int *pmg, int *s1mpam);
 extern int ascend_smmu_set_user_mpam_en(int user_mpam_en);
 extern int ascend_smmu_get_user_mpam_en(int *user_mpam_en);
 
+#ifndef __LINUX_AGENT_SMMU_H
+#define __LINUX_AGENT_SMMU_H
+
+#define INV_REQ			0xff
+#define INV_STAGE		0xfe
+#define INTERNAL_ERR		0xfd
+#define C_BAD_STREAMID		0x02
+#define F_STE_FETCH		0x03
+#define C_BAD_STE		0x04
+#define F_STREAM_DISABLED	0x06
+#define C_BAD_SUBSTREAMID	0x08
+#define F_CD_FETCH		0x09
+#define C_BAD_CD		0x0a
+#define F_WALK_EABT		0x0b
+#define F_TRANSLATION		0x10
+#define F_ADDR_SIZE		0x11
+#define F_ACCESS		0x12
+#define F_PERMISSION		0x13
+#define F_TLB_CONFLICT		0x20
+#define F_CFG_CONFLICT		0x21
+#define F_VMS_FETCH		0x25
+
+extern int agent_smmu_init(void);
+extern void agent_smmu_finit(void);
+extern int agent_smmu_iova_to_phys(u32 sid, u32 ssid, dma_addr_t *iova,
+		int nr_iovas, phys_addr_t *pa);
+
+#endif
+
 #endif /* __LINUX_ASCEND_SMMU_H */
-- 
