From 5305c1a6a4b986d5a36e3aa119408a6c6ebb5b75 Mon Sep 17 00:00:00 2001
From: Wu Binfeng <wubinfeng@huawei.com>
Date: Mon, 6 Sep 2021 09:51:20 +0800
Subject: [PATCH 1/2] agent_smmu: manage agent_smmu as platfrom device

---
 drivers/iommu/ascend_smmu.c | 263 ++++++++++++++++++++++--------------
 include/linux/ascend_smmu.h |  31 ++++-
 2 files changed, 185 insertions(+), 109 deletions(-)

diff --git a/drivers/iommu/ascend_smmu.c b/drivers/iommu/ascend_smmu.c
index 43fa462d1..a93751367 100644
--- a/drivers/iommu/ascend_smmu.c
+++ b/drivers/iommu/ascend_smmu.c
@@ -2,18 +2,14 @@
  *  provide a interface to translate iova to pa by agent smmu
  */
 
-#include <linux/types.h>
 #include <linux/bitfield.h>
 #include <linux/iopoll.h>
-#include <linux/io-64-nonatomic-hi-lo.h>
-#include <linux/kref.h>
+#include <linux/platform_device.h>
+#include <linux/module.h>
+#include <linux/acpi.h>
+#include <linux/ascend_smmu.h>
 
-#define AGENT_SMMU_REG_BASE		0x900400000ULL
-
-#define AGENT_SMMU_REG_SIZE		0x20000
-
-#define AGENT_SMMU_IDR0			0x0
-#define IDR0_ATOS			(1 << 15)
+#define AGENT_SMMU_REG_SIZE            0x20000
 
 #define AGENT_SMMU_IDR1			0x4
 #define IDR1_SSIDSIZE			GENMASK(10, 6)
@@ -47,96 +43,134 @@
 #define AGENT_SMMU_MAX_SUPPORT_NUM	1
 #define AGENT_SMMU_FAULT_REASON	GENMASK_ULL(11, 4)
 
-typedef struct {
-	void __iomem *agent_smmu_base;
-	bool atos_initialized;
-	struct kref ref;
+static LIST_HEAD(agent_smmu_list);
+static DEFINE_SPINLOCK(agent_smmu_lock);
+
+struct agent_smmu {
+	struct device *dev;
+	void __iomem *base;
 	unsigned int max_sid;
 	unsigned int max_ssid;
-} agent_smmu_t;
+	rwlock_t rw_lock;
 
-static agent_smmu_t agent_smmu;
-static DEFINE_MUTEX(agent_smmu_lock);
+	struct list_head list;
+	u64 device_id;	/* DIE id */
+};
 
-static void __agent_smmu_finit_locked(struct kref *ref)
+struct agent_smmu *agent_smmu_unlocked_find(u64 device_id)
 {
-	if (agent_smmu.agent_smmu_base) {
-		iounmap(agent_smmu.agent_smmu_base);
+	struct agent_smmu *temp = NULL;
+
+	list_for_each_entry(temp, &agent_smmu_list, list) {
+		if (temp->device_id == device_id) {
+			return temp;
+		}
 	}
-	agent_smmu.agent_smmu_base = NULL;
-	agent_smmu.atos_initialized = false;
-	agent_smmu.max_sid = 0;
-	agent_smmu.max_ssid = 0;
+	return NULL;
 }
 
-int agent_smmu_init(void)
+static int agent_smmu_register(struct agent_smmu *agent)
 {
-	u32 reg;
-	int res = 0;
+	struct device *dev = agent->dev;
 
-	mutex_lock(&agent_smmu_lock);
+	spin_lock(&agent_smmu_lock);
+	if (agent_smmu_unlocked_find(agent->device_id)) {
+		dev_err(dev, "already added for %lld.\n", agent->device_id);
+		spin_unlock(&agent_smmu_lock);
+		return -EFAULT;
+	}
+	list_add_tail(&agent->list, &agent_smmu_list);
+	spin_unlock(&agent_smmu_lock);
 
-	/* already init branch */
-	if (agent_smmu.atos_initialized) {
-		kref_get(&agent_smmu.ref);
-		goto out;
+	return 0;
+}
+
+static void agent_smmu_unregister(struct agent_smmu *agent)
+{
+	spin_lock(&agent_smmu_lock);
+	list_del(&agent->list);
+	spin_unlock(&agent_smmu_lock);
+}
+
+static int agent_smmu_platform_probe(struct platform_device *pdev)
+{
+	struct agent_smmu *agent = NULL;
+	struct device *dev = &pdev->dev;
+	struct resource *res = NULL;
+	u32 reg = 0;
+	int ret = 0;
+	acpi_status status = AE_OK;
+
+	agent = devm_kzalloc(dev, sizeof(*agent), GFP_KERNEL);
+	if (!agent) {
+		dev_err(dev, "failed to allocate agent smmu.\n");
+		return -ENOMEM;
 	}
 
-	kref_init(&agent_smmu.ref);
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || resource_size(res) + 1 < AGENT_SMMU_REG_SIZE) {
+		dev_err(dev, "MMIO region is null or too small, check it.\n");
+		ret = -EINVAL;
+		goto err_free;
+	}
 
-	agent_smmu.agent_smmu_base = ioremap(AGENT_SMMU_REG_BASE, AGENT_SMMU_REG_SIZE);
-	if (!agent_smmu.agent_smmu_base) {
-		pr_err("map agent smmu regs failed.\n");
-		res = -ENOMEM;
-		goto failed;
+	// agent smmu may probe as smmu in device, so keep using ioreamp
+	agent->base = ioremap(res->start, resource_size(res));
+	if (!agent->base) {
+		dev_err(dev, "unable to map agent smmu.\n");
+		ret = -ENOMEM;
+		goto err_free;
 	}
 
-	reg = readl_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_CR0);
+	/* check agent smmu is enabled */
+	reg = readl_relaxed(agent->base + AGENT_SMMU_CR0);
 	if (!(reg & CR0_SMMUEN)) {
-		pr_err("agent smmu doesn't enable, it will bypass.\n");
-		res = -EPERM;
-		goto failed;
+		dev_err(dev, "agent smmu is not enabled, check it.\n");
+		ret = -EPERM;
+		goto err_iounmap;
 	}
 
-	/* check ATOS is supported*/
-	reg = readl_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_IDR0);
-	if (!(reg & IDR0_ATOS)) {
-		pr_err("agent smmu doesn't support atos.\n");
-		res = -EINVAL;
-		goto failed;
+	status = acpi_evaluate_integer(ACPI_HANDLE(&pdev->dev), METHOD_NAME__UID,
+				       NULL, &agent->device_id);
+	if (ACPI_FAILURE(status) || agent_smmu_register(agent)) {
+		dev_err(dev, "agent smmu UID 0x%x has been probed.\n", status);
+		ret = -EINVAL;
+		goto err_iounmap;
 	}
-	agent_smmu.atos_initialized = true;
-
-	reg = readl_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_IDR1);
-	agent_smmu.max_sid = (1U << FIELD_GET(IDR1_SIDSIZE, reg)) - 1;
-	agent_smmu.max_ssid = (1U << FIELD_GET(IDR1_SSIDSIZE, reg)) - 1;
-	goto out;
 
-failed:
-	kref_put(&agent_smmu.ref, __agent_smmu_finit_locked);
-out:
-	mutex_unlock(&agent_smmu_lock);
-	return res;
+	reg = readl_relaxed(agent->base + AGENT_SMMU_IDR1);
+	agent->max_sid = (1U << FIELD_GET(IDR1_SIDSIZE, reg)) - 1;
+	agent->max_ssid = (1U << FIELD_GET(IDR1_SSIDSIZE, reg)) - 1;
+	rwlock_init(&agent->rw_lock);
+	agent->dev = dev;
+	platform_set_drvdata(pdev, agent);
+
+	dev_info(dev, "agent smmu 0x%llx probed successfully.\n", agent->device_id);
+	return ret;
+err_iounmap:
+	iounmap(agent->base);
+	agent->base = NULL;
+err_free:
+	devm_kfree(dev, agent);
+	return ret;
 }
-EXPORT_SYMBOL_GPL(agent_smmu_init);
 
-void agent_smmu_finit(void)
+static int agent_smmu_platform_remove(struct platform_device *pdev)
 {
-	mutex_lock(&agent_smmu_lock);
-	if (!agent_smmu.atos_initialized) {
-		goto out;
-	}
-
-	kref_put(&agent_smmu.ref, __agent_smmu_finit_locked);
-out:
-	mutex_unlock(&agent_smmu_lock);
-	return;
+	struct agent_smmu *agent = platform_get_drvdata(pdev);
+
+	agent_smmu_unregister(agent);
+	iounmap(agent->base);
+	agent->dev = NULL;
+	agent->base = NULL;
+	dev_info(&pdev->dev, "agent smmu removed successfully.\n");
+	return 0;
 }
-EXPORT_SYMBOL_GPL(agent_smmu_finit);
 
-int agent_smmu_iova_to_phys(u32 sid, u32 ssid, dma_addr_t *iova,
-		int nr_iovas, phys_addr_t *pa)
+int agent_smmu_iova_to_phys(struct agent_smmu_atos_data *data)
 {
+	struct agent_smmu *agent = NULL;
+
 	u32 reg_32;
 	u64 reg_64 = 0;
 	int res = 0;
@@ -146,29 +180,32 @@ int agent_smmu_iova_to_phys(u32 sid, u32 ssid, dma_addr_t *iova,
 	int i;
 	int j;
 
-	if (iova == NULL || pa == NULL || nr_iovas <= 0) {
+	if (!data || !data->iova || !data->pa || data->nr <= 0) {
 		return -EINVAL;
 	}
 
-	count = 1 + (nr_iovas - 1) / AGENT_SMMU_MAX_SUPPORT_NUM;
-
-	mutex_lock(&agent_smmu_lock);
-
-	if (!agent_smmu.atos_initialized) {
-		pr_err("the agent smmu is not support ATOS, try init first.\n");
-		res = -EPERM;
-		goto out;
+	spin_lock(&agent_smmu_lock);
+	agent = agent_smmu_unlocked_find(data->device_id);
+	if (!agent || !get_device(agent->dev)) {
+		pr_err("agent smmu: %lld has been removed or hasn't initialized.\n",
+		       data->device_id);
+		spin_unlock(&agent_smmu_lock);
+		return -EINVAL;
 	}
+	spin_unlock(&agent_smmu_lock);
+
+	write_lock(&agent->rw_lock);
 
+	count = 1 + (data->nr - 1) / AGENT_SMMU_MAX_SUPPORT_NUM;
 	/* ensure ATOS_CTRL.RUN is 0  */
-	reg_32 = readl_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_CTRL);
+	reg_32 = readl_relaxed(agent->base + AGENT_SMMU_ATOS_CTRL);
 	if (reg_32 & ATOS_ACTIVE) {
 		pr_err("the agent smmu is in a query, try later\n");
 		res = -EBUSY;
 		goto out;
 	}
 
-	if (sid > agent_smmu.max_sid || ssid > agent_smmu.max_ssid) {
+	if (data->sid > agent->max_sid || data->ssid > agent->max_ssid) {
 		pr_err("sid or ssid out of acceptable range.\n");
 		res = -EINVAL;
 		goto out;
@@ -176,36 +213,36 @@ int agent_smmu_iova_to_phys(u32 sid, u32 ssid, dma_addr_t *iova,
 
 	for (j = 0; j < count; j++) {
 		if (j == count - 1) {
-			max_i = nr_iovas - index;
+			max_i = data->nr - index;
 		}
 
 		/* write sid and ssid */
-		reg_64 = FIELD_PREP(ATOS_STREAMID_MASK, sid);
-		reg_64 |= FIELD_PREP(ATOS_SUBSTREAMID_MASK, ssid);
-		reg_64 |= FIELD_PREP(ATOS_SSID_VALID_MASK, ssid ? 1 : 0);
-		writeq_relaxed(reg_64, agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_SID);
+		reg_64 = FIELD_PREP(ATOS_STREAMID_MASK, data->sid);
+		reg_64 |= FIELD_PREP(ATOS_SUBSTREAMID_MASK, data->ssid);
+		reg_64 |= FIELD_PREP(ATOS_SSID_VALID_MASK, data->ssid ? 1 : 0);
+		writeq_relaxed(reg_64, agent->base + AGENT_SMMU_ATOS_SID);
 
 		/* write iova */
 		for (i = 0; i < max_i; i++, index++) {
-			reg_64 = iova[index] & PAGE_MASK; //addr
+			reg_64 = data->iova[index] & PAGE_MASK; //addr
 			reg_64 |= FIELD_PREP(ATOS_ADDR_TYPE_MASK, ATOS_ADDR_S1_TYPE);
-			reg_64 |= FIELD_PREP(ATOS_ADDR_PnU_MASK, 0);
-			reg_64 |= FIELD_PREP(ATOS_ADDR_RnW_MASK, 0); // write
-			reg_64 |= FIELD_PREP(ATOS_ADDR_InD_MASK, 0);
-			reg_64 |= FIELD_PREP(ATOS_ADDR_HTTUI_MASK, 0);
-			writeq_relaxed(reg_64, agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_ADDR);
+			reg_64 |= FIELD_PREP(ATOS_ADDR_PnU_MASK, data->pnu ? 1 : 0);
+			reg_64 |= FIELD_PREP(ATOS_ADDR_RnW_MASK, data->rnw ? 1 : 0);
+			reg_64 |= FIELD_PREP(ATOS_ADDR_InD_MASK, data->ind ? 1 : 0);
+			reg_64 |= FIELD_PREP(ATOS_ADDR_HTTUI_MASK, data->httui ? 1 : 0);
+			writeq_relaxed(reg_64, agent->base + AGENT_SMMU_ATOS_ADDR);
 		}
 
 		/* write run bit to start translate operation */
-		writel(ATOS_ACTIVE, agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_CTRL);
+		writel(ATOS_ACTIVE, agent->base + AGENT_SMMU_ATOS_CTRL);
 
 		/* poll run bit */
-		if (readl_poll_timeout(agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_CTRL,
+		if (readl_poll_timeout(agent->base + AGENT_SMMU_ATOS_CTRL,
 					reg_32, !(reg_32 & ATOS_ACTIVE),
 					AGENT_SMMU_POLL_US,
 					AGENT_SMMU_TIMEOUT_US)) {
 			pr_err("iova to phys timed out, sid = %x, ssid = %u.\n",
-					sid, ssid);
+					data->sid, data->ssid);
 			res = -EBUSY;
 			goto out;
 		}
@@ -213,23 +250,39 @@ int agent_smmu_iova_to_phys(u32 sid, u32 ssid, dma_addr_t *iova,
 		/* get pa */
 		index -= max_i;
 		for (i = 0; i < max_i; i++, index++) {
-			reg_64 = readq_relaxed(agent_smmu.agent_smmu_base + AGENT_SMMU_ATOS_PAR);
+			reg_64 = readq_relaxed(agent->base + AGENT_SMMU_ATOS_PAR);
 			if (reg_64 & ATOS_PAR_F) {
 				pr_err("translation fault, iova = 0x%llx, "
-						"sid = %x , ssid = %u, "
-						"PAR = 0x%llx\n",
-						iova[index], sid, ssid, reg_64);
+				       "sid = %x , ssid = %u, PAR = 0x%llx\n",
+				       data->iova[index], data->sid, data->ssid, reg_64);
 				/* low 12 bit record the reason */
-				pa[index] = reg_64 & AGENT_SMMU_FAULT_REASON;
+				data->pa[index] = reg_64 & AGENT_SMMU_FAULT_REASON;
 			} else {
-				pa[index] = (reg_64 & ATOS_PHY_ADDR_MASK) |
-					(iova[index] & ~PAGE_MASK);
+				data->pa[index] = (reg_64 & ATOS_PHY_ADDR_MASK) |
+						  (data->iova[index] & ~PAGE_MASK);
 			}
 		}
 	}
 
 out:
-	mutex_unlock(&agent_smmu_lock);
+	write_unlock(&agent->rw_lock);
+	put_device(agent->dev);
 	return res;
 }
 EXPORT_SYMBOL_GPL(agent_smmu_iova_to_phys);
+
+static const struct acpi_device_id agent_smmu_acpi_match[] = {
+	{"SMMU0000", 0},
+	{}
+};
+MODULE_DEVICE_TABLE(acpi, agent_smmu_acpi_match);
+
+static struct platform_driver agent_smmu_driver = {
+	.driver = {
+		.name = "agent_smmu_platform",
+		.acpi_match_table = agent_smmu_acpi_match,
+	},
+	.probe = agent_smmu_platform_probe,
+	.remove = agent_smmu_platform_remove,
+};
+module_platform_driver(agent_smmu_driver);
diff --git a/include/linux/ascend_smmu.h b/include/linux/ascend_smmu.h
index f04d834e3..afa525791 100644
--- a/include/linux/ascend_smmu.h
+++ b/include/linux/ascend_smmu.h
@@ -30,10 +30,33 @@ extern int ascend_smmu_get_user_mpam_en(int *user_mpam_en);
 #define F_CFG_CONFLICT		0x21
 #define F_VMS_FETCH		0x25
 
-extern int agent_smmu_init(void);
-extern void agent_smmu_finit(void);
-extern int agent_smmu_iova_to_phys(u32 sid, u32 ssid, dma_addr_t *iova,
-		int nr_iovas, phys_addr_t *pa);
+/**
+ * struct agent_smmu_atos_data - information required for address translation
+ * @sid: stream id
+ * @ssid: substream id
+ * @PnU: 0 for Unprivileged, 1 for Privileged
+ * @RnW: 0 for Write, 1 for Read
+ * @InD: 0 for Data, 1 for Instruction
+ * @HTTUI: 0 for HTTU might occur, 1 for HTTU inhibited
+ * @nr: number of addresses
+ * @iova: iova addresses to be translated
+ * @pa: translated physical addresses
+ * @device_id: agent smmu uid
+ */
+struct agent_smmu_atos_data {
+	u32 sid;
+	u32 ssid;
+	u32 pnu;
+	u32 rnw;
+	u32 ind;
+	u32 httui;
+	int nr;
+	dma_addr_t *iova;
+	phys_addr_t *pa;
+	u64 device_id;
+};
+
+extern int agent_smmu_iova_to_phys(struct agent_smmu_atos_data *data);
 
 #endif
 
-- 
2.33.0

