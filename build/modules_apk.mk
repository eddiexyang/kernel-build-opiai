.PHONY: modules-apk

modules-apk: | ensure-output-dirs
	kernel_release=
	package_name=
	package_arch=
	package_version=
	apk_workspace=
	pkg_root=
	driver_target_dir=
	autoload_conf_src=
	autoload_conf_name=
	autoload_conf_dir=
	apk_path=
	depmod_bin=
	test -e "$(OUTPUT_DIR)/modules/lib/modules" || { printf 'error: missing required path: %s\n' "$(OUTPUT_DIR)/modules/lib/modules" >&2; exit 1; }
	test -e "$(OUTPUT_DIR)/driver_modules" || { printf 'error: missing required path: %s\n' "$(OUTPUT_DIR)/driver_modules" >&2; exit 1; }
	depmod_bin="$$(command -v depmod 2>/dev/null || true)"
	if [ -z "$$depmod_bin" ]; then
		for candidate in /sbin/depmod /usr/sbin/depmod; do
			if [ -x "$$candidate" ]; then
				depmod_bin="$$candidate"
				break
			fi
		done
	fi
	[ -n "$$depmod_bin" ] || { printf 'error: depmod is required to build modules-apk\n' >&2; exit 1; }
	mapfile -t releases < <(find "$(OUTPUT_DIR)/modules/lib/modules" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
	[ "$${#releases[@]}" -eq 1 ] || { printf 'error: expected exactly one kernel release under %s, found %s\n' "$(OUTPUT_DIR)/modules/lib/modules" "$${#releases[@]}" >&2; exit 1; }
	kernel_release="$${releases[0]}"
	package_name="$${MODULES_APK_PACKAGE_NAME:-linux-modules-$$kernel_release}"
	package_arch="$${MODULES_APK_PACKAGE_ARCH:-aarch64}"
	package_version="$${MODULES_APK_PACKAGE_VERSION:-$(BUILD_TIMESTAMP_MINUTE)}"
	apk_workspace="$(WORKSPACE_DIR)/modules-apk"
	pkg_root="$$apk_workspace/pkgroot"
	driver_target_dir="$$pkg_root/lib/modules/$$kernel_release/extra/ascend310b"
	autoload_conf_src="$(OUTPUT_DIR)/ascend310b-driver-modules.conf"
	autoload_conf_name="ascend310b-driver-modules-$$kernel_release.conf"
	autoload_conf_dir="$$pkg_root/etc/modules.d"
	apk_path="$(OUTPUT_DIR)/$${package_name}-$${package_version}.apk"
	printf 'start generate modules apk (OpenWrt)\n'
	rm -rf "$$apk_workspace"
	mkdir -p "$$pkg_root"
	cp -a "$(OUTPUT_DIR)/modules/." "$$pkg_root/"
	rm -rf "$$pkg_root/lib/modules/$$kernel_release/build" "$$pkg_root/lib/modules/$$kernel_release/source"
	mkdir -p "$$driver_target_dir"
	if [ -f "$(OUTPUT_DIR)/ascend310b-driver-modules.conf" ]; then
		while IFS= read -r ko; do
			ko_base="$${ko##*/}"
			ko_name="$${ko_base%.ko}"
			ko_name="$${ko_name%.ko.xz}"
			kernel_ko="$$(find "$$pkg_root/lib/modules/$$kernel_release" -name "$${ko_base}" -not -path '*/extra/*' 2>/dev/null | head -1)"
			if [ -z "$$kernel_ko" ]; then
				cp -a "$(OUTPUT_DIR)/driver_modules/$$ko_base" "$$driver_target_dir/" 2>/dev/null || \
				cp -a "$(OUTPUT_DIR)/driver_modules/$${ko_name}.ko" "$$driver_target_dir/" 2>/dev/null || true
			fi
		done < <(find "$(OUTPUT_DIR)/driver_modules" -maxdepth 1 -type f \( -name '*.ko' -o -name '*.ko.xz' \) | sort)
	else
		find "$(OUTPUT_DIR)/driver_modules" -maxdepth 1 -type f \( -name '*.ko' -o -name '*.ko.xz' \) -exec cp -a {} "$$driver_target_dir/" \;
	fi
	find "$$pkg_root/lib/modules/$$kernel_release" -maxdepth 1 -type f \
		\( -name 'modules.dep*' -o -name 'modules.alias*' -o -name 'modules.symbols*' \
		   -o -name 'modules.softdep' -o -name 'modules.weakdep' -o -name 'modules.devname' \) \
		-delete
	"$$depmod_bin" -b "$$pkg_root" -a "$$kernel_release"
	mkdir -p "$$autoload_conf_dir"
	if [ -f "$$autoload_conf_src" ]; then
		cp -f "$$autoload_conf_src" "$$autoload_conf_dir/$$autoload_conf_name"
	fi
	mkdir -p "$$apk_workspace/control"
	cat > "$$apk_workspace/control/.PKGINFO" <<-PKGINFO
	# Generated by kernel-build-opiai
	pkgname = $${package_name}
	pkgver = $${package_version}-r0
	pkgdesc = Ascend310B kernel and driver modules for $${kernel_release}
	url = https://github.com/HwHiAiUser/kernel-build-opiai
	builddate = $$(date +%s)
	packager = kernel-build-opiai
	size = $$(du -sb "$$pkg_root" | cut -f1)
	arch = $${package_arch}
	origin = $${package_name}
	maintainer = HwHiAiUser
	provides = kmod-ascend310b=$${package_version}-r0
	PKGINFO
	sed -i 's/^\t//' "$$apk_workspace/control/.PKGINFO"
	cat > "$$apk_workspace/control/.post-install" <<-'POSTINST'
	#!/bin/sh
	if command -v depmod >/dev/null 2>&1; then
	    for d in /lib/modules/*/; do
	        rel="$${d#/lib/modules/}"
	        rel="$${rel%/}"
	        [ -n "$$rel" ] && depmod -a "$$rel" 2>/dev/null || true
	    done
	fi
	POSTINST
	sed -i 's/^\t//' "$$apk_workspace/control/.post-install"
	chmod 0755 "$$apk_workspace/control/.post-install"
	cd "$$apk_workspace/control" && tar czf "$$apk_workspace/control.tar.gz" .PKGINFO .post-install
	cd "$$pkg_root" && tar czf "$$apk_workspace/data.tar.gz" .
	cd "$$apk_workspace" && cat control.tar.gz data.tar.gz > "$$apk_path"
	printf 'generate %s success\n' "$$apk_path"
