#*******************************************************************************
#The rule of make Linux kernel module
#*******************************************************************************

CUR_MAKEFILE_PATH := $(strip \
                $(eval LOCAL_MODULE_MAKEFILE := $$(lastword $$(MAKEFILE_LIST))) \
                $(patsubst %/,%, $(dir $(LOCAL_MODULE_MAKEFILE))) \
                )


EXTRA_CFLAGS += -I$(CUR_MAKEFILE_PATH)/../../include/
EXTRA_CFLAGS += -I$(CUR_MAKEFILE_PATH)/../../../include/
EXTRA_CFLAGS += -I$(CUR_MAKEFILE_PATH)/../../../include/adapt/
EXTRA_CFLAGS += -I$(CUR_MAKEFILE_PATH)/../../../base/arch/hidvpp/include/
EXTRA_CFLAGS += -I$(CUR_MAKEFILE_PATH)/../../../../../../inc/external/dvpp/
EXTRA_CFLAGS += -I$(CUR_MAKEFILE_PATH)/../../../../../../inc/dvpp/
EXTRA_CFLAGS += -I$(CUR_MAKEFILE_PATH)/../../../../../../../../libc_sec/include/
EXTRA_CFLAGS += -I$(CUR_MAKEFILE_PATH)/../../../osal/linux/kernel/himedia/
EXTRA_CFLAGS += -DENABLE_ADVSMARTP
EXTRA_CFLAGS += -DBUILD_DRV_OSAL
EXTRA_CFLAGS += -DDVPP_MINI
EXTRA_CFLAGS += -DUSE_DVPP_FWK


obj-m   += drv_osal.o
drv_osal-objs :=
drv_osal-objs += osal.o osal_addr.o osal_atomic.o osal_barrier.o \
                 osal_debug.o osal_cache.o osal_device.o osal_fileops.o \
                 osal_interrupt.o osal_math.o osal_mutex.o \
                 osal_platform.o osal_proc.o osal_schedule.o osal_semaphore.o \
                 osal_spinlock.o osal_string.o osal_task.o osal_timer.o \
                 osal_vmalloc.o osal_wait.o himedia/base.o \
                 himedia/himedia.o
