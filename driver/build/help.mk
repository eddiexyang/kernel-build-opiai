
.PHONY: help
help:
	@echo ""
	@echo "make [target] [restriction]                                                   # build target which you specify "
	@echo "" 
	@echo "----------------- make command --------------------------"
	@echo "make all CROSS_COMPILE=[compiler_prefix] KERNEL_DIR=[kernel_dir]              # build all module with specified kernel and gcc"
	@echo "make driver CROSS_COMPILE=[compiler_prefix] KERNEL_DIR=[kernel_dir]           # build driver with specified kernel and gcc"
	@echo "make hiaiengine CROSS_COMPILE=[compiler_prefix]                               # build hiaiengine with specified gcc"
	@echo "make toolchain CROSS_COMPILE=[compiler_prefix]                                # build toolchain with specified gcc"
	@echo "make clean                                                                    # remove build generate files"
	@echo "" 
	@echo "----------------- build parameter ------------------------"
	@echo "debug=true                                                                    # add parameter '-g' for debug"
	@echo "ARCH=arm64                                                                    # specify the arch of host:x86,arm,arm64(default)"
	@echo "HOST_OS=CentOS                                                                # specify the os type of host:CentOS,Ubuntu(default)"
	@echo "CROSS_COMPILE=compiler_prefix                                                 # specify the compiler prefix"
	@echo "KERNEL_DIR=kernel_dir                                                         # specify the kernel path"
	@echo "O=output_dir                                                                  # specify the dir of output"
	@echo "KERNEL_DEFCONFIG=deconfig_file                                                # specify the deconfig file of kernel"
	@echo "" 
	@echo "" 
	@echo "Example:"
	@echo "  make clean"
	@echo "  make ARCH=arm64 CROSS_COMPILE=aarch64-himix100-linux- KERNEL_DIR=/usr/kernel/linux-4.9"
	@echo "  make ARCH=arm CROSS_COMPILE=arm-himix200-linux- KERNEL_DIR=/usr/kernel/linux-4.9"
	@echo ""

