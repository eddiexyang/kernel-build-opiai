#env set

HOST_DEFAULT_COMPILER := HOST_ARM64

ifeq ($(ARCH),)
ARCH := arm64
endif

ifeq ($(ARCH),x86)
HOST_DEFAULT_COMPILER := HOST_X86
else ifeq ($(ARCH),arm)
export host := arm
$(HOST_DEFAULT_COMPILER)_TOOLS_PREFIX := arm-himix200-linux-
else
export host := arm64
HOST_DEFAULT_COMPILER := HOST_ARM64
endif

ifneq ($(KERNEL_DIR),)
HOST_KERNEL_PATH := $(KERNEL_DIR)
DEVICE_KERNEL_PATH := $(KERNEL_DIR)
endif

ifneq ($(KERNEL_DEFCONFIG),)
HOST_KERNEL_DEFCONFIG := $(KERNEL_DEFCONFIG)
DEVICE_KERNEL_DEFCONFIG := $(KERNEL_DEFCONFIG)
endif

ifneq ($(CROSS_COMPILE),)
HOST_KERNEL_COMPILER_PREFIX := $(CROSS_COMPILE)
DEVICE_KERNEL_COMPILER_PREFIX := $(CROSS_COMPILE)
$(HOST_DEFAULT_COMPILER)_TOOLS_PREFIX := $(CROSS_COMPILE)
else 
ifeq ($(ARCH),arm64)
HOST_KERNEL_COMPILER_PREFIX := aarch64-himix100-linux-
DEVICE_KERNEL_COMPILER_PREFIX := aarch64-himix100-linux-
$(HOST_DEFAULT_COMPILER)_TOOLS_PREFIX := aarch64-himix100-linux-
else ifeq ($(ARCH),arm)
HOST_KERNEL_COMPILER_PREFIX := arm-himix200-linux-
DEVICE_KERNEL_COMPILER_PREFIX := arm-himix200-linux-
$(HOST_DEFAULT_COMPILER)_TOOLS_PREFIX := arm-himix200-linux-
endif
endif

$(HOST_DEFAULT_COMPILER)_CC := $(CCACHE) $($(HOST_DEFAULT_COMPILER)_TOOLS_PREFIX)gcc
$(HOST_DEFAULT_COMPILER)_CXX := $(CCACHE) $($(HOST_DEFAULT_COMPILER)_TOOLS_PREFIX)g++
$(HOST_DEFAULT_COMPILER)_AR := $(CCACHE) $($(HOST_DEFAULT_COMPILER)_TOOLS_PREFIX)ar

ifeq ($(HOST_OS), CentOS)
host_os := centos
endif

ifneq ($(ARCH),arm)
$(HOST_DEFAULT_COMPILER)_GLOBAL_CFLAGS := -Wall
$(HOST_DEFAULT_COMPILER)_GLOBAL_CPPFLAGS := -std=c++11
endif

ifeq ($(debug),true)
$(HOST_DEFAULT_COMPILER)_GLOBAL_CFLAGS += -g
$(HOST_DEFAULT_COMPILER)_GLOBAL_CPPFLAGS += -g
endif

$(HOST_DEFAULT_COMPILER)_GLOBAL_LDFLAGS := -lpthread

$(HOST_DEFAULT_COMPILER)_GLOBAL_ARFLAGS := crs

ifeq ($(build_device),true)

DEVICE_DEFAULT_COMPILER := DEVICE_ARM64

ifneq ($(CROSS_COMPILE),)
DEVICE_KERNEL_COMPILER_PREFIX := $(CROSS_COMPILE)
$(DEVICE_DEFAULT_COMPILER)_TOOLS_PREFIX := $(CROSS_COMPILE)

$(DEVICE_DEFAULT_COMPILER)_CC := $(CCACHE) $($(DEVICE_DEFAULT_COMPILER)_TOOLS_PREFIX)gcc
$(DEVICE_DEFAULT_COMPILER)_CXX := $(CCACHE) $($(DEVICE_DEFAULT_COMPILER)_TOOLS_PREFIX)g++
$(DEVICE_DEFAULT_COMPILER)_AR := $(CCACHE) $($(DEVICE_DEFAULT_COMPILER)_TOOLS_PREFIX)ar

$(DEVICE_DEFAULT_COMPILER)_GLOBAL_CFLAGS := -Wall -fstack-protector-strong
$(DEVICE_DEFAULT_COMPILER)_GLOBAL_LDFLAGS := -lpthread  -Wl,-z,relro,-z,now,-z,noexecstack
$(DEVICE_DEFAULT_COMPILER)_GLOBAL_ARFLAGS := crsD

ifneq ($(KERNEL_DEFCONFIG),)
DEVICE_KERNEL_DEFCONFIG := $(KERNEL_DEFCONFIG)
endif

else
$(error you must specfic CROSS_COMPILE when build device module.)
endif

ifneq ($(KERNEL_DIR),)
DEVICE_KERNEL_PATH := $(KERNEL_DIR)
endif

ifneq ($(KERNEL_DEFCONFIG),)
DEVICE_KERNEL_DEFCONFIG := $(KERNEL_DEFCONFIG)
endif

endif
