	log_product_inc += -I$(DRIVER_INC)/tsdrv/ts_drv_common -I$(DRIVER_INC)/tsdrv/ts_drv_common/tsdrv_dev
	log_product_inc += -I$(DRIVER_INC)/include/soc/cloud_v2
	ifeq ($(PRODUCT),ascend910B)
		ccflags-y += -DCFG_TRS_REFACTOR_FEATURE
		drv_log-objs += log_drv_conn/log_drv_chan.o
	endif
else ifneq ($(filter $(PRODUCT), ascend310 ascend310rc),)
	ccflags-y += -DCFG_SOC_PLATFORM_MINI
	log_product_inc += -I$(src)/log_drv_res/ascd310
	log_product_inc += -I$(DRIVER_INC)/ts_platform/ascend310
	log_product_inc += -I$(DRIVER_INC)/dms/drv_devmng/drv_devmng_device/ascend310
	log_product_inc += -I$(DRIVER_INC)/tsdrv/ascend310
	log_product_inc += -I$(DRIVER_INC)/tsdrv/ts_drv_common -I$(DRIVER_INC)/tsdrv/ts_drv_common/tsdrv_dev
	log_product_inc += -I$(DRIVER_INC)/include/soc/mini_v1
else ifneq ($(filter $(PRODUCT), ascend310p helper310p),)
	ccflags-y += -DCFG_SOC_PLATFORM_MINIV2
	log_product_inc += -I$(src)/log_drv_res/ascd310p
	log_product_inc += -I$(DRIVER_INC)/ts_platform/ascend610
	log_product_inc += -I$(DRIVER_INC)/dms/drv_devmng/drv_devmng_device/ascend910
	log_product_inc += -I$(DRIVER_INC)/tsdrv/ts_drv_common -I$(DRIVER_INC)/tsdrv/ts_drv_common/tsdrv_dev
	log_product_inc += -I$(DRIVER_INC)/include/soc/cloud_v1
else ifneq ($(filter $(PRODUCT), ascend310B ascend310Besl ascend310Bemu ascend310Brc ascend310Brcesl ascend310Brcemu),)
	ccflags-y += -DCFG_SOC_PLATFORM_MINIV3 -DCFG_TRS_REFACTOR_FEATURE
