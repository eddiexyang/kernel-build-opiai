	log_product_inc += -I$(DRIVER_INC)/ts_platform/ascend610
	log_product_inc += -I$(DRIVER_INC)/dms/drv_devmng/drv_devmng_device/ascend910
	log_product_inc += -I$(DRIVER_INC)/tsdrv/ts_drv_common -I$(DRIVER_INC)/tsdrv/ts_drv_common/tsdrv_dev
