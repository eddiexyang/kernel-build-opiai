	log_product_inc += -I$(DRIVER_INC)/tsdrv/ts_drv_common -I$(DRIVER_INC)/tsdrv/ts_drv_common/tsdrv_dev
	log_product_inc += -I$(DRIVER_INC)/include/soc/cloud_v1
else ifneq ($(filter $(PRODUCT), ascend910B ascend920esl ascend920emu),)
	ccflags-y += -DCFG_SOC_PLATFORM_CLOUD_V2
	log_product_inc += -I$(src)/log_drv_res/ascd910b
	log_product_inc += -I$(DRIVER_INC)/ts_platform/ascend910
