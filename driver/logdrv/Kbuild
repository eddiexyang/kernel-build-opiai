ccflags-y += -I$(DRIVER_INC)/ts_platform -I$(DRIVER_INC)/ipcdrv -I$(DRIVER_INC)/hdcdrv/hdcdrv
ccflags-y += $(log_local_inc)

ifneq ($(filter $(PRODUCT), ascend910),)
	ccflags-y += -DCFG_SOC_PLATFORM_CLOUD
	log_product_inc += -I$(src)/log_drv_res/ascd910
	log_product_inc += -I$(DRIVER_INC)/ts_platform/ascend910
